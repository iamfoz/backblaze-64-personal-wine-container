# WINE_FLAVOUR picks the Wine. "winehq" (the default, published as :latest)
# installs winehq-stable from WineHQ's repository, unchanged. "patched"
# (published as :latest-patched) builds the fork's Wine from source with
# patches/build-wine.sh, the same recipe the beta uses. Every fork patch has a
# runtime switch; this flavour turns the fixes on and leaves the performance
# and experimental ones off. Only the stages the chosen flavour needs are built
# (BuildKit), so the default build never compiles Wine.
#
# WINE_REF has no default here on purpose. The Wine and the patch set for
# :latest-patched are pinned in patches/promoted and move only when the beta is
# promoted at a stable release; CI reads that file and passes WINE_REF. A local
# patched build passes it too:
#   --build-arg WINE_FLAVOUR=patched \
#   --build-arg WINE_REF="$(sed -n 's/^WINE_REF=//p' patches/promoted)"
ARG WINE_FLAVOUR=winehq
ARG WINE_REF

FROM ubuntu:24.04 AS wine-builder
ARG WINE_REF
ARG MAKE_JOBS
ENV DEBIAN_FRONTEND=noninteractive
COPY patches/build-wine.sh /wine/patches/build-wine.sh
RUN sh /wine/patches/build-wine.sh deps
COPY patches/ /wine/patches/
RUN sh /wine/patches/build-wine.sh build

FROM jlesage/baseimage-gui:ubuntu-24.04-v4.14.0@sha256:e7c54da3446b4c65b6755bf00a874463c640a1f579f25bed99532051e81649ef AS base

ENV WINEPREFIX=/config/wine/
# Backblaze 10.x is a native 64-bit app, so the prefix must be win64.
ENV WINEARCH=win64
ENV LANG=en_US.UTF-8
ENV APP_NAME="Backblaze Personal Backup"
ENV FORCE_LATEST_UPDATE="true"
ENV DISABLE_AUTOUPDATE="false"
# The client is pinned. Backblaze 10.0.3.1075 completes no backup pass under
# Wine: its service supervises the pass with OpenProcess(), which Wine denies
# because services do not run as LocalSystem here, so the service deletes the
# pass's lock and starts another. The pin wins over FORCE_LATEST_UPDATE and is
# installed over a newer or older client in place. Set it empty to let the
# updater decide once a client that works has shipped.
ENV BACKBLAZE_VERSION="10.0.1.1069"
ENV DISABLE_VIRTUAL_DESKTOP="false"
ENV DISPLAY_WIDTH="900"
ENV DISPLAY_HEIGHT="700"
# Disable Wine debug noise
ENV WINEDEBUG=-all
# Set DISPLAY so GUI programs can find the X server
ENV DISPLAY=:0

# Unraid reads these labels to show a WebUI button and the app icon on the
# Docker page, including for containers started with `docker run`.
LABEL net.unraid.docker.webui="http://[IP]:[PORT:5800]/" \
      net.unraid.docker.icon="https://cdn.jsdelivr.net/gh/selfhst/icons/png/backblaze.png"

FROM base AS wine-winehq
# Install 64-bit Wine from WineHQ using the modern deb822 "sources" method.
# Lessons baked in here:
#   * The WineHQ apt repo only keeps the LATEST build of each branch, so
#     pinning an exact version (e.g. winehq-stable=10.0*) breaks the moment a
#     newer release ships. We track winehq-stable (currently Wine 11.x).
#   * deb822 + a keyring file is reliable. When the old apt-key /
#     add-apt-repository approach broke, it fell back to Ubuntu's ancient
#     Wine 6.x without warning.
#   * Save the key with a .asc (armored) extension and write a deb822
#     stanza pointing Signed-By at it. Newer apt (26.04+) ignores keyrings with
#     an unrecognised ".key" extension, which leaves the repo unsigned. An inline
#     stanza also avoids depending on the exact name of WineHQ's .sources file.
#   * Backblaze 10.x is 64-bit only, but winehq-stable still pulls its i386
#     WoW64 libraries via recommends. That is harmless and kept for safety.
# Installing Wine on the jlesage 24.04 base needs three adjustments:
#
# 1. Its build-time environment is minimal - /run and the user/group database
#    do not exist yet - so postinst scripts that take locks or create users
#    (dbus, fontconfig, udev, ...) abort. Recreate what the base's add-pkg
#    helper sets up (init_env) first, then strip the scaffolding back out.
#
# 2. Wine hard-depends (via libsane/libgphoto2 -> udev) on systemd, whose
#    postinst cannot configure on this base (it wants a real /var/log and trips
#    over the base's /etc/gshadow). Pin full systemd out so the udev dependency
#    is satisfied by the lightweight systemd-standalone-sysusers instead.
#
# 3. Install with --no-install-recommends to avoid avahi/cups/etc. that a backup
#    container has no use for, adding back only the Wine runtime libs Backblaze
#    needs (TLS, fonts, X render/extension libs). winbind is omitted too (its
#    only use here is Wine's unused NTLM auth).
RUN mkdir -p /config/log /tmp/run && \
    /etc/cont-init.d/10-init-users.sh && \
    printf 'Package: systemd systemd:i386 systemd-sysv systemd-sysv:i386\nPin: release *\nPin-Priority: -1\n' \
        > /etc/apt/preferences.d/no-systemd && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl xvfb cabextract p7zip-full python3 && \
    dpkg --add-architecture i386 && \
    mkdir -pm755 /etc/apt/keyrings && \
    curl -fsSL https://dl.winehq.org/wine-builds/winehq.key \
        -o /etc/apt/keyrings/winehq-archive.asc && \
    printf 'Types: deb\nURIs: https://dl.winehq.org/wine-builds/ubuntu\nSuites: noble\nComponents: main\nSigned-By: /etc/apt/keyrings/winehq-archive.asc\n' \
        > /etc/apt/sources.list.d/winehq.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends winehq-stable \
        libgnutls30t64 libfreetype6 libfontconfig1 libpng16-16t64 \
        libxcomposite1 libxcursor1 libxfixes3 libxi6 libxinerama1 \
        libxrandr2 libxrender1 libxxf86vm1 && \
    apt-get install -y --no-install-recommends winetricks && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends locales && \
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* \
        /tmp/.passwd /tmp/.group /tmp/.shadow /tmp/.gshadow /tmp/run /config/log

FROM base AS wine-patched
# The fork's Wine, built above, in /opt/wine. The jlesage base starts the app
# service with its own PATH, which does not pick up ENV PATH, so the binaries
# startapp.sh calls by name are linked into /usr/bin as well.
COPY --from=wine-builder /opt/wine /opt/wine
ENV PATH="/opt/wine/bin:${PATH}"
RUN set -eu; for b in wine wine64 wineserver wineboot winepath winecfg wineconsole; do \
        if [ -e "/opt/wine/bin/$b" ]; then ln -sf "/opt/wine/bin/$b" "/usr/bin/$b"; fi; \
    done
# Only the tools startapp.sh uses and the libraries this Wine links against:
# no WineHQ repository, no i386 libraries, no systemd pinning. The init_env
# scaffolding mirrors the base image's add-pkg helper, as in the stage above.
RUN mkdir -p /config/log /tmp/run && \
    /etc/cont-init.d/10-init-users.sh && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl xvfb cabextract p7zip-full python3 \
        libfreetype6 libfontconfig1 libgnutls30t64 libpng16-16t64 \
        libx11-6 libxext6 libxrender1 libxrandr2 libxi6 libxfixes3 \
        libxcursor1 libxinerama1 libxcomposite1 libxxf86vm1 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends locales && \
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* \
        /tmp/.passwd /tmp/.group /tmp/.shadow /tmp/.gshadow /tmp/run /config/log
# The switches (rootfs/usr/local/share/bb64/wine-switches.tsv): the fixes on,
# the performance and experimental patches off until the user turns them on.
# With the service token on, 10.0.3.1075 and later complete their passes, so
# the client follows Backblaze's newest as the beta does. Turning the token
# off pins 10.0.1.1069 again (startapp.sh).
ENV WINE_SOCK_SEND_READY="1" \
    WINE_SOCK_FDWRITE_REARM="0" \
    WINE_SERVICE_TOKEN="1" \
    WINE_OFD_LOCKS="1" \
    WINE_CASE_CACHE="0" \
    BACKBLAZE_VERSION=""

FROM wine-${WINE_FLAVOUR}
ARG WINE_FLAVOUR

# Image/release version, shown by bb-version and baked into the build stamp below.
# CI passes the release tag via --build-arg. Local builds default to "dev".
# Declared HERE, after the heavy apt layer, so a version change does not bust its
# build cache. Without this ARG, Docker ignores the build-arg CI passes
# and every published image would stamp itself "dev".
ARG DOCKER_IMAGE_VERSION=dev
ENV DOCKER_IMAGE_VERSION=${DOCKER_IMAGE_VERSION}

# Stamp the build so every bb-* tool can report which image it came from.
# Sourced from the build rather than versioned per tool: the tools always ship
# together inside an image, so "which build is this" is the question a bug report
# needs answered, and a single source cannot drift out of step.
ARG BUILD_REV=unknown
# BUILD_NUMBER is the CI run number. The :beta tag is mutable, so without it a
# published beta cannot be told apart from the one before it in a bug report.
ARG BUILD_NUMBER=0
RUN printf 'version=%s\nrevision=%s\nbuild=%s\nvariant=%s\nbuilt=%s\n' \
        "${DOCKER_IMAGE_VERSION:-dev}" "${BUILD_REV}" "${BUILD_NUMBER}" \
        "$([ "$WINE_FLAVOUR" = patched ] && echo ubuntu24-patched || echo ubuntu24)" \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /etc/bb-build

EXPOSE 5900

COPY rootfs/ /

# The tools, the web interface (Monitor, Status, Tools, API and Settings tabs)
# and its nginx wiring, and the checks that what ships parses: the same step
# for every image (build/finish-image.sh).
RUN --mount=type=bind,source=build,target=/build sh /build/finish-image.sh

# Report the backup itself as the container's health, rather than just whether a
# process is alive. bb-health only reports unhealthy on a corroborated stall (see
# the script), so an idle or still-being-set-up container stays healthy. The long
# start period covers the first run, which downloads and installs Backblaze.
HEALTHCHECK --interval=5m --timeout=30s --start-period=15m --retries=2 \
    CMD /usr/local/bin/bb-health || exit 1
