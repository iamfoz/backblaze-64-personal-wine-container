function pctClass(pct, invert){
  // invert=true: higher is worse (mem/swap gauges). invert=false: higher is better (rate).
  if(invert) return pct>=90?'bad':(pct>=70?'warn':'');
  return '';
}
var rateHistory = [];
function sparklineSvg(values, w, h){
  if(values.length < 2) return '';
  var max = Math.max(0.05, Math.max.apply(null, values));
  var stepX = w / (values.length - 1);
  var pts = values.map(function(v, i){
    var x = i * stepX;
    var y = h - (Math.min(v, max) / max) * (h - 1) - 0.5;
    return x.toFixed(1) + ',' + y.toFixed(1);
  }).join(' ');
  return '<svg class="spark" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none">' +
         '<polyline points="'+pts+'" /></svg>';
}
function pingHtml(d){
  // TCP handshake time, not ICMP. The tooltip names the host actually measured:
  // with no upload running this falls back to the public site, which can be a
  // CDN edge and read far lower than the real storage pod.
  if(d.latency_ms == null){
    return '<span class="stat dim" title="Measured only while an upload is ' +
           'running, against the pod that upload is using">RTT: n/a</span>';
  }
  var tip = ' title="TCP handshake to ' + esc(d.latency_host) +
            ', the pod your uploads are using (not ICMP)"';
  var cls = d.latency_ms < 80 ? 'good' : (d.latency_ms < 200 ? 'warn' : 'bad');
  return '<span class="stat"'+tip+'>RTT: <span class="'+cls+'">' +
         Math.round(d.latency_ms) + 'ms</span></span>';
}
function gaugeHtml(label, g, highIsGood, extra, suffix){
  if(!g) return '<span class="stat">'+label+': n/a</span>';
  var cls = highIsGood
    ? (g.pct>=67 ? '' : (g.pct>=34 ? 'warn' : 'bad'))
    : (g.pct>=90 ? 'bad' : (g.pct>=70 ? 'warn' : ''));
  var tip = extra ? ' title="'+extra+'"' : '';
  var suf = suffix ? ' <span class="dim">'+suffix+'</span>' : '';
  return '<span class="stat gauge '+cls+'"'+tip+'>'+label+': '+esc(g.used_str)+'/'+esc(g.total_str)+
         ' <span class="track"><span class="fill" style="width:'+Math.min(100,g.pct)+'%"></span></span> '+g.pct+'%'+suf+'</span>';
}
var lastState = null;
function updateFavicon(state){
  var cs = getComputedStyle(document.documentElement);
  var color = '#888888';
  if(state === 'Transmitting') color = cs.getPropertyValue('--good').trim() || '#3ddc6b';
  else if(state === 'Scanning' || state === 'Preparing') color = cs.getPropertyValue('--warn').trim() || '#ffd23d';
  var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
            '<circle cx="16" cy="16" r="13" fill="'+color+'" stroke="rgba(0,0,0,0.4)" stroke-width="2"/></svg>';
  var link = document.getElementById('favicon');
  if(link) link.href = 'data:image/svg+xml,' + encodeURIComponent(svg);
}
// Defined before first use by hoisting; called from every path that puts
// Backblaze-derived text into innerHTML. Filenames come off a Linux array
// mapped into Wine's drive-letter view, so they carry no guarantee of avoiding
// HTML-special characters the way native Windows names would.
function esc(s){
  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}
var aboutDone = false;
function renderAbout(a){
  if(aboutDone) return;          // build metadata never changes while we run
  aboutDone = true;
  var b = a.build || {}, rows = '';
  function row(k, v){ if(v) rows += '<dt>'+esc(k)+'</dt><dd>'+esc(v)+'</dd>'; }
  row('Version', b.version); row('Build', b.build);
  row('Revision', b.revision); row('Variant', b.variant); row('Built', b.built);
  var html =
    '<div class="asec" style="border-top:0;padding-top:0;margin-top:0">' +
      '<h3>'+esc(a.name)+' \u2022 '+esc(a.component)+'</h3>' +
      (rows ? '<dl class="adl">'+rows+'</dl>'
            : '<p class="fhint">No build stamp found (running outside a built image).</p>') +
    '</div>' +
    '<div class="asec"><h3>Licence</h3>' +
      '<div class="credit">'+esc(a.copyright)+'</div>' +
      '<div class="credit"><span class="what">'+esc(a.license)+'</span></div>' +
      '<div class="credit"><a href="'+esc(a.url)+'" target="_blank" rel="noopener noreferrer">'+esc(a.url)+'</a></div>' +
    '</div>';
  if(a.credits && a.credits.length){
    html += '<div class="asec"><h3>With thanks to</h3>' +
      a.credits.map(function(c){
        return '<div class="credit"><span class="who">'+esc(c.who)+'</span> \u2014 ' +
               '<span class="what">'+esc(c.what)+'</span></div>';
      }).join('') + '</div>';
  }
  document.getElementById('pane-about').innerHTML = html;
}
async function tick(){
  try{
    // Relative, so it resolves under /monitor/ when proxied and at / when standalone.
    const res = await fetch('api/status', {cache:'no-store'});
    const d = await res.json();
    if(d.about) renderAbout(d.about);   // before the ok check: About must work when collection is broken
    if(!d.ok){
      document.getElementById('err').style.display='block';
      document.getElementById('err').textContent = 'Waiting for data: ' + (d.error||'unknown');
      document.title = 'Backblaze 64 \u2022 Upload Monitor';
      return;
    }
    document.getElementById('err').style.display='none';
    document.getElementById('clock').textContent = d.clock;
    document.getElementById('build').textContent = d.build_label || '';
    document.getElementById('footer-server').textContent =
      d.upload_pod ? ('Upload server: ' + d.upload_pod) : '';
    document.getElementById('topbar-title').textContent =
      'Backblaze 64 \u2022 Upload Monitor' + (d.uptime ? ' \u2022 ' + d.uptime : '');

    rateHistory.push(d.rate_mb);
    if(rateHistory.length > 40) rateHistory.shift();

    document.title = 'BB64 \u2022 ' + d.rate_str + ' \u2022 ' + (d.backup ? d.backup.pct+'%' : d.state);
    lastState = d.state;
    updateFavicon(d.state);

    var rateCls = d.rate_mb>=1 ? 'good' : (d.rate_mb>0.05 ? 'warn' : 'bad');
    var stateCls = d.state==='Transmitting' ? 'good' : (['Scanning','Preparing'].includes(d.state) ? 'warn' : '');
    var grid = document.getElementById('status-grid');
    grid.innerHTML =
      '<span class="stat">Threads: '+d.threads+'</span>' +
      '<span class="stat">Up: <span class="'+rateCls+'">'+d.rate_str+'</span> ('+d.rate_mbit_str+')'+sparklineSvg(rateHistory,70,16)+'</span>' +
      '<span class="stat">Chunks/60s: '+d.chunks+'</span>' +
      '<span class="stat">Session: '+d.session_str+'</span>' +
      '<span class="stat">State: <span class="'+stateCls+'">'+d.state+'</span></span>' +
      pingHtml(d) +
      gaugeHtml('Mem', d.mem, false) +
      gaugeHtml('Swap', d.swap, false) +
      '<span class="stat">Files Remaining: '+(d.backup && d.backup.remaining_files!=null ? d.backup.remaining_files.toLocaleString() : 'n/a')+'</span>' +
      gaugeHtml('Backup', d.backup, true,
                d.backup ? (d.backup.files + ' \u2022 ETA based on last ' + d.backup.eta_samples + ' completed transfer' + (d.backup.eta_samples===1?'':'s')) : '',
                d.backup ? ('ETA '+d.backup.eta) : '');

    var up = document.getElementById('uploading');
    document.getElementById('uploading-title').textContent = d.files.length
      ? 'Uploading Now \u2022 ' + d.files.length + (d.files.length===1?' file':' files')
      : 'Uploading Now';
    if(!d.files.length){
      up.innerHTML = '<div id="empty">(nothing in flight)</div>';
    } else {
      up.innerHTML = d.files.map(f=>{
        var cls = f.pct>=67?'good':(f.pct>=34?'warn':'bad');
        return '<div class="file-row"><div class="track"><span class="fill '+cls+'" style="width:'+f.pct+'%"></span></div>' +
               '<div class="meta"><span>'+f.pct.toFixed(0)+'%</span><span>'+esc(f.size_str)+'</span><span>'+esc(f.name)+'</span></div></div>';
      }).join('');
    }

    var tb = document.getElementById('recent-body');
    if(!d.recent.length){
      tb.innerHTML = '<tr><td colspan="5" id="empty">(watching for completions&hellip;)</td></tr>';
    } else {
      tb.innerHTML = d.recent.slice().reverse().map(r=>
        '<tr><td class="col-time">'+esc(r.time)+'</td><td class="col-thread">'+esc(r.thread)+'</td>'+
        '<td class="col-size">'+esc(r.size)+'</td><td class="col-rate">'+esc(r.rate)+'</td>'+
        '<td class="col-file">'+esc(r.name)+'</td></tr>'
      ).join('');
    }
  }catch(e){
    document.getElementById('err').style.display='block';
    document.getElementById('err').textContent = 'Fetch failed: ' + e;
  }
}
(function(){
  var params = new URLSearchParams(location.search);
  if(params.get('compact') === '1' || params.get('compact') === 'true'){
    document.body.classList.add('compact');
  }
  var sel = document.getElementById('theme-select');
  var themeParam = params.get('theme');
  var saved = themeParam || (function(){
    try { return localStorage.getItem('bbMonitorTheme'); } catch(e){ return null; }
  })() || 'blue';
  document.documentElement.setAttribute('data-theme', saved);
  sel.value = saved;
  updateFavicon(lastState);
  sel.addEventListener('change', function(){
    document.documentElement.setAttribute('data-theme', sel.value);
    try { localStorage.setItem('bbMonitorTheme', sel.value); } catch(e){}
    updateFavicon(lastState);
  });

  var backdrop = document.getElementById('backdrop');
  var openBtn  = document.getElementById('settings-btn');
  var tabs     = Array.prototype.slice.call(document.querySelectorAll('.mtab'));
  function setTab(name){
    tabs.forEach(function(t){
      t.setAttribute('aria-selected', t.getAttribute('data-tab') === name ? 'true' : 'false');
    });
    document.getElementById('pane-prefs').hidden = (name !== 'prefs');
    document.getElementById('pane-about').hidden = (name !== 'about');
  }
  function openModal(){
    backdrop.hidden = false;
    setTab('prefs');
    document.getElementById('modal-close').focus();
  }
  function closeModal(){
    backdrop.hidden = true;
    openBtn.focus();
  }
  openBtn.addEventListener('click', openModal);
  document.getElementById('modal-close').addEventListener('click', closeModal);
  backdrop.addEventListener('click', function(e){ if(e.target === backdrop) closeModal(); });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && !backdrop.hidden) closeModal();
  });
  tabs.forEach(function(t){
    t.addEventListener('click', function(){ setTab(t.getAttribute('data-tab')); });
  });
})();
tick();
setInterval(tick, 2000);
</script>
</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass  # keep the container log quiet

    def do_GET(self):
        path = urlsplit(self.path).path   # strip any ?query string before routing
        if path == "/api/status":
            with _lock:
                payload = json.dumps(_latest).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
        elif path in ("/", "/index.html"):
            payload = INDEX_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        else:
            self.send_response(404)
            self.end_headers()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dump-rtt", action="store_true",
                     help="Print what the kernel reports for the live upload "
                          "connections, then exit. For checking the netlink read "
                          "inside the container without going through the UI.")
    ap.add_argument("--port", type=int, default=8099)
    # Loopback by default: nginx fronts this, and binding 0.0.0.0 would put
    # the names of every backed-up file on the LAN with no authentication.
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    if args.dump_rtt:
        uid = _threadpush_uid()
        print("threadpush uid:  %s" % (uid if uid else "none (nothing uploading)"))
        if hasattr(socket, "AF_NETLINK"):
            rows = []
            for fam in (socket.AF_INET, socket.AF_INET6):
                try:
                    rows += [(p, u, d, r) for p, u, d, r in _diag_dump(fam)]
                except OSError as e:
                    print("netlink dump failed for family %s: %s" % (fam, e))
            print("established TCP sockets reporting tcp_info: %d" % len(rows))
            for peer, u, dport, rtt in rows:
                mark = " <- upload" if (dport == 443 and str(u) == str(uid)) else ""
                print("  %-40s uid=%-6s dport=%-5d rtt=%.1f ms%s"
                      % (peer, u, dport, rtt / 1000.0, mark))
        else:
            print("no AF_NETLINK on this platform")
        ms, peer = _upload_rtt()
        print("reported: %s" % ("n/a" if ms is None else "%.1f ms via %s" % (ms, peer)))
        return

    threading.Thread(target=_loop, daemon=True).start()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    print("bb-monitor-web listening on http://%s:%d/" % (args.host, args.port))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
