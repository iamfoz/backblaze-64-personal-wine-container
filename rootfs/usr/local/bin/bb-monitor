#!/usr/bin/env python3
"""Live Backblaze upload monitor — curses dashboard (runs inside the container).
Usage:  open the container console (Unraid: container icon -> >_ Console) and
run  bb-monitor          (q quit, arrows/PgUp/PgDn scroll)"""
import locale; locale.setlocale(locale.LC_ALL, "")
import curses, os, time, re, calendar, unicodedata

# ---- config -------------------------------------------------------------------
BZ="/config/wine/dosdevices/c:/ProgramData/Backblaze/bzdata"
LOGDIR=BZ+"/bzlogs/bztransmit"; TDIR=BZ+"/bzthread"
PROC="/proc"; NETDEV="/proc/net/dev"; MEMINFO="/proc/meminfo"
CG2="/sys/fs/cgroup"; CG1="/sys/fs/cgroup/memory"
INT=2.0            # refresh interval (s)
MPLOG="/tmp/bb_multipart_bzdone.log"   # first multi-part bz_done line gets dumped here

_logged=set(); _inflight={}; _recent=[]; _sess=0

# ---- helpers ------------------------------------------------------------------
def read(path):
    try:
        with open(path,encoding="utf-8",errors="replace") as fh: return fh.read()
    except OSError: return ""

def human(n):
    if n>=1073741824: return "%.1f GB"%(n/1073741824)
    if n>=1048576:    return "%.0f MB"%(n/1048576)
    return "%d KB"%(n/1024)

def _secs(t):
    hh,mm,ss=t.split(":"); return int(hh)*3600+int(mm)*60+int(ss)

def wclip(s,width):
    """Clip to terminal cells, not codepoints (CJK/emoji are 2 cells wide)."""
    out=[]; cw=0
    for ch in s:
        w=2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if cw+w>width: break
        out.append(ch); cw+=w
    return "".join(out)

# ---- data sources (all direct file reads; no subprocesses) ----------------------
def scan_procs():
    """threadpush count, in-flight XML names, and process presence from /proc."""
    thr=0; xmls=set(); has_fl=False; has_bt=False
    try: pids=[p for p in os.listdir(PROC) if p.isdigit()]
    except OSError: return 0,[],False,False
    for p in pids:
        try:
            with open(os.path.join(PROC,p,"cmdline"),"rb") as fh:
                cmd=fh.read().decode("utf-8","replace").replace("\0"," ")
        except OSError: continue
        if "bztransmit" in cmd: has_bt=True
        if "bzfilelist" in cmd: has_fl=True
        if "-threadpush" in cmd:
            thr+=1; xmls.update(re.findall(r'bzt_\w+_bzt\.xml',cmd))
    return thr,sorted(xmls),has_fl,has_bt

def tail_log(n=800):
    """Last n lines of the newest bztransmit log."""
    try:
        fs=[os.path.join(LOGDIR,f) for f in os.listdir(LOGDIR) if f.endswith(".log")]
        if not fs: return ""
        p=max(fs,key=os.path.getmtime)
        with open(p,"rb") as fh:
            fh.seek(0,2); sz=fh.tell(); fh.seek(max(0,sz-262144))
            return "\n".join(fh.read().decode("utf-8","replace").splitlines()[-n:])
    except OSError: return ""

def _tx():
    t=0
    for ln in read(NETDEV).splitlines():
        f=ln.replace(":"," ").split()
        if len(f)>=10 and f[0]!="lo" and f[1].isdigit():
            try: t+=int(f[9])
            except ValueError: pass
    return t

def mem_info(host_total):
    """Container memory from the cgroup (v2 then v1), docker-stats style."""
    for cur,mx,stat,key in ((CG2+"/memory.current",CG2+"/memory.max",CG2+"/memory.stat","inactive_file"),
                            (CG1+"/memory.usage_in_bytes",CG1+"/memory.limit_in_bytes",CG1+"/memory.stat","total_inactive_file")):
        u=read(cur).strip()
        if not u.isdigit(): continue
        m=re.search(r'^%s (\d+)'%key,read(stat),re.M)
        used=max(0,int(u)-(int(m.group(1)) if m else 0))   # minus page cache
        l=read(mx).strip()
        lim=int(l) if l.isdigit() else 0
        if not 0<lim<(1<<60): lim=host_total               # "max"/unlimited -> host total
        if lim>0: return (used,lim,used*100.0/lim)
    return None

# ---- data collection ------------------------------------------------------------
def gather(prev):
    global _inflight,_recent,_sess
    o={}; ts=time.time()

    mi=read(MEMINFO)   # /proc/meminfo is not namespaced: host values
    m=re.search(r'MemTotal:\s+(\d+)',mi); host_total=int(m.group(1))*1024 if m else 0
    mt=re.search(r'SwapTotal:\s+(\d+)',mi); mf=re.search(r'SwapFree:\s+(\d+)',mi)
    o["swap"]=None
    if mt and mf and int(mt.group(1))>0:
        tot=int(mt.group(1))*1024; used=tot-int(mf.group(1))*1024
        o["swap"]=(used,tot,used*100.0/tot)
    o["mem"]=mem_info(host_total)

    threads,xmls,has_fl,has_bt=scan_procs()
    o["threads"]=threads
    o["state"]=("Transmitting" if threads else
                "Scanning" if has_fl else
                "Preparing" if has_bt else "Idle")

    now=_tx()
    if prev and now>0 and now>=prev[0] and ts>prev[1]:
        o["rate"]=(now-prev[0])/(ts-prev[1])/1048576; _sess+=now-prev[0]
    else:
        o["rate"]=0.0
    o["_tx"]=(now,ts) if now>0 else prev
    o["sess"]=_sess

    blob=tail_log()
    comps=[l for l in blob.splitlines() if "Leaving bztrans_thread_push" in l]
    times=[_secs(m.group(1)) for l in comps for m in [re.search(r'(\d\d:\d\d:\d\d)',l)] if m]
    o["chunks"]=sum(1 for t in times if (times[-1]-t)%86400<=60) if times else 0
    sb=ss=0
    for l in comps[-20:]:
        m=re.search(r'elapsedSec=(\d+).*?numBytes=(\d+) bytes',l)
        if m: ss+=int(m.group(1)); sb+=int(m.group(2))
    ptbps=int(sb/ss) if ss>0 else 175000

    # newest completion line for a thread slot (used for corroboration below)
    def newest_line(thr):
        return next((l for l in reversed(comps)
                     if thr>=0 and re.search(r'which_threadStr=0*%d(?!\d)'%thr,l)),None)

    # in-flight uploads from the thread XMLs
    files=[]; cur={}
    for x in xmls:
        xml=read(os.path.join(TDIR,x))
        mp=re.search(r'numBytes_to_send_in_shm="(\d+)"',xml)
        mg=re.search(r'gmt_started="(\d{14})"',xml)
        mh=re.search(r'hex_encoded_bz_done_line="([0-9a-f]*)"',xml)
        mw=re.search(r'which_thread="(\d+)"',xml)
        if not (mp and mg and mh): continue
        try: fields=bytes.fromhex(mh.group(1)).decode('utf-8','replace').rstrip("\n").split("\t")
        except ValueError: continue
        win=fields[-1]; name=win.split("\\")[-1]
        part=int(mp.group(1)); thr=int(mw.group(1)) if mw else -1
        fsize=0
        if len(win)>2 and win[1]==":":
            try: fsize=os.path.getsize("/config/wine/dosdevices/%s:%s"%(win[0].lower(),win[2:].replace("\\","/")))
            except OSError: pass
        if fsize>part*1.5 and name not in _logged:     # capture 1st multi-part file seen
            _logged.add(name)
            try:
                with open(MPLOG,"a") as fh:
                    fh.write("%s  file=%d part=%d ~parts=%d\n"%(time.strftime("%F %T"),fsize,part,-(-fsize//part)))
                    for i,fl in enumerate(fields): fh.write("   [%02d] %r\n"%(i,fl))
                    fh.write("\n")
            except OSError: pass
        try: el=ts-calendar.timegm(time.strptime(mg.group(1),"%Y%m%d%H%M%S"))
        except ValueError: el=0
        pct=min(99.0,max(0.0,el*ptbps/part*100)) if part>0 else 0
        # remember the newest completion line for this slot NOW, while the push is
        # in flight — a completion later is corroborated by a NEWER line appearing
        # (clock-free: immune to log-vs-XML timezone/clock skew).
        files.append((name,part,fsize,pct)); cur[x]=(name,fsize,thr,newest_line(thr))
    o["files"]=files

    # completion = a push tracked last cycle whose XML is gone (or now holds a new
    # file), CORROBORATED by a fresh log line for that thread — so a killed push
    # or a stale slot never fabricates a "Recently Completed" row.
    for xb,(nm,fs,thr,seen) in _inflight.items():
        if xb in cur and cur[xb][0]==nm: continue
        line=newest_line(thr)
        if line is None or line==seen: continue   # no NEW completion line: skip
        m=re.search(r'(\d\d:\d\d:\d\d)',line)
        tstr=m.group(1) if m else time.strftime("%H:%M:%S")
        size=human(fs) if fs else ""
        if not size:
            m=re.search(r'\((\d+) MBytes\)',line)
            if m: size="%s MB"%m.group(1)
        rate=""
        m=re.search(r'kBitsPerSec=(\d+)',line)
        if m:
            kb=int(m.group(1))
            mn=re.search(r'elapsedSec=(\d+).*?numBytes=(\d+) bytes',line)
            rate=("%.2f MB/s"%(int(mn.group(2))/int(mn.group(1))/1048576
                  if mn and int(mn.group(1))>0 else kb/8192.0)) if kb>1024 else "%d kbit/s"%kb
        _recent.append((tstr,thr,size or "?",rate,nm))
    del _recent[:-8]
    _inflight=cur
    o["recent"]=list(_recent)
    return o

# ---- dashboard ------------------------------------------------------------------
def aw(scr,y,x,s,attr=0):
    h,w=scr.getmaxyx()
    if not(0<=y<h) or x>=w: return
    if x<0: s=s[-x:]; x=0
    s=s[:w-x]
    if y==h-1 and x+len(s)>=w: s=s[:w-x-1]
    try: scr.addstr(y,x,s,attr)
    except (curses.error,ValueError): pass

def box(scr,y,x,hh,ww,title,bord,tit):
    """Frame is drawn AFTER panel content, so borders always paint over overflow."""
    if hh<2 or ww<2: return
    aw(scr,y,x,"╔"+"═"*(ww-2)+"╗",bord); aw(scr,y+hh-1,x,"╚"+"═"*(ww-2)+"╝",bord)
    for i in range(1,hh-1): aw(scr,y+i,x,"║",bord); aw(scr,y+i,x+ww-1,"║",bord)
    if title: aw(scr,y,x+2," "+title[:max(0,ww-6)]+" ",tit)

def draw_bar(scr,y,x,w,pct,pair):
    """Solid coloured fill + smooth edge over a dark-tone trough of the same colour."""
    f=max(0.0,min(1.0,pct/100))*w; n=int(f); frac=f-n
    aw(scr,y,x," "*w,pair)
    if n>0: aw(scr,y,x," "*n,pair|curses.A_REVERSE)
    if n<w and frac>=1/8:
        aw(scr,y,x+n,"▏▎▍▌▋▊▉"[int(frac*8)-1],pair|curses.A_BOLD)

def draw(scr,d,st):
    h,w=scr.getmaxyx(); scr.erase()
    NORM=curses.color_pair(1); HI=curses.color_pair(2)|curses.A_BOLD
    BORD=curses.color_pair(6)|curses.A_BOLD; TIT=curses.color_pair(2)|curses.A_BOLD
    GOOD=curses.color_pair(4)|curses.A_BOLD; WARN=curses.color_pair(3)|curses.A_BOLD; BAD=curses.color_pair(5)|curses.A_BOLD
    hdr="Backblaze 64 • Upload Monitor"; clk=time.strftime("%H:%M:%S")
    aw(scr,0,0," "*w,HI); aw(scr,0,1,hdr,HI)
    if w>=len(hdr)+len(clk)+4: aw(scr,0,w-len(clk)-2,clk,HI)

    # ---- Status: whole chunks wrap to width, never split ----
    r=d["rate"]; rcol=GOOD if r>=1 else (WARN if r>0.05 else BAD)
    stt=d["state"]; scol=GOOD if stt=="Transmitting" else (WARN if stt in("Scanning","Preparing") else NORM)
    def txt(parts):
        wd=sum(len(p[0]) for p in parts)
        def dr(y,x):
            cx=x
            for s,a in parts: aw(scr,y,cx,s,a); cx+=len(s)
        return {"w":wd,"draw":dr}
    def gauge(label,us,ts_,pct):
        pre="%s %s/%s "%(label,us,ts_); suf=" %d%%"%int(pct)
        def dr(y,x):
            aw(scr,y,x,pre,NORM)
            gp=curses.color_pair(9 if pct>=90 else (8 if pct>=70 else 7))
            draw_bar(scr,y,x+len(pre),12,pct,gp)
            aw(scr,y,x+len(pre)+12,suf, BAD if pct>=90 else (WARN if pct>=70 else GOOD))
        return {"w":len(pre)+12+len(suf),"draw":dr}
    chunks=[
        txt([("Threads: ",NORM),("%d"%d["threads"],NORM)]),
        txt([("Up: ",NORM),("%.2f MB/s"%r,rcol),(" (~%d Mbit/s)"%(r*8),NORM)]),
        txt([("Chunks/60s: ",NORM),("%d"%d["chunks"],NORM)]),
        txt([("Session: ",NORM),(human(d["sess"]),NORM)]),
        txt([("State: ",NORM),(stt,scol)]),
        gauge("Mem:",human(d["mem"][0]),human(d["mem"][1]),d["mem"][2]) if d["mem"] else txt([("Mem: n/a",NORM)]),
        gauge("Swap:",human(d["swap"][0]),human(d["swap"][1]),d["swap"][2]) if d["swap"] else txt([("Swap: off",NORM)]),
    ]
    SEP=3; inner=max(1,w-4); placements=[]; line=0; cx=0
    for c in chunks:
        if cx==0: placements.append((c,line,0)); cx=c["w"]
        elif cx+SEP+c["w"]<=inner: placements.append((c,line,cx+SEP)); cx+=SEP+c["w"]
        else: line+=1; placements.append((c,line,0)); cx=c["w"]
    statusH=line+3
    for c,ln,rx in placements: c["draw"](2+ln,2+rx)
    box(scr,1,0,statusH,w,"Status",BORD,TIT)

    # ---- regions below the (variable-height) Status box ----
    up_top=1+statusH; foot=h-1; avail=foot-up_top
    if avail>=8: rec_h=min(11,max(4,avail//3)); rec_top=foot-rec_h; up_h=rec_top-up_top
    else: rec_h=0; rec_top=foot; up_h=max(0,avail)
    files=d["files"]; n=len(files); cap=max(1,up_h-2); st["cap"]=cap
    soff=min(max(0,st.get("soff",0)),max(0,n-cap)); st["soff"]=soff
    if up_h>=3:
        iw=w-4; bw=max(10,min(40,iw-42)); yy=up_top+1
        if not files: aw(scr,yy,2,"(nothing in flight)",NORM)
        for name,part,fsize,pct in files[soff:soff+cap]:
            bp=curses.color_pair(7 if pct>=67 else (8 if pct>=34 else 9))
            draw_bar(scr,yy,2,bw,pct,bp)
            sz=(human(fsize)+(" (chunked)" if fsize>part*1.5 else "")) if fsize>0 else "%d MB"%(part/1048576)
            aw(scr,yy,2+bw,wclip(" %3.0f%%  %-12s %s"%(pct,sz,name),iw-bw),NORM); yy+=1
        t="Uploading Now"
        if n>cap: t+=" • %d-%d/%d"%(soff+1,min(n,soff+cap),n)
        box(scr,up_top,0,up_h,w,t,BORD,TIT)
    if rec_h>=4:
        aw(scr,rec_top+1,2,"%-8s  %-6s  %-9s  %-12s    %s"%("Time","Thread","Size","Rate","File"),NORM|curses.A_BOLD)
        yy=rec_top+2; rows=d["recent"][-(rec_h-3):]
        if not rows: aw(scr,yy,2,"(watching for completions…)",NORM)
        for tstr,thr,size,rate,name in rows:
            aw(scr,yy,2,wclip("%-8s  thr%-3d  %-9s  %-12s    %s"%(tstr,thr,size,rate,name),w-4),NORM); yy+=1
        box(scr,rec_top,0,rec_h,w,"Recently Completed",BORD,TIT)
    aw(scr,foot,0," "*w,HI)
    aw(scr,foot,1,"q Quit • ↑ ↓ PgUp PgDn Scroll • live every %gs"%INT,HI)
    scr.refresh()

def main(scr):
    curses.curs_set(0); curses.start_color()
    if   curses.COLORS>=256: tg,ty,tr=22,58,52     # dark green / olive / red troughs
    elif curses.COLORS>=16:  tg=ty=tr=8
    else:                    tg=ty=tr=curses.COLOR_BLUE
    curses.init_pair(1,curses.COLOR_WHITE,curses.COLOR_BLUE)   # normal grey-on-blue
    curses.init_pair(2,curses.COLOR_BLACK,curses.COLOR_WHITE)  # highlight black-on-grey
    curses.init_pair(3,curses.COLOR_YELLOW,curses.COLOR_BLUE)
    curses.init_pair(4,curses.COLOR_GREEN,curses.COLOR_BLUE)
    curses.init_pair(5,curses.COLOR_RED,curses.COLOR_BLUE)
    curses.init_pair(6,curses.COLOR_CYAN,curses.COLOR_BLUE)
    curses.init_pair(7,curses.COLOR_GREEN,tg)
    curses.init_pair(8,curses.COLOR_YELLOW,ty)
    curses.init_pair(9,curses.COLOR_RED,tr)
    scr.bkgd(' ',curses.color_pair(1)); scr.keypad(True); scr.timeout(50)
    st={"soff":0,"cap":1}; prev=None; d=None; last=0
    while True:
        ch=scr.getch()
        if ch in (ord('q'),ord('Q')): break
        elif ch in (curses.KEY_UP,ord('k')): st["soff"]-=1
        elif ch in (curses.KEY_DOWN,ord('j')): st["soff"]+=1
        elif ch==curses.KEY_PPAGE: st["soff"]-=st["cap"]
        elif ch==curses.KEY_NPAGE: st["soff"]+=st["cap"]
        if ch!=-1 and d is not None: draw(scr,d,st)
        if d is None or time.time()-last>=INT:
            d=gather(prev); prev=d["_tx"]; last=time.time(); draw(scr,d,st)

if __name__=="__main__":
    if os.environ.get("TERM") in (None,"","dumb","unknown"):
        os.environ["TERM"]="xterm-256color"   # sane default for `docker exec` consoles
    curses.wrapper(main)
