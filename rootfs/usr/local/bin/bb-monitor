#!/usr/bin/env python3
"""Live upload dashboard, run from the container console."""

HELP = """\
Displays live upload activity.

BB-MONITOR [--version]

  q            Quits.
  Up, Down     Scrolls the file list.
  PgUp, PgDn   Scrolls one page.

Shows the transfer rate, the files being sent, and recently completed files.
Needs a terminal:  docker exec -it <container> bb-monitor
"""
import locale; locale.setlocale(locale.LC_ALL, "")
import curses, os, sys, time, unicodedata

# ---- shared data layer ----------------------------------------------------
# Everything that reads /proc, the cgroups and Backblaze's own files lives in
# bbdata, shared with bb-monitor-web. The two used to carry separate copies and
# drifted: the web one gained overall progress, an ETA, files remaining and
# round-trip time while this one kept the original narrower view. A feature
# added to bbdata now shows up in both. This file owns curses and nothing else.
sys.path.insert(0, "/usr/local/lib/bb-monitor")
from bbdata import (BUILD_LABEL, INT, eta_str, gather, human, rec_cols,
                     uptime_str, _upload_rtt)

# ---- curses-only helper -------------------------------------------------------
def wclip(s,width):
    """Clip to terminal cells, not codepoints (CJK/emoji are 2 cells wide)."""
    out=[]; cw=0
    for ch in s:
        w=2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if cw+w>width: break
        out.append(ch); cw+=w
    return "".join(out)

# ---- dashboard ------------------------------------------------------------------
def aw(scr,y,x,s,attr=0):
    h,w=scr.getmaxyx()
    if not(0<=y<h) or x>=w: return
    if x<0: s=s[-x:]; x=0
    s=s[:w-x]
    if y==h-1 and x+len(s)>=w: s=s[:w-x-1]
    try: scr.addstr(y,x,s,attr)
    except (curses.error,ValueError): pass

def box(scr,y,x,hh,ww,title,bord,tit):
    """Frame is drawn AFTER panel content, so borders always paint over overflow."""
    if hh<2 or ww<2: return
    aw(scr,y,x,"╔"+"═"*(ww-2)+"╗",bord); aw(scr,y+hh-1,x,"╚"+"═"*(ww-2)+"╝",bord)
    for i in range(1,hh-1): aw(scr,y+i,x,"║",bord); aw(scr,y+i,x+ww-1,"║",bord)
    if title: aw(scr,y,x+2," "+title[:max(0,ww-6)]+" ",tit)

def draw_bar(scr,y,x,w,pct,pair):
    """Solid coloured fill + smooth edge over a dark-tone trough of the same colour."""
    f=max(0.0,min(1.0,pct/100))*w; n=int(f); frac=f-n
    aw(scr,y,x," "*w,pair)
    if n>0: aw(scr,y,x," "*n,pair|curses.A_REVERSE)
    if n<w and frac>=1/8:
        aw(scr,y,x+n,"▏▎▍▌▋▊▉"[int(frac*8)-1],pair|curses.A_BOLD)

def draw(scr,d,st):
    h,w=scr.getmaxyx(); scr.erase()
    NORM=curses.color_pair(1); HI=curses.color_pair(2)|curses.A_BOLD
    BORD=curses.color_pair(6)|curses.A_BOLD; TIT=curses.color_pair(2)|curses.A_BOLD
    GOOD=curses.color_pair(4)|curses.A_BOLD; WARN=curses.color_pair(3)|curses.A_BOLD; BAD=curses.color_pair(5)|curses.A_BOLD
    hdr="Backblaze 64 • Upload Monitor"; clk=time.strftime("%H:%M:%S")
    aw(scr,0,0," "*w,HI); aw(scr,0,1,hdr,HI)
    if w>=len(hdr)+len(clk)+4: aw(scr,0,w-len(clk)-2,clk,HI)

    # ---- Status: whole chunks wrap to width, never split ----
    r=d["rate"]; rcol=GOOD if r>=1 else (WARN if r>0.05 else BAD)
    stt=d["state"]; scol=GOOD if stt=="Transmitting" else (WARN if stt in("Scanning","Preparing") else NORM)
    def txt(parts):
        wd=sum(len(p[0]) for p in parts)
        def dr(y,x):
            cx=x
            for s,a in parts: aw(scr,y,cx,s,a); cx+=len(s)
        return {"w":wd,"draw":dr}
    def gauge(label,us,ts_,pct,high_is_good=False,note=""):
        # Mem and Swap are bad when full; Backup is good when full. Same widget,
        # opposite reading, so the direction has to be told rather than assumed.
        pre="%s %s/%s "%(label,us,ts_); suf=" %d%%"%int(pct)+(" %s"%note if note else "")
        if high_is_good: sev=0 if pct>=67 else (1 if pct>=34 else 2)
        else:            sev=2 if pct>=90 else (1 if pct>=70 else 0)
        def dr(y,x):
            aw(scr,y,x,pre,NORM)
            draw_bar(scr,y,x+len(pre),12,pct,curses.color_pair((7,8,9)[sev]))
            aw(scr,y,x+len(pre)+12,suf,(GOOD,WARN,BAD)[sev])
        return {"w":len(pre)+12+len(suf),"draw":dr}
    chunks=[
        txt([("Threads: ",NORM),("%d"%d["threads"],NORM)]),
        txt([("Up: ",NORM),("%.2f MB/s"%r,rcol),(" (~%d Mbit/s)"%(r*8),NORM)]),
        txt([("Chunks/60s: ",NORM),("%d"%d["chunks"],NORM)]),
        txt([("Session: ",NORM),(human(d["sess"]),NORM)]),
        txt([("State: ",NORM),(stt,scol)]),
        gauge("Mem:",human(d["mem"][0]),human(d["mem"][1]),d["mem"][2]) if d["mem"] else txt([("Mem: n/a",NORM)]),
        gauge("Swap:",human(d["swap"][0]),human(d["swap"][1]),d["swap"][2]) if d["swap"] else txt([("Swap: off",NORM)]),
    ]
    # Everything below reached the web dashboard first. Both read the same
    # bbdata.gather(), so they stay in step from here.
    rtt_ms,rtt_peer,_=_upload_rtt()
    if rtt_ms is None: chunks.append(txt([("RTT: n/a",NORM)]))
    else:
        rc=GOOD if rtt_ms<80 else (WARN if rtt_ms<200 else BAD)
        chunks.append(txt([("RTT: ",NORM),("%dms"%round(rtt_ms),rc)]))
    b=d.get("backup")
    if b:
        fr=b.get("remaining_files")
        if fr is not None:
            chunks.append(txt([("Files Remaining: ",NORM),("{:,}".format(fr),NORM)]))
        chunks.append(gauge("Backup:",human(b["done"]),human(b["total"]),b["pct"],
                             high_is_good=True,note="ETA "+eta_str(b.get("eta_seconds"))))
    chunks.append(txt([("Uptime: ",NORM),(uptime_str(),NORM)]))
    SEP=3; inner=max(1,w-4); placements=[]; line=0; cx=0
    for c in chunks:
        if cx==0: placements.append((c,line,0)); cx=c["w"]
        elif cx+SEP+c["w"]<=inner: placements.append((c,line,cx+SEP)); cx+=SEP+c["w"]
        else: line+=1; placements.append((c,line,0)); cx=c["w"]
    statusH=line+3
    for c,ln,rx in placements: c["draw"](2+ln,2+rx)
    box(scr,1,0,statusH,w,"Status",BORD,TIT)

    # ---- regions below the (variable-height) Status box ----
    up_top=1+statusH; foot=h-1; avail=foot-up_top
    if avail>=8: rec_h=min(11,max(4,avail//3)); rec_top=foot-rec_h; up_h=rec_top-up_top
    else: rec_h=0; rec_top=foot; up_h=max(0,avail)
    files=d["files"]; n=len(files); cap=max(1,up_h-2); st["cap"]=cap
    soff=min(max(0,st.get("soff",0)),max(0,n-cap)); st["soff"]=soff
    if up_h>=3:
        iw=w-4; bw=max(10,min(40,iw-42)); yy=up_top+1
        if not files: aw(scr,yy,2,"(nothing in flight)",NORM)
        for name,part,fsize,pct in files[soff:soff+cap]:
            bp=curses.color_pair(7 if pct>=67 else (8 if pct>=34 else 9))
            draw_bar(scr,yy,2,bw,pct,bp)
            sz=(human(fsize)+(" (chunked)" if fsize>part*1.5 else "")) if fsize>0 else "%d MB"%(part/1048576)
            aw(scr,yy,2+bw,wclip(" %3.0f%%  %-12s %s"%(pct,sz,name),iw-bw),NORM); yy+=1
        t="Uploading Now"
        if n>cap: t+=" • %d-%d/%d"%(soff+1,min(n,soff+cap),n)
        box(scr,up_top,0,up_h,w,t,BORD,TIT)
    if rec_h>=4:
        aw(scr,rec_top+1,2,"%-8s  %-6s  %-9s  %-12s    %s"%("Time","Thread","Size","Rate","File"),NORM|curses.A_BOLD)
        yy=rec_top+2; rows=d["recent"][-(rec_h-3):]
        if not rows: aw(scr,yy,2,"(watching for completions…)",NORM)
        for r in rows:
            th,size,rate=rec_cols(r)
            aw(scr,yy,2,wclip("%-8s  %-6s  %-9s  %-12s    %s"%(r["t"],th,size,rate,r["name"]),w-4),NORM); yy+=1
        box(scr,rec_top,0,rec_h,w,"Recently Completed",BORD,TIT)
    aw(scr,foot,0," "*w,HI)
    ft="q Quit • ↑ ↓ PgUp PgDn Scroll • live every %gs"%INT
    aw(scr,foot,1,ft,HI)
    # Build identifier on the right, so a screenshot of the monitor says which image
    # produced it. Dropped rather than overlapped when the terminal is too narrow.
    if BUILD_LABEL and w >= len(ft)+len(BUILD_LABEL)+5:
        aw(scr,foot,w-len(BUILD_LABEL)-2,BUILD_LABEL,HI)
    scr.refresh()

def main(scr):
    curses.curs_set(0); curses.start_color()
    if   curses.COLORS>=256: tg,ty,tr=22,58,52     # dark green / olive / red troughs
    elif curses.COLORS>=16:  tg=ty=tr=8
    else:                    tg=ty=tr=curses.COLOR_BLUE
    curses.init_pair(1,curses.COLOR_WHITE,curses.COLOR_BLUE)   # normal grey-on-blue
    curses.init_pair(2,curses.COLOR_BLACK,curses.COLOR_WHITE)  # highlight black-on-grey
    curses.init_pair(3,curses.COLOR_YELLOW,curses.COLOR_BLUE)
    curses.init_pair(4,curses.COLOR_GREEN,curses.COLOR_BLUE)
    curses.init_pair(5,curses.COLOR_RED,curses.COLOR_BLUE)
    curses.init_pair(6,curses.COLOR_CYAN,curses.COLOR_BLUE)
    curses.init_pair(7,curses.COLOR_GREEN,tg)
    curses.init_pair(8,curses.COLOR_YELLOW,ty)
    curses.init_pair(9,curses.COLOR_RED,tr)
    scr.bkgd(' ',curses.color_pair(1)); scr.keypad(True); scr.timeout(50)
    st={"soff":0,"cap":1}; prev=None; d=None; last=0
    while True:
        ch=scr.getch()
        if ch in (ord('q'),ord('Q')): break
        elif ch in (curses.KEY_UP,ord('k')): st["soff"]-=1
        elif ch in (curses.KEY_DOWN,ord('j')): st["soff"]+=1
        elif ch==curses.KEY_PPAGE: st["soff"]-=st["cap"]
        elif ch==curses.KEY_NPAGE: st["soff"]+=st["cap"]
        if ch!=-1 and d is not None: draw(scr,d,st)
        if d is None or time.time()-last>=INT:
            d=gather(prev); prev=d["_tx"]; last=time.time(); draw(scr,d,st)

def _print_version():
    """Which image build this came from - the identifier worth having in a bug report."""
    print("bb-monitor (Backblaze 64 container)")
    try:
        with open("/etc/bb-build") as fh: sys.stdout.write(fh.read())
    except OSError:
        print("version=unknown (no build stamp)")

if __name__=="__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "-V"):
        _print_version(); sys.exit(0)
    if len(sys.argv) > 1 and sys.argv[1] in ("--help", "-h"):
        print(HELP, end=""); sys.exit(0)
    if os.environ.get("TERM") in (None,"","dumb","unknown"):
        os.environ["TERM"]="xterm-256color"   # sane default for `docker exec` consoles
    curses.wrapper(main)
