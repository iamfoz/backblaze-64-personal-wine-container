#!/bin/sh
# Recovers from the two stall modes bb-health detects. Opt-in.
#
# Each recovery is the smallest action that clears the fault:
#
#   WEDGE  Delete the stale four-hour lock so the next pass can start. Lighter
#          than a container restart, and bb-health has already confirmed no
#          bztransmit has been running long enough to own the lock.
#
#   DOWN   Report it and leave the first restart to startapp's service watch,
#          which runs every five minutes. If the service is still down when
#          the cooldown ends, start it from here with the same bounded net
#          stop and net start the watch uses. The watch is one bash loop; a
#          build of 2026-09-28 broke it so that it looped instead of logging,
#          and two hosts then sat DOWN for six and seven hours while this
#          branch reported the state every half hour and did nothing about it.
#
#   ORPHAN A bztransmit whose parent exited and that has run on for
#          STALL_MIN minutes since (bb-health --orphans). Nothing waits for
#          it: the pass that started it is gone, and a fresh pass has its own.
#          Stopped on sight, outside the cooldown, since each is a one-off and
#          the backup is not at fault. Never bzfilelist: the client runs its
#          scans detached from the pass, and a first version of this rule
#          killed every scan at twenty minutes (2026-10-07).
#
#   HANG   Kill the push children and the backup pass that launched them.
#          Killing the children alone used to be enough; since client 10.0.3
#          the pass waits for a child's result file with no timeout, so a child
#          that dies or is killed leaves the pass waiting forever (seen twice on
#          2026-09-19 and 20). bzserv notices the pass exit within ten seconds,
#          clears the lock and starts a fresh pass, which re-reads its bz_done
#          files and carries on. Sidecar bztransmit runs (-updatebackupstats
#          and the like) are killed with it; they are relaunched hourly and
#          lose nothing. If that does not clear the fault the health state
#          stays unhealthy and visible; the watchdog does not escalate further.
#
# After detecting a fault it waits COOLDOWN_MIN before acting again, whether or
# not the action worked, so an unfixable fault produces one log line per cooldown
# instead of a retry storm.
#
# Env: ENABLE_WATCHDOG (must be "true"), WATCHDOG_INTERVAL (300s),
#      COOLDOWN_MIN (30), plus the thresholds bb-health reads.
set -u

usage() {
    cat <<'EOF'
Recovers the backup automatically when bb-health reports a fault.

BB-WATCHDOG [--version]

Started by the container when ENABLE_WATCHDOG is true.  Clears a stale
four-hour lock, restarts a backup pass stuck on its upload children, stops
helper processes left behind by a pass that exited, and starts the Backblaze
service when it has stayed down past one cooldown.
Actions are written to the container log and the recovery log.

  ENABLE_WATCHDOG      Must be true, or the watchdog stays idle.
  WATCHDOG_INTERVAL    Seconds between checks.  Default 300.
  COOLDOWN_MIN         Minutes to wait after acting.  Default 30.
EOF
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Report which image build this came from. The tools ship together inside an image,
# so the build stamp is the identifier worth having in a bug report.
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-V" ]; then
    echo "bb-watchdog (Backblaze 64 container)"
    cat /etc/bb-build 2>/dev/null || echo "version=unknown (no build stamp)"
    exit 0
fi

INTERVAL="${WATCHDOG_INTERVAL:-300}"
COOLDOWN_MIN="${COOLDOWN_MIN:-30}"
STALL_MIN="${STALL_MIN:-20}"
last_action=0
down_seen=0        # a DOWN was acted on at the previous action, so it has persisted

# All three must be plain positive integers. sleep rejects a suffixed value such
# as "5 min" and returns immediately, which without validation turns this loop
# into a fork storm on a host that is usually short of resources already.
int_or() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
INTERVAL="$(int_or "$INTERVAL" 300)"
COOLDOWN_MIN="$(int_or "$COOLDOWN_MIN" 30)"
STALL_MIN="$(int_or "$STALL_MIN" 20)"

# The cooldown must exceed bb-health's stall threshold. Killing the deadlocked
# threads does not advance the transmit log; only the respawned pass writing a
# line does. If the watchdog re-arms before the log can look fresh, it kills the
# healthy replacement pass every cycle and causes the stall it should clear.
if [ "$COOLDOWN_MIN" -le "$STALL_MIN" ]; then
    COOLDOWN_MIN=$(( STALL_MIN + 10 ))
fi

say() { echo "[bb-watchdog] $(date '+%Y-%m-%d %H:%M:%S') $*"; }
# Actions also go to the recovery log the monitor reads; see bb-record.sh.
. /usr/local/lib/bb-record.sh 2>/dev/null || bb_record() { :; }
act() { say "$*"; bb_record watchdog "$*"; }

proc_pids() {
    for c in /proc/[0-9]*/cmdline; do
        [ -r "$c" ] || continue
        if tr '\0' ' ' < "$c" 2>/dev/null | grep -q -- "$1"; then
            p=${c#/proc/}; echo "${p%/cmdline}"
        fi
    done
}

# The service, by the process table: Wine's service manager reported bzserv
# RUNNING for an hour after the process had gone (2026-09-23).
bzserv_up() { [ -n "$(proc_pids 'bzserv.exe')" ]; }

# Every Wine helper is bounded and killed with the processes it started: an
# "sc query" sat for 53 minutes on 2026-09-24. The stop clears the record the
# service manager keeps for a process that died under it, without which the
# start is a no-op; on a stopped service it fails harmlessly.
wine_bounded() { timeout -k 10 "$1" setsid wine "$2" "$3" "$4" >/dev/null 2>&1; }
start_bzserv() {
    wine_bounded 60 net stop bzserv
    sleep 3
    wine_bounded 120 net start bzserv
    n=0
    while [ "$n" -lt 12 ]; do
        bzserv_up && return 0
        sleep 5
        n=$((n + 1))
    done
    bzserv_up
}

cooling_down() {
    now=$(date +%s)
    [ $(( now - last_action )) -lt $(( COOLDOWN_MIN * 60 )) ]
}

say "started: checking every ${INTERVAL}s (cooldown ${COOLDOWN_MIN}m)"

# The Settings tab's switch. Off means leave: the service script that started
# this parks until it is switched on again, so no bb-watchdog process exists
# while it is off, the same as with the variable unset.
SWITCH=/config/bb-api/watchdog.json

while true; do
    sleep "$INTERVAL" || sleep 300

    if [ -r "$SWITCH" ] && grep -q '"enabled": *false' "$SWITCH"; then
        say "switched off from Settings - stopping"
        echo disabled > /tmp/.bb-watchdog-state 2>/dev/null
        exit 0
    fi

    # Orphans first, every cycle: not a health state, so not under the
    # cooldown, and killing one cannot disturb a live pass.
    bb-health --orphans 2>/dev/null | while read -r opid oage oname; do
        [ -n "$opid" ] || continue
        kill "$opid" 2>/dev/null
        sleep 5
        if kill -0 "$opid" 2>/dev/null; then kill -9 "$opid" 2>/dev/null; sleep 1; fi
        if kill -0 "$opid" 2>/dev/null; then
            act "could NOT stop orphaned ${oname} [${opid}] - restart the container"
        else
            act "recovered: stopped orphaned ${oname} [${opid}], running ${oage}m after the pass that started it exited"
        fi
    done

    status="$(bb-health 2>/dev/null)" || true
    case "$status" in
        OK*|"") down_seen=0; continue ;;
    esac

    if cooling_down; then
        say "still unhealthy (${status}) - within cooldown, not acting again yet"
        continue
    fi

    # Start the cooldown at detection rather than on success. A recovery that
    # fails, for example on a read-only config volume, has to back off too, or it
    # retries every interval and floods the log.
    last_action=$(date +%s)

    case "$status" in
        WEDGE*)
            down_seen=0
            lock="/config/wine/dosdevices/c:/ProgramData/Backblaze/bzdata/bzbackup/lock_bzfileid_4_hour_lock.lck"
            act "detected: ${status}"
            if rm -f "$lock" 2>/dev/null; then
                act "recovered: removed the stale four-hour lock; the next pass should proceed"
            else
                act "could NOT remove ${lock} - check permissions on the config volume; next attempt in ${COOLDOWN_MIN}m"
            fi
            ;;
        HANG*)
            down_seen=0
            act "detected: ${status}"
            # Children first, then every other bztransmit, which is the pass
            # and any sidecar. The pass must go: it never gives up waiting for
            # a child on its own.
            pids="$(proc_pids 'bztransmit.exe -threadpush')"
            pass="$(proc_pids 'bztransmit.exe' | grep -v -x -F -- "$pids")"
            if [ -n "$pids$pass" ]; then
                # shellcheck disable=SC2086
                kill $pids 2>/dev/null
                sleep 2
                # shellcheck disable=SC2086
                kill $pass 2>/dev/null
                sleep 10
                # Escalate to -9 only for original pids that are still alive
                # and still bztransmit. Re-scanning by name would catch the
                # fresh pass bzserv has already started, and killing that
                # mid-write causes the wedge this recovery is meant to clear.
                still=""
                for p in $pids $pass; do
                    if kill -0 "$p" 2>/dev/null \
                       && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- "bztransmit.exe"; then
                        still="$still $p"
                    fi
                done
                if [ -n "$still" ]; then
                    # shellcheck disable=SC2086
                    kill -9 $still 2>/dev/null
                fi
                act "recovered: killed push children [${pids}] and the pass [${pass}]; bzserv will start a fresh pass"
            else
                act "no bztransmit found to kill - transmit may have cleared on its own"
            fi
            ;;
        DOWN*)
            # startapp's service watch restarts the service within five
            # minutes, with the environment the client was started under, so
            # the first sighting is left to it. A second sighting one cooldown
            # later means the watch did not manage it, or is not there.
            if [ "$down_seen" -eq 0 ]; then
                down_seen=1
                act "detected: ${status} - the service watch restarts it; if it is still down in ${COOLDOWN_MIN}m the watchdog starts it"
            else
                act "detected: ${status} - still down after ${COOLDOWN_MIN}m, starting the service"
                if start_bzserv; then
                    act "recovered: started bzserv; a backup pass follows"
                else
                    act "could NOT start bzserv - see bzlogs/bzserv; next attempt in ${COOLDOWN_MIN}m"
                fi
            fi
            ;;
        *)
            say "unrecognised health status: ${status}"
            ;;
    esac
done
