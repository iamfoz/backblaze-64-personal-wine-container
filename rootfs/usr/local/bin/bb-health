#!/bin/sh
# Reports backup health for the container HEALTHCHECK and for bb-watchdog.
#
# An idle, newly installed or signed-out container reports OK. A backup with
# nothing to do is not broken, and a health state that flickers red during
# normal quiet periods would train people to ignore it. Only corroborated
# failures are reported:
#
#   HANG   A backup pass is waiting on chunk uploads that will never finish.
#          Three shapes, any one of which is enough:
#            - a push child is alive but the transmit log has not advanced for
#              STALL_MIN minutes (the original deadlock in Wine's pipe handling);
#            - a push child has itself been alive for STALL_MIN minutes. One
#              chunk is 10 MB and takes seconds; a child that old never reached
#              its upload, as when Wine's process start-up hangs;
#            - the pass's last log line says it is waiting for "sub_threads"
#              and has been for STALL_MIN minutes, and no push child exists at
#              all. A child that died before it could report leaves the parent
#              waiting forever, while its heartbeat keeps the log looking fresh.
#          The pass on its own does not recover from any of these: it has no
#          timeout for a child. A long wait with young children coming and
#          going is a slow link, not a hang, and stays OK.
#
#   DOWN   The client is up but its service, bzserv, is not. bzserv is what
#          starts every pass, so nothing backs up until it is back. It died
#          silently on 2026-09-20 (exit 1067) and bb-health said OK for six
#          hours. The GUI is allowed SERVICE_GRACE_MIN minutes to bring the
#          service up after a start before this is reported.
#
#   WEDGE  A stale four-hour lock is blocking every pass. When bztransmit dies
#          mid-pass - an out-of-memory kill, or a container restart that takes
#          the lock holder with it - the lock file outlives it and the log
#          floods with "Failed to grab fourHourLock". Required in every case:
#          the lock present, repeated failures in the log, and no bztransmit
#          that has been running for LOCK_GRACE_MIN minutes. A pass writes its
#          lock only after it starts, so a lock older than the grace window
#          cannot belong to any process younger than it, and a live holder is
#          never second-guessed. On top of that, either the lock is older than
#          LOCK_AGE_MIN, or it is older than LOCK_GRACE_MIN with failures
#          still being written now. The second form catches the respawn loop:
#          bzserv relaunches bztransmit every few seconds, each attempt dies
#          on the lock, and the constant restarts keep every mtime fresh, so
#          only process age can corroborate it. It is a WEDGE rather than a
#          HANG because there is nothing to kill, only a lock to remove.
#
# Env: STALL_MIN (20), LOCK_AGE_MIN (245), LOCK_FAILS (5), LOCK_GRACE_MIN (2),
#      SERVICE_GRACE_MIN (3).
set -u

usage() {
    cat <<'EOF'
Reports whether the backup is running normally.

BB-HEALTH [--version]

Displays one of:

  OK           Nothing is wrong.  An idle or newly installed container is OK.
  HANG         A backup pass is stuck on its chunk uploads.
  DOWN         The Backblaze service, bzserv, is not running.
  WEDGE        A stale four-hour lock is blocking every pass.

Exits with 0 for OK, otherwise 1.  Used by the container health check.
EOF
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Report which image build this came from. The tools ship together inside an image,
# so the build stamp is the identifier worth having in a bug report.
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-V" ]; then
    echo "bb-health (Backblaze 64 container)"
    cat /etc/bb-build 2>/dev/null || echo "version=unknown (no build stamp)"
    exit 0
fi

BZ="/config/wine/dosdevices/c:/ProgramData/Backblaze/bzdata"
TLOG="${BZ}/bzlogs/bztransmit"
LOCK="${BZ}/bzbackup/lock_bzfileid_4_hour_lock.lck"
STALL_MIN="${STALL_MIN:-20}"
LOCK_AGE_MIN="${LOCK_AGE_MIN:-245}"     # the lock covers 4h; past that a live holder would have renewed or finished
LOCK_FAILS="${LOCK_FAILS:-5}"
LOCK_GRACE_MIN="${LOCK_GRACE_MIN:-2}"   # a pass must have run this long before it is assumed to own the lock
SERVICE_GRACE_MIN="${SERVICE_GRACE_MIN:-3}"   # the GUI gets this long to bring bzserv up

# The thresholds feed arithmetic below and must be plain positive integers. A
# suffixed value such as "20m" would otherwise fail in a way that reads as a
# stall, so bad input falls back to the default.
int_or() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
STALL_MIN="$(int_or "$STALL_MIN" 20)"
LOCK_AGE_MIN="$(int_or "$LOCK_AGE_MIN" 245)"
LOCK_FAILS="$(int_or "$LOCK_FAILS" 5)"
LOCK_GRACE_MIN="$(int_or "$LOCK_GRACE_MIN" 2)"
SERVICE_GRACE_MIN="$(int_or "$SERVICE_GRACE_MIN" 3)"

# Match a process by command line without needing procps in the image.
proc_match() {
    for c in /proc/[0-9]*/cmdline; do
        [ -r "$c" ] || continue
        if tr '\0' ' ' < "$c" 2>/dev/null | grep -q -- "$1"; then return 0; fi
    done
    return 1
}

newest_log() { ls -t "${TLOG}"/*.log 2>/dev/null | head -1; }

# Minutes since the oldest process matching $1 started, or empty when none
# match. Start times come from the starttime field of /proc/PID/stat measured
# against /proc/uptime, not from /proc/PID mtimes, which some kernels refresh.
# A start time that cannot be read reports as $2, which defaults to very old:
# the lock check uses this to decide whether a live bztransmit could own the
# lock, and that question must fail toward "it could". The hang check passes
# an empty fallback instead, because there an unreadable age must fail toward
# "not a hang": its verdict kills a running pass.
oldest_proc_min() {
    unreadable="${2-99999}"
    up="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
    tick="$(getconf CLK_TCK 2>/dev/null)"
    case "$up" in ''|*[!0-9]*) up="" ;; esac
    case "$tick" in ''|*[!0-9]*) tick=100 ;; esac
    oldest=""
    for c in /proc/[0-9]*/cmdline; do
        [ -r "$c" ] || continue
        tr '\0' ' ' < "$c" 2>/dev/null | grep -q -- "$1" || continue
        # starttime is the 20th field after the parenthesised comm, which can
        # itself contain spaces, so strip through the last ")" first.
        st="$(sed 's/^.*) //' "${c%/cmdline}/stat" 2>/dev/null | awk '{print $20}')"
        case "$st" in ''|*[!0-9]*) st="" ;; esac
        if [ -z "$up" ] || [ -z "$st" ]; then echo "$unreadable"; return; fi
        age=$(( ( up - st / tick ) / 60 ))
        if [ -z "$oldest" ] || [ "$age" -gt "$oldest" ]; then oldest="$age"; fi
    done
    echo "$oldest"
}

# Age of a file in whole minutes, or empty if it cannot be read. This uses stat
# and epoch arithmetic rather than find's -newermt date parsing. A stall check has
# to fail safe: with find, any error (unparsable date, file rotated away mid-check)
# gave the same empty output as a genuinely stale file and produced a HANG, whose
# recovery kills live upload threads. A read failure here yields "" and is
# skipped by the caller.
age_min() {
    mt="$(stat -c %Y "$1" 2>/dev/null)" || return 0
    case "$mt" in ''|*[!0-9]*) return 0 ;; esac
    echo $(( ( $(date +%s) - mt ) / 60 ))
}

log="$(newest_log)"

# --- HANG: a pass is waiting on chunk uploads that will never finish -------------
if proc_match -threadpush; then
    if [ -n "$log" ]; then
        log_age="$(age_min "$log")"
        if [ -n "$log_age" ] && [ "$log_age" -ge "$STALL_MIN" ]; then
            echo "HANG transmit log idle ${log_age}m (threshold ${STALL_MIN}m) with a push thread alive"
            exit 1
        fi
    fi
    # A chunk is 10 MB and a healthy child is gone in seconds, a few minutes on
    # a slow link. One alive for the stall window never got to its upload.
    child_age="$(oldest_proc_min -threadpush "")"
    if [ -n "$child_age" ] && [ "$child_age" -ge "$STALL_MIN" ]; then
        echo "HANG a push child has been alive ${child_age}m (threshold ${STALL_MIN}m) without finishing its chunk"
        exit 1
    fi
elif [ -n "$log" ]; then
    # No child at all, yet the pass says it is waiting for one. Its heartbeat
    # line carries how long it has waited, so the log's own age says nothing.
    # Only the last line counts: an old wait further up belongs to a pass that
    # has since moved on.
    wait_ms="$(tail -1 "$log" 2>/dev/null | sed -n 's/.*Some sub_threads busy for numMillis=\([0-9][0-9]*\).*/\1/p')"
    case "$wait_ms" in ''|*[!0-9]*) wait_ms="" ;; esac
    if [ -n "$wait_ms" ] && [ $(( wait_ms / 60000 )) -ge "$STALL_MIN" ]; then
        echo "HANG pass waiting $(( wait_ms / 60000 ))m (threshold ${STALL_MIN}m) for push children that no longer exist"
        exit 1
    fi
fi

# --- DOWN: the client is up but its service is not ---------------------------------
# After HANG, not before: a stuck pass can outlive the service that launched
# it, and while DOWN came first the watchdog was told DOWN every cycle and
# never heard about the pass it could have stopped (182 minutes, 2026-09-23).
# bzbui.exe is what startapp launches, so its age is how long the container has
# been trying. An unreadable age must not read as DOWN: the verdict turns the
# health check red and the container's own recovery starts the service.
if proc_match bzbui.exe && ! proc_match bzserv.exe; then
    gui_age="$(oldest_proc_min bzbui.exe "")"
    if [ -n "$gui_age" ] && [ "$gui_age" -ge "$SERVICE_GRACE_MIN" ]; then
        echo "DOWN the Backblaze service (bzserv) is not running, so no backup pass can start"
        exit 1
    fi
fi

# --- WEDGE: a stale four-hour lock is blocking every pass -------------------------
if [ -f "$LOCK" ]; then
    oldest="$(oldest_proc_min bztransmit)"
    lock_age="$(age_min "$LOCK")"
    # Nothing to decide unless every live bztransmit is younger than the grace
    # window: a lock older than the window cannot belong to any of them.
    if [ -n "$lock_age" ] && { [ -z "$oldest" ] || [ "$oldest" -lt "$LOCK_GRACE_MIN" ]; }; then
        fails=0
        [ -n "$log" ] && fails=$(tail -40 "$log" 2>/dev/null | grep -c "Failed to grab fourHourLock")
        if [ "${fails:-0}" -ge "$LOCK_FAILS" ]; then
            if [ "$lock_age" -ge "$LOCK_AGE_MIN" ]; then
                echo "WEDGE stale four-hour lock, ${fails} recent lock failures, no bztransmit old enough to own it"
                exit 1
            fi
            # The respawn loop: bzserv relaunches bztransmit every few seconds
            # and each attempt dies on the lock. The failures must still be
            # being written now, or a younger-than-LOCK_AGE_MIN lock stays a
            # live pass's business.
            log_age="$(age_min "$log")"
            if [ "$lock_age" -ge "$LOCK_GRACE_MIN" ] \
               && [ -n "$log_age" ] && [ "$log_age" -le "$LOCK_GRACE_MIN" ]; then
                echo "WEDGE stale four-hour lock, bztransmit respawning against it (${fails} recent lock failures)"
                exit 1
            fi
        fi
    fi
fi

echo "OK"
exit 0
