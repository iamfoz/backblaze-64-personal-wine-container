  .controls{display:flex;gap:8px;align-items:center;margin-bottom:16px;}
  /* The reasons double as the filter, so they are buttons rather than text: a
     count is only half an answer, and the other half is which files it means. */
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
  .chip{padding:3px 10px;border-radius:10px;font-size:12px;font-weight:400;
    background:transparent;color:var(--text);}
  .chip.on{background:var(--title);color:var(--bg);font-weight:600;}
  table{width:100%;border-collapse:collapse;margin-top:6px;}
  th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--border);
    font-size:13px;vertical-align:top;}
  th{color:var(--dim);font-weight:600;white-space:nowrap;}
  td.reason{white-space:nowrap;}
  /* Paths on a mounted share get long and there is nothing to abbreviate them
     to, so they wrap on the separator rather than overflowing the panel. */
  td.path{word-break:break-all;color:var(--dim);}
  .err{color:var(--bad);margin-top:8px;}
  @media (max-width:560px){ table,thead,tbody,tr,th,td{display:block;}
    thead{display:none;} tr{border-bottom:1px solid var(--border);padding:6px 0;}
    th,td{border:none;padding:2px 0;white-space:normal;} }
</style></head><body>

<h1>Skipped Files</h1>
<p class="dim">Files Backblaze has given up on. They are not queued and they are not
retried, so they are not backed up, and the Issues tab on the desktop does not list
them.</p>

<div class="controls">
  <input type="text" id="filter" placeholder="Filter by name or path" autocomplete="off" hidden>
  <button class="ghost" id="refresh">Refresh</button>
</div>

<div class="panel" id="none" hidden>
  <strong class="good">Nothing skipped.</strong>
  <p class="dim" style="margin:8px 0 0">Every file the client has looked at is either backed
  up or still waiting its turn. Nothing has been given up on.</p>
</div>

<div id="some" hidden>
  <div class="panel">
    <div id="summary"></div>
    <div class="chips" id="chips"></div>
    <p id="trunc" class="dim" style="margin:10px 0 0" hidden></p>
  </div>

  <!-- Only shown when that reason is actually present, because it is a specific
       diagnosis and not general advice. -->
  <div class="panel" id="permnote" hidden>
    <strong>About bad permissions</strong>
    <p class="dim" style="margin:8px 0 0">Under this container that almost always means the
    container user cannot read the file. That points at ownership on the mounted share
    rather than at anything wrong with Backblaze. Run <code>bb-doctor</code>: it diagnoses
    this case and prints the command that fixes it.</p>
  </div>

  <div class="panel">
    <table><thead><tr><th>Reason</th><th>File</th><th>Path</th></tr></thead>
    <tbody id="rows"></tbody></table>
    <p id="empty" class="dim" hidden>Nothing matches that filter.</p>
  </div>
</div>

<div class="err" id="err" hidden></div>

<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
// The client reports its own constants, BZ_FILE_PERMANENT_BAD_PERMISSIONS and
// the like. Shouting an identifier at someone is not an explanation, so the
// prefix goes and the rest is read as words; the raw value stays in the title
// attribute for anyone searching Backblaze support for it verbatim.
function pretty(r){
  var s = String(r==null?'':r).replace(/^BZ_/, '').replace(/^FILE_/, '');
  return s ? s.toLowerCase().replace(/_/g, ' ') : String(r==null?'':r);
}
var PERM = 'BZ_FILE_PERMANENT_BAD_PERMISSIONS';
var DATA = null;   // the last answer from /manage/skipped
var REASON = '';   // the reason chip in force, empty meaning all of them

function render(){
  var list = DATA && DATA.list;
  var files = (list && list.files) || [];
  document.getElementById('none').hidden = files.length > 0;
  document.getElementById('some').hidden = files.length === 0;
  document.getElementById('filter').hidden = files.length === 0;
  if(!files.length) return;

  // Counted from the list rather than from the counter beside it. The counter
  // reads every line that has three columns, which includes the report header
  // the client writes at the top, so it reports one file too many under a reason
  // that is really a date. The list keeps only lines with a real path, so its
  // total is the one that matches the rows on screen.
  var reasons = {};
  // The data layer counts reasons across every skipped file, not only the ones
  // sent down, so a truncated listing still reports how many of each exist.
  // Counting the rows here is the fallback for a container old enough not to
  // send that field.
  if (list && list.reasons) { reasons = list.reasons; }
  else { files.forEach(function(f){ reasons[f.reason] = (reasons[f.reason] || 0) + 1; }); }
  var total = list.total;
  document.getElementById('summary').innerHTML =
    '<strong>' + total + (total === 1 ? ' file' : ' files') + ' skipped.</strong>';

  var names = Object.keys(reasons).sort(function(a, b){ return reasons[b] - reasons[a]; });
  var chips = '<button class="chip' + (REASON ? '' : ' on') + '" data-reason="">All</button>';
  names.forEach(function(n){
    chips += '<button class="chip' + (REASON === n ? ' on' : '') + '" data-reason="' +
             esc(n) + '" title="' + esc(n) + '">' + esc(pretty(n)) +
             ' (' + reasons[n] + ')</button>';
  });
  document.getElementById('chips').innerHTML = chips;
  document.getElementById('permnote').hidden = !reasons[PERM];

  var trunc = document.getElementById('trunc');
  trunc.hidden = !(list.shown < list.total);
  if(!trunc.hidden){
    // Said plainly, because the counts by reason are then counts of what is
    // listed and not of everything, and a summary that quietly means something
    // narrower than it says is worse than no summary.
    trunc.textContent = 'Listing the ' + list.shown + ' most recent of ' + list.total +
                        '. The counts by reason cover all of them.';
  }

  var q = document.getElementById('filter').value.trim().toLowerCase();
  var shown = files.filter(function(f){
    if(REASON && f.reason !== REASON) return false;
    // The name is the tail of the path, so matching the path alone covers both.
    if(q && String(f.path || '').toLowerCase().indexOf(q) < 0) return false;
    return true;
  });
  document.getElementById('rows').innerHTML = shown.map(function(f){
    return '<tr><td class="reason" title="' + esc(f.reason) + '">' + esc(pretty(f.reason)) +
           '</td><td>' + esc(f.name) + '</td><td class="path">' + esc(f.path) + '</td></tr>';
  }).join('');
  document.getElementById('empty').hidden = shown.length > 0;
}

function load(){
  var err = document.getElementById('err');
  // No poll loop. This changes only when the client rescans, which is minutes
  // apart at best, so asking every two seconds would buy nothing.
  return fetch('manage/skipped', {cache:'no-store'})
    .then(function(r){ return r.json(); })
    .then(function(j){ DATA = j; err.hidden = true; render(); })
    .catch(function(){ err.textContent = 'Could not read the skipped list.';
                       err.hidden = false; });
}

document.getElementById('refresh').addEventListener('click', load);
document.getElementById('filter').addEventListener('input', render);
document.getElementById('chips').addEventListener('click', function(e){
  var r = e.target.getAttribute && e.target.getAttribute('data-reason');
  if(r === null || r === undefined) return;
  REASON = r;
  render();
});
try {
  var t = localStorage.getItem('bbMonitorTheme');
  if(t) document.documentElement.setAttribute('data-theme', t);
} catch(e){}
load();
</script>
</body></html>
"""


def api_v1_payload(d):
    """The /api/v1/status contract.

    Built from the raw gather() dict rather than from the display payload, and
    deliberately field by field. Two reasons. The display payload is the web
    page's internal shape and would become a contract the moment it shipped, and
    it carries pre-formatted strings ("19.5 TB", "3 days") which are the wrong
    thing to hand a consumer that wants to graph a number or format for its own
    locale. Bytes are bytes and seconds are seconds here.

    Everything the monitor knows is here. What names a file is grouped under
    "files" so it can be withheld from a key without read:files; see
    strip_file_names().
    """
    b = d.get("backup") or {}
    act = d.get("activity") or {}
    sc = d.get("scan") or {}
    mem, swap = d.get("mem"), d.get("swap")
    us = d.get("upload_success")

    def gauge(t):
        if not t:
            return None
        used, total, pct = t
        return {"used_bytes": used, "total_bytes": total, "pct": round(pct, 2)}

    files = []
    for name, part, fsize, pct, parts in (d.get("files") or []):
        row = {"name": name, "pct": round(pct, 1),
               "size_bytes": fsize or None, "part_bytes": part or None}
        if parts:
            row["parts"] = {"done": parts[0], "total": parts[1]}
        files.append(row)

    recent = []
    for r in (d.get("recent") or []):
        row = {"name": r["name"], "time": r["t"], "chunked": bool(r["chunked"])}
        if r["chunked"]:
            row.update(parts={"done": min(r["done"], r["total"]), "total": r["total"]},
                       bytes=r["bytes"], seconds=max(0, r["last"] - r["first"]))
        elif r.get("small"):
            # Caught from the client naming it, not from a transfer record, so
            # there is no thread, size or rate to report.
            row.update(measured=False)
        else:
            row.update(thread=r["thr"], bytes=r["bytes"], seconds=r["secs"],
                       kbit_per_sec=r["kbit"], measured=True)
        recent.append(row)

    cm = d.get("chunkmap")
    return {
        "schema": bbapi.SCHEMA,
        "ok": True,
        "build": BUILD_LABEL,
        "time": int(time.time()),
        "poll_interval_seconds": INT,
        "state": d.get("state"),
        "paused": (d.get("pause") or {}).get("paused", False),
        "pause": d.get("pause"),
        "activity": {"phase": act.get("phase"), "file": act.get("file"),
                     "part": act.get("part"), "internal": act.get("internal")} if act else None,
        "threads": d.get("threads"),
        "rate_bytes_per_sec": int(d.get("rate", 0) * 1048576) if d.get("rate") else 0,
        "session_bytes": d.get("sess"),
        "chunks_last_minute": d.get("chunks"),
        "uptime_seconds": int(time.time() - bbdata.START_TIME),
        "memory": gauge(mem),
        "swap": gauge(swap),
        "backup": {"done_bytes": b.get("done"), "total_bytes": b.get("total"),
                   "pct": round(b["pct"], 2) if b.get("pct") is not None else None,
                   "done_files": b.get("done_files"), "total_files": b.get("total_files"),
                   "remaining_files": b.get("remaining_files"),
                   "eta_seconds": b.get("eta_seconds"),
                   # Seconds stay the contract; the date is added alongside so a
                   # consumer that only wants to print "when" need not reimplement
                   # the day-resolution rounding the monitor already applies.
                   "eta_date": bbdata.eta_date(b.get("eta_seconds")),
                   "eta_samples": b.get("eta_samples", 0)} if b else None,
        "scan": {"dirs_done": sc.get("dirs_done"), "dirs_total": sc.get("dirs_total"),
                 "pct": round(sc["pct"], 2) if sc.get("pct") is not None else None,
                 "files": sc.get("files"), "bytes": sc.get("bytes")} if sc else None,
        "health": [{"kind": k, "text": t} for k, t in (d.get("health") or [])],
        "skipped_files": d.get("skipped"),
        # The counts above say how many were given up on; this names them. It is
        # kept at the top level rather than under "files" because it is a
        # different question -- what is not backed up, rather than what is moving
        # -- but it names files just the same, so strip_file_names() drops it for
        # a key without read:files.
        "skipped_list": d.get("skipped_list"),
        "last_backup_days": d.get("last_backup_days"),
        "first_backup": d.get("first_backup"),
        "latency": {"ms": d.get("latency_ms"), "host": d.get("latency_host"),
                    "note": d.get("latency_note")},
        "upload_pod": d.get("upload_pod"),
        "compress_saved_bytes": d.get("compress_saved"),
        # Backblaze's own measurement, not ours.
        "client_measured_kbit": d.get("perf"),
        # "failures" kept for the schema promise; they are retried attempts,
        # not files. The reasons breakdown says so in the data itself.
        "uploads_today": ({"success": us[0], "failures": us[1],
                           "retried_attempts": us[1], "reasons": us[2]}
                          if us else None),
        # uploads_today is one row of this; both stay, because a consumer already
        # reading uploads_today must not have to change to keep working. "day" is
        # null on any row whose date the client did not record.
        "upload_history": d.get("upload_history"),
        # Present only while the first completion is recent, null the rest of the
        # time, so a consumer can treat its arrival as the event itself.
        "completion": d.get("completion"),
        # What the set is made of, from the client's own category totals. Counts
        # only: the client does not break its byte total down the same way, so a
        # per-category size would have to be invented rather than reported.
        "composition": d.get("composition"),
        # The date this backup began, YYYYMMDD, which is exactly the resolution
        # the client records it at. Not an epoch, because turning a calendar day
        # into a timestamp would have to pick a time of day that was never known.
        "backing_up_since": d.get("backing_up_since"),
        # Whether the ETA is improving or worsening against the last day
        # recorded, with the signed difference in seconds.
        "eta_trend": d.get("eta_trend"),
        "files": {
            "in_flight": files,
            "recent": recent,
            "chunk_map": ({"file": cm["file"], "total": cm["total"],
                           "sent": cm["sent"], "in_flight": cm["inflight"]}
                          if cm else None),
        },
    }


# What names a file the user is backing up. A key without read:files gets status
# without any of it: a dashboard tile showing rate, progress, memory and latency
# has no need for the name of every file on the array.
def strip_file_names(payload):
    out = dict(payload)
    out["files"] = None
    # Every entry in the skipped list is a full path on the source share, which
    # names the file just as plainly as the in-flight list does. The counts in
    # skipped_files stay: they say how much is not backed up without saying what.
    out["skipped_list"] = None
    act = out.get("activity")
    if act:
        act = dict(act)
        act["file"] = None
        out["activity"] = act
    return out


def _loop():
    prev = None
    while True:
        try:
            d = gather(prev)
            prev = d["_tx"]
            js = snapshot_to_json(d)
            # snapshot_to_json fills in latency and the pod, which gather() does
            # not carry, so the API payload is built from the enriched view.
            d.setdefault("latency_ms", js.get("latency_ms"))
            d.setdefault("latency_host", js.get("latency_host"))
            d.setdefault("latency_note", js.get("latency_note"))
            d.setdefault("upload_pod", js.get("upload_pod"))
            api = api_v1_payload(d)
        except Exception as e:
            js = {"ok": False, "error": str(e), "about": ABOUT}
            # schema is on every response, including this one: a consumer that
            # reads it first must not break precisely when collection fails.
            api = {"schema": bbapi.SCHEMA, "ok": False, "error": str(e)}
        with _lock:
            global _latest, _latest_api
            _latest = js
            _latest_api = api
        time.sleep(INT)


# ---- HTTP server -----------------------------------------------------------
