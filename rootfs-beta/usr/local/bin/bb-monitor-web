  buildStatToggles();
  document.getElementById('stat-toggles').addEventListener('change', function(e){
    var k = e.target.getAttribute && e.target.getAttribute('data-stat');
    if(!k) return;
    if(e.target.checked) delete statHidden[k]; else statHidden[k] = true;
    saveHidden();
