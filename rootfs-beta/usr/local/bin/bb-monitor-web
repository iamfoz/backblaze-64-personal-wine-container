  });
  [].slice.call(document.querySelectorAll('button.preset')).forEach(function(b){
    b.addEventListener('click', function(){ applyPreset(b.getAttribute('data-preset')); });
  });
  // Opened from the Settings tab, or from a link carrying ?settings=status.
  function openStatusSettings(){
    if(backdrop.hidden) document.getElementById('settings-btn').click();
    setTab('prefs');
    var box = document.getElementById('stat-toggles');
    if(box && box.scrollIntoView) try { box.scrollIntoView({block: 'nearest'}); } catch(e){}
  }
  window.addEventListener('message', function(e){
    if(e.origin !== location.origin) return;
    if(e.data && e.data.bb64 === 'open-settings' && e.data.section === 'status') openStatusSettings();
