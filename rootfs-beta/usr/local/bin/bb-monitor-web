class Handler(BaseHTTPRequestHandler):
    # HTTP/1.1 so a consumer polling every couple of seconds reuses one
    # connection instead of opening a fresh one each time. This is only safe
    # because every response here carries a Content-Length, including the
    # bodyless ones: without it a client waits for a body that never comes and
    # the reused connection desynchronises.
    protocol_version = "HTTP/1.1"

    # A keep-alive connection that goes quiet, or one that never sends a request
    # line at all, held a worker thread for as long as it liked. The events
    # stream writes a keep-alive every 15 seconds, so it stays well inside this.
    timeout = 30

    # Nothing this service accepts is large: the biggest body is a settings write
    # or a list of tool options. nginx bounds the proxied path at 1m; this bounds
    # anything reaching the loopback port directly.
    MAX_BODY = 1000000

    def log_message(self, fmt, *args):
        pass  # keep the container log quiet

    def _body_length(self):
        """The declared body length, or None after answering the request with
        the error that applies.

        A negative Content-Length makes rfile.read() block until the peer goes
        away, which on a keep-alive connection pins a thread for as long as the
        caller cares to hold it.
        """
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            # A header that does not parse is the caller's mistake, which is 400,
            # not a body that is too big.
            self._json(400, {"error": "malformed Content-Length"})
            return None
        if not 0 <= n <= self.MAX_BODY:
            self._json(413, {"error": "request body too large"})
            return None
        return n

    def _cors(self, path):
        """Echo the origin back when it is on the list. Never a wildcard, and
        never credentials: the API authenticates with a header, so a browser has
        no reason to send cookies and every reason not to be allowed to."""
        if not CORS_ORIGINS or not path.startswith("/api/v1/"):
            return
        origin = (self.headers.get("Origin") or "").rstrip("/")
        # Vary regardless of the outcome, so a cache cannot serve one origin's
        # allowed response to another origin.
        self.send_header("Vary", "Origin")
        if origin and origin in CORS_ORIGINS:
            self.send_header("Access-Control-Allow-Origin", origin)

    def do_OPTIONS(self):
        path = urlsplit(self.path).path
        # A preflight carries no Authorization header, so it is answered without
        # one. It reveals only that cross-origin access is configured.
        if not CORS_ORIGINS or not path.startswith("/api/v1/"):
            self.send_response(405)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        self.send_response(204)
        self._cors(path)
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type")
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _json(self, code, obj):
        payload = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self._cors(urlsplit(self.path).path)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def _api_route(self, method, path):
        """(scope, handler) for a v1 route, or (None, None).

        The scope is chosen here, per route, rather than assumed. A read key must
        not be able to stop a backup because both arrive on the same surface.
        """
        if method == "GET" and path == "/api/v1/status":
            return "read", self._api_status
        if method == "GET" and path == "/api/v1/key":
            # Any valid key, describing only itself. This is what stops a client
            # having to discover its own grants by collecting 401s, now that the
            # other endpoints tell a key nothing about what it does not hold.
            return None, self._api_key_self
        if method == "GET" and path == "/api/v1/control":
            # Only a key that holds some control, and it lists only that key's
            # own operations. A read-only key is not told what control exists.
            return tuple(bbapi.GROUPS["control"]), self._api_control_list
        if method == "POST" and path == "/api/v1/report":
            return "report", self._api_report_start
        if method == "GET" and path.startswith("/api/v1/report/") \
                and not path.startswith("/api/v1/report/download/"):
            return "report", lambda: self._api_report_status(
                path[len("/api/v1/report/"):])
        if method == "POST" and path.startswith("/api/v1/control/"):
            name = path[len("/api/v1/control/"):]
            # The segment selects a key in a fixed table. It is never used to
            # build an argument list, so a caller cannot reach --clear-pek by
            # spelling it in a URL.
            if name in bbctl.ACTIONS:
                return "control:" + name, lambda: self._api_control_run(name)
        if method == "GET" and path == "/api/v1/client":
            return "read", self._api_client
        if method == "POST" and path == "/api/v1/client":
            # Changing a setting is not a read and not a control action, so it
            # needed a permission of its own: "configure". It now exists in
            # bbapi.PERMISSIONS and bbapi.ORDER, added there rather than here,
            # since bbapi.py is not this file's to change. The guard stays even
            # though it is always true now, so a future bbapi.py that drops the
            # permission takes this route down with it rather than leaving it
            # live with nothing gating it. The GET stays on "read", which is
            # what it is.
            if "configure" in bbapi.PERMISSIONS:
                return "configure", self._api_client_set
        if method == "GET" and path == "/api/v1/summary":
            return "read", self._api_summary
        if method == "GET" and path == "/api/v1/metrics":
            return "read", self._api_metrics
        if method == "GET" and path == "/api/v1/events":
            return "read", self._api_events
        if method == "GET" and path == "/api/v1/openapi.json":
            # Any valid key: the document describes the surface, and a key
            # already proves the caller may know it exists.
            return None, self._api_openapi
        diag = bbapi.DIAGNOSE
        if method == "GET" and path == "/api/v1/tools":
            return diag, self._api_tools_list
        if method == "GET" and path.startswith("/api/v1/tools/job/"):
            return diag, lambda: self._api_tools_job(path[len("/api/v1/tools/job/"):])
        if method == "POST" and path.startswith("/api/v1/tools/"):
            name = path[len("/api/v1/tools/"):]
            if name in bbtools.TOOLS:
                return diag, lambda: self._api_tools_run(name)
        return None, None

    def _text(self, code, text, ctype="text/plain; charset=utf-8"):
        payload = text.encode("utf-8")
        self.send_response(code)
        self._cors(urlsplit(self.path).path)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def _api_summary(self):
        with _lock:
            api = _latest_api
        self._text(200, summary_text(api))

    def _api_metrics(self):
        with _lock:
            api = _latest_api
        self._text(200, metrics_text(api), "text/plain; version=0.0.4; charset=utf-8")

    OPENAPI = "/usr/local/share/bb-monitor/openapi.json"

    def _api_openapi(self):
        try:
            with open(self.OPENAPI, encoding="utf-8") as fh:
                doc = fh.read()
        except OSError:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no OpenAPI document in this image"})
            return
        self._text(200, doc, "application/json")

    def _api_events(self):
        """Server-sent events: one message per change to what a consumer watches,
        and a comment every fifteen seconds so the connection is known alive.
        Nothing here names a file, so it is a plain read."""
        self.send_response(200)
        self._cors(urlsplit(self.path).path)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        last_seq, last_sig, last_beat = -1, None, time.time()
        try:
            self.wfile.write(b": bb64 events\n\n")
            self.wfile.flush()
            while True:
                with _events_cv:
                    _events_cv.wait_for(lambda: _events_seq != last_seq, timeout=15)
                    last_seq = _events_seq
                with _lock:
                    api = _latest_api
                if not api.get("ok"):
                    sig = ("not-ok",)
                else:
                    sig = (api.get("state"), api.get("paused"),
                           tuple(sorted(h["kind"] for h in api.get("health") or [])),
                           (api.get("skipped_files") or {}).get("total"),
                           bool(api.get("completion")),
                           tuple(m["key"] for m in api.get("milestones") or []))
                now = time.time()
                if sig != last_sig:
                    last_sig = sig
                    data = {"time": int(now), "state": api.get("state"),
                            "paused": api.get("paused"), "pause_label": api.get("pause_label"),
                            "health": api.get("health"), "skipped_files": api.get("skipped_files"),
                            "completion": api.get("completion"), "milestones": api.get("milestones")}
                    self.wfile.write(("event: state\ndata: %s\n\n" % json.dumps(data)).encode("utf-8"))
                    last_beat = now
                elif now - last_beat >= 15:
                    self.wfile.write(b": keep-alive\n\n")
                    last_beat = now
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            return

    def _api_tools_list(self):
        self._json(200, {"schema": bbapi.SCHEMA, "build": BUILD_LABEL,
                         "can_repair": "diagnose:repair" in bbapi.perms(self._kid),
                         "tools": bbtools.describe()})

    def _withhold_tool_output(self, st):
        """A tool's output verbatim, or the job record without it.

        bb-doctor names directories on the user's share: the drives the client
        is set to back up, and the directories it is skipping. That is exactly
        what read:files gates on every other route, and "diagnose" is a
        permission for running a check, not for reading the array's contents.
        The state, the exit code and the verdict all survive, so a key issued to
        watch that a check passed still works.
        """
        if "read:files" in bbapi.perms(self._kid):
            return st
        out = dict(st)
        out["lines"] = None
        out["withheld"] = "read:files"
        return out

    def _api_tools_job(self, jid):
        st = bbtools.status(jid)
        if st is None:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no such job"})
            return
        st = self._withhold_tool_output(st)
        st["schema"] = bbapi.SCHEMA
        self._json(200, st)

    def _api_tools_run(self, name):
        if not bbtools.available(name):
            self._json(503, {"schema": bbapi.SCHEMA, "error": "%s is not present in this image" % name})
            return
        n = self._body_length()
        if n is None:
            return
        try:
            body = json.loads(self.rfile.read(n) or "{}") if n else {}
        except (ValueError, OSError):
            self._json(400, {"schema": bbapi.SCHEMA, "error": "bad request body"})
            return
        opts = body.get("options") or []
        if not isinstance(opts, list) or not all(isinstance(o, str) for o in opts):
            self._json(400, {"schema": bbapi.SCHEMA, "error": "options must be a list of option names"})
            return
        # Checks need diagnose; anything that changes files needs the repair
        # permission as well, so a key issued to look cannot be used to change.
        if bbtools.mutating(name, opts) and "diagnose:repair" not in bbapi.perms(self._kid):
            self._json(403, {"schema": bbapi.SCHEMA, "error": "diagnose:repair is required for that option"})
            return
        try:
            jid, joined = bbtools.start(name, opts)
        except ValueError as exc:
            self._json(400, {"schema": bbapi.SCHEMA, "error": str(exc)})
            return
        st = bbtools.status(jid) or {"id": jid, "state": "running"}
        sys.stderr.write("bb-monitor-web: key %s %s job %s: %s\n"
                         % (self._kid, "joined" if joined else "started", jid, st.get("command", name)))
        # Joining a run that has already finished hands back its output in this
        # very reply, so the same gate applies here as on the job route.
        st = self._withhold_tool_output(st)
        st["schema"] = bbapi.SCHEMA
        st["joined_existing"] = joined
        self._json(202, st)

    def _api_status(self):
        with _lock:
            payload = _latest_api
        if "read:files" not in bbapi.perms(self._kid):
            payload = strip_file_names(payload)
        # ?fields=rate_bytes_per_sec,paused trims the payload to what a consumer
        # actually wants, plus schema and ok, which every response carries so a
        # filtered reply is still recognisably the same contract. Unknown names
        # are ignored rather than erroring: a consumer built against a newer
        # container should not break on an older one that lacks a field.
        q = urlsplit(self.path).query
        m = re.search(r'(?:^|&)fields=([^&]*)', q)
        if m:
            want = {f.strip() for f in m.group(1).split(",") if f.strip()}
            if want:
                want |= {"schema", "ok", "error"}
                payload = {k: v for k, v in payload.items() if k in want}
        self._json(200, payload)

    def _api_client(self):
        if not bbconfig.available():
            self._json(503, {"schema": bbapi.SCHEMA,
                             "error": "bzcli is not present in this image"})
            return
        client = client_reading()
        if client and "read:files" not in bbapi.perms(self._kid):
            client = strip_client_dirs(client)
        self._json(200, {"schema": bbapi.SCHEMA, "ok": True, "client": client,
                         "settings": bbconfig.describe(),
                         "writable": "configure" in bbapi.perms(self._kid)})

    def _api_client_set(self):
        if not bbconfig.available():
            self._json(503, {"schema": bbapi.SCHEMA,
                             "error": "bzcli is not present in this image"})
            return
        n = self._body_length()
        if n is None:
            return
        try:
            body = json.loads(self.rfile.read(n) or "{}") if n else {}
        except (ValueError, OSError):
            self._json(400, {"schema": bbapi.SCHEMA, "error": "bad request body"})
            return
        key = str(body.get("key") or "").strip()
        try:
            ok, detail = bbconfig.write(key, body.get("value"))
        except ValueError as exc:
            # Every refusal comes from bbconfig's own whitelist and validators, so
            # a key that is not writable and a value out of range read the same
            # way here as they do on the settings page.
            self._json(400, {"schema": bbapi.SCHEMA, "error": str(exc)})
            return
        sys.stderr.write("bb-monitor-web: key %s set %s=%s: %s\n"
                         % (self._kid, key, body.get("value"),
                            "ok" if ok else "failed, " + detail))
        if not ok:
            self._json(502, {"schema": bbapi.SCHEMA, "key": key, "ok": False,
                             "error": detail})
            return
        self._json(200, {"schema": bbapi.SCHEMA, "key": key, "ok": True,
                         "value": ((bbconfig.cached() or {}).get("settings") or {}).get(key),
                         "detail": detail})

    def _api_report_start(self):
        if not bbreport.available():
            self._json(503, {"schema": bbapi.SCHEMA, "error": "bb-report is not present"})
            return
        jid, joined = bbreport.start()
        sys.stderr.write("bb-monitor-web: key %s %s report job %s\n"
                         % (self._kid, "joined" if joined else "started", jid))
        st = bbreport.status(jid) or {"job": jid, "state": "running"}
        st["schema"] = bbapi.SCHEMA
        st["joined_existing"] = joined
        self._json(202, st)

    def _api_report_status(self, jid):
        st = bbreport.status(jid)
        if st is None:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no such job"})
            return
        st["schema"] = bbapi.SCHEMA
        self._json(200, st)

    def _serve_report(self, token):
        """The token is the credential here, so no bearer is required: this is the
        URL a browser follows, and a key in a URL ends up in history and logs."""
        path = bbreport.claim(token)
        if not path:
            self._json(404, {"schema": bbapi.SCHEMA,
                             "error": "link unknown, expired or already used"})
            return
        self._stream_zip(path)

    def _stream_zip(self, path):
        started, size, sent = False, 0, 0
        try:
            size = os.path.getsize(path)
            with open(path, "rb") as fh:
                self.send_response(200)
                self._cors(urlsplit(self.path).path)
                self.send_header("Content-Type", "application/zip")
                self.send_header("Content-Length", str(size))
                self.send_header("Content-Disposition",
                                 'attachment; filename="%s"' % os.path.basename(path))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                started = True
                while True:
                    chunk = fh.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    sent += len(chunk)
        except OSError as exc:
            sys.stderr.write("bb-monitor-web: report download failed: %s\n" % exc)
            if not started:
                # The bundle went between the claim and the read, most likely
                # deleted in another tab. The request still needs an answer:
                # with nothing written the connection is reused for a reply that
                # never comes, and the browser waits until it gives up.
                self._json(404, {"schema": bbapi.SCHEMA,
                                 "error": "the bundle is no longer there"})
                return
        if started and sent != size:
            # Content-Length promised bytes that did not arrive, so this
            # connection cannot carry another request.
            self.close_connection = True

    def _api_key_self(self):
        held = bbapi.perms(self._kid)
        self._json(200, {"schema": bbapi.SCHEMA, "id": self._kid,
                         "permissions": sorted(held)})

    def _api_control_list(self):
        held = set(bbapi.perms(self._kid))
        self._json(200, {"schema": bbapi.SCHEMA,
                         "available": bbctl.available(),
                         "actions": [{"name": n, "does": d}
                                     for n, (_, d) in sorted(bbctl.ACTIONS.items())
                                     if ("control:" + n) in held]})

    def _api_control_run(self, name):
        if not bbctl.available():
            self._json(503, {"schema": bbapi.SCHEMA, "error": "bzcli is not present"})
            return
        ok, msg = bbctl.run(name)
        # Anything that changes the system is recorded with the key that asked for
        # it. The public id only, never the secret. Reads are not logged: they are
        # constant and would bury this.
        sys.stderr.write("bb-monitor-web: key %s ran %s: %s\n"
                         % (self._kid, name, "ok" if ok else "failed, " + msg))
        self._json(200 if ok else 502,
                   {"schema": bbapi.SCHEMA, "action": name, "ok": ok, "detail": msg})

    def _api_v1(self, method, path):
        """Returns True when the request was handled here."""
        if not path.startswith("/api/v1/") and path != "/api/v1":
            return False
        # No key means the surface does not exist, so say so rather than 403.
        # A 403 would confirm the endpoint is here; with no key there is nothing
        # to confirm, and every fresh container would be advertising it.
        if not bbapi.live():
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True
        # Below that gate and above the key check. The single-use token in the
        # path is what authorises this one, which is the whole point of issuing
        # it, but a token can only exist if a key existed to start the job, so
        # nothing is lost by letting the "no key, no surface" answer come first.
        # Above it, this route's JSON 404 told a keyless container apart from
        # any other by its shape.
        if method == "GET" and path.startswith("/api/v1/report/download/"):
            self._serve_report(path[len("/api/v1/report/download/"):])
            return True
        need, handler = self._api_route(method, path)
        auth = self.headers.get("Authorization", "")
        presented = auth[7:] if auth[:7].lower() == "bearer " else ""
        # An unknown path is still authenticated first, so that the set of
        # endpoints is not enumerable without a key. Any valid key is enough to
        # be told 404, since that reveals nothing about what exists.
        ok, kid = bbapi.verify(presented, need if handler else None)
        if not ok:
            # The public id only, never the secret, and only when one parsed.
            sys.stderr.write("bb-monitor-web: api/v1 auth failed%s\n"
                             % (" for key %s" % kid if kid else ""))
            self.send_response(401)
            self.send_header("WWW-Authenticate", 'Bearer realm="bb64"')
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True
        bbapi.touch(kid)
        self._kid = kid
        if handler is None:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no such endpoint"})
        else:
            handler()
        return True

    def _guard(self):
        """Same-origin check for the management calls.

        These sit behind nginx's auth_request, so the browser session is what
        authorises them, and a browser session is exactly what a cross-site POST
        can borrow. Requiring a header the form sets forces a CORS preflight on
        anything cross-origin, which a plain form post cannot satisfy.
        """
        if self.headers.get("X-Requested-With") != "bb64":
            self.send_response(403)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return False
        return True

    def _manage_get(self, path):
        if path == "/manage/keys":
            self._json(200, {
                "schema": bbapi.SCHEMA, "keys": bbapi.listing(),
                "enabled": bbapi.live(), "switch": bbapi.enabled(),
                "has_keys": bool(bbapi.active()),
                "permissions": [{"name": n, "does": bbapi.PERMISSIONS[n],
                                 # A colon does not make a group. read:files is
                                 # its own permission and belongs at the top
                                 # level; only names in GROUPS get a box.
                                 "group": (n.split(":")[0]
                                           if n.split(":")[0] in bbapi.GROUPS else None),
                                 "reserved": n in bbapi.RESERVED}
                                for n in bbapi.ORDER],
                "groups": {g: list(m) for g, m in bbapi.GROUPS.items()}})
            return True
        if path == "/manage/tools":
            self._json(200, {"schema": bbapi.SCHEMA, "build": BUILD_LABEL,
                             "tools": bbtools.describe()})
            return True
        if path == "/manage/notify":
            self._json(200, dict(bbnotify.public(bbnotify.load()), schema=bbapi.SCHEMA))
            return True
        if path == "/manage/quiet":
            conf = bbquiet.load()
            self._json(200, {"schema": bbapi.SCHEMA, "config": conf,
                             "state": _quiet.state(conf), "days": list(bbquiet.DAYS)})
            return True
        if path == "/manage/notices":
            # What has been dismissed, for the Settings tab's list. The Status
            # tab does not need this route: every notice it draws already
            # carries its own dismissed flag in the status payload.
            self._json(200, {"schema": bbapi.SCHEMA, "dismissed": bbdismiss.listing()})
            return True
        if path == "/manage/client":
            # The reading and the writable settings in one answer, because the
            # settings section needs both to draw a single row, and the live
            # per-thread ceiling with them: the thread count means little without
            # the figure that says whether another thread would carry anything.
            with _lock:
                limits = _latest.get("rate_limits")
            self._json(200, {"schema": bbapi.SCHEMA,
                             "available": bbconfig.available(),
                             "client": client_reading(),
                             "settings": bbconfig.describe() if bbconfig.available() else [],
                             "rate_limits": limits})
            return True
        if path == "/manage/timeline":
            self._json(200, {"schema": bbapi.SCHEMA, "timeline": timeline()})
            return True
        if path == "/manage/summary":
            with _lock:
                api = _latest_api
            payload = summary_text(api).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return True
        if path.startswith("/manage/tools/job/"):
            st = bbtools.status(path[len("/manage/tools/job/"):])
            if st is None:
                self._json(404, {"error": "no such job"})
            else:
                st["schema"] = bbapi.SCHEMA
                self._json(200, st)
            return True
        if path == "/manage/report":
            self._json(200, {"schema": bbapi.SCHEMA, "available": bbreport.available(),
                             "bundles": bbreport.listing(), "running": bbreport.current()})
            return True
        if path.startswith("/manage/report/job/"):
            st = bbreport.status(path[len("/manage/report/job/"):])
            if st is None:
                self._json(404, {"error": "no such job"})
            else:
                st["schema"] = bbapi.SCHEMA
                self._json(200, st)
            return True
        if path.startswith("/manage/report/download/"):
            # By name, for the browser session that is already logged in. The
            # single-use token flow stays on /api/v1/, where there is no session
            # and the token is the credential. path_for() admits only names that
            # match the bundle pattern, so nothing outside the store is reachable.
            p = bbreport.path_for(path[len("/manage/report/download/"):])
            if not p:
                self._json(404, {"error": "no such bundle"})
            else:
                self._stream_zip(p)
            return True
        if path in ("/manage/status", "/manage/skipped"):
            # Served from the cached display snapshot, the same one /api/status
            # hands out, so the page costs nothing beyond a dictionary lookup and
            # never re-reads Backblaze's report file itself. Read under the lock
            # because the collector thread rebinds _latest wholesale. The old
            # /manage/skipped name answers the same, for anything that kept it.
            with _lock:
                snap = _latest
            self._json(200, {"schema": bbapi.SCHEMA,
                             "ok": snap.get("ok", False), "error": snap.get("error"),
                             "state": snap.get("state"), "clock": snap.get("clock"),
                             "build": snap.get("build_label"),
                             "health": snap.get("health") or [],
                             # The Status tab draws the encryption, cluster and
                             # per-drive panel from this, so it travels with the
                             # rest rather than costing the page a second fetch.
                             "client": snap.get("client"),
                             "paused": snap.get("paused", False),
                             "completion": snap.get("completion"),
                             "first_backup": snap.get("first_backup"),
                             "last_backup_days": snap.get("last_backup_days"),
                             "skipped": snap.get("skipped"),
                             "list": snap.get("skipped_list"),
                             "pause_label": snap.get("pause_label"),
                             "milestones": snap.get("milestones"),
                             "quiet": _quiet.state(),
                             "timeline": timeline()})
            return True
        return False

    def do_POST(self):
        path = urlsplit(self.path).path
        # Key auth, so no same-origin guard here: that guard exists for /manage/,
        # which rides the browser session a cross-site post could borrow.
        if self._api_v1("POST", path):
            return
        if not path.startswith("/manage/"):
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        if not self._guard():
            return
        n = self._body_length()
        if n is None:
            return
        try:
            body = json.loads(self.rfile.read(n) or "{}") if n else {}
        except (ValueError, OSError):
            self._json(400, {"error": "bad request body"})
            return

        if path.startswith("/manage/tools/clear/"):
            # Before the run route, which would otherwise read "clear/<name>" as
            # a tool name and answer 404.
            name = path[len("/manage/tools/clear/"):]
            if name not in bbtools.TOOLS:
                self._json(404, {"error": "no such tool"})
                return
            self._json(200, {"schema": bbapi.SCHEMA, "cleared": bbtools.clear(name)})
            return
        if path.startswith("/manage/tools/"):
            # The page's Run button. A tool is named by path and its options by
            # key; both are looked up in bbtools.TOOLS, and nothing else from the
            # request reaches the argument list.
            name = path[len("/manage/tools/"):]
            if name not in bbtools.TOOLS:
                self._json(404, {"error": "no such tool"})
                return
            if not bbtools.available(name):
                self._json(503, {"error": "%s is not present in this image" % name})
                return
            opts = body.get("options") or []
            if not isinstance(opts, list) or not all(isinstance(o, str) for o in opts):
                self._json(400, {"error": "options must be a list of option names"})
                return
            try:
                jid, joined = bbtools.start(name, opts)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            st = bbtools.status(jid) or {"id": jid, "state": "running"}
            # Every run is logged with the command, so a changed prefix or a
            # cleared lock has a line in the container log that explains it.
            sys.stderr.write("bb-monitor-web: web session %s job %s: %s\n"
                             % ("joined" if joined else "started", jid,
                                st.get("command", name)))
            st["schema"] = bbapi.SCHEMA
            st["joined_existing"] = joined
            self._json(202, st)
            return
        if path == "/manage/report":
            if not bbreport.available():
                self._json(503, {"error": "bb-report is not present in this image"})
                return
            jid, joined = bbreport.start()
            sys.stderr.write("bb-monitor-web: web session %s report job %s\n"
                             % ("joined" if joined else "started", jid))
            st = bbreport.status(jid) or {"job": jid, "state": "running"}
            st["schema"] = bbapi.SCHEMA
            st["joined_existing"] = joined
            self._json(202, st)
            return
        if path == "/manage/report/delete":
            name = (body.get("name") or "").strip()
            if bbreport.delete(name):
                sys.stderr.write("bb-monitor-web: web session deleted bundle %s\n" % name)
                self._json(200, {"schema": bbapi.SCHEMA, "deleted": name,
                                 "bundles": bbreport.listing()})
            else:
                self._json(404, {"error": "no such bundle"})
            return
        if path.startswith("/manage/control/"):
            # The page's own pause button. Session-authorised like the rest of
            # /manage/ (auth_request plus the same-origin guard), so no API key
            # is needed to use the page you are already logged into. The action
            # name selects from the same fixed whitelist the API uses; nothing
            # from the request reaches an argument list.
            name = path[len("/manage/control/"):]
            if name not in bbctl.ACTIONS:
                self._json(404, {"error": "no such action"})
                return
            if not bbctl.available():
                self._json(503, {"error": "bzcli is not present"})
                return
            ok, msg = bbctl.run(name)
            sys.stderr.write("bb-monitor-web: web session ran %s: %s\n"
                             % (name, "ok" if ok else "failed, " + msg))
            self._json(200 if ok else 502, {"action": name, "ok": ok, "detail": msg})
            return
        if path == "/manage/client":
            # One setting at a time. The key is looked up in bbconfig.WRITABLE and
            # the value goes through that key's own validator, so nothing from the
            # request reaches an argument list unchecked, and a key that is not on
            # the list cannot be written however it is spelt.
            if not bbconfig.available():
                self._json(503, {"error": "bzcli is not present in this image"})
                return
            key = str(body.get("key") or "").strip()
            try:
                ok, detail = bbconfig.write(key, body.get("value"))
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            # Logged like the tools and control routes: a changed thread count or
            # throttle should have a line in the container log that explains it.
            sys.stderr.write("bb-monitor-web: web session set %s=%s: %s\n"
                             % (key, body.get("value"),
                                "ok" if ok else "failed, " + detail))
            if not ok:
                self._json(502, {"error": detail})
                return
            self._json(200, {"schema": bbapi.SCHEMA, "key": key, "detail": detail,
                             "value": ((bbconfig.cached() or {}).get("settings") or {}).get(key),
                             "settings": bbconfig.describe()})
            return
        if path == "/manage/keys/enabled":
            on = bbapi.set_enabled(bool(body.get("enabled")))
            sys.stderr.write("bb-monitor-web: web session switched the API %s\n" % ("on" if on else "off"))
            self._json(200, {"schema": bbapi.SCHEMA, "switch": on, "enabled": bbapi.live(),
                             "has_keys": bool(bbapi.active())})
            return
        if path == "/manage/keys/delete":
            kid = (body.get("id") or "").strip()
            if bbapi.delete(kid):
                self._json(200, {"schema": bbapi.SCHEMA, "deleted": kid})
            else:
                self._json(409, {"error": "only a revoked or expired key can be deleted"})
            return
        if path == "/manage/notify":
            try:
                conf = bbnotify.save(body)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            self._json(200, dict(bbnotify.public(conf), schema=bbapi.SCHEMA))
            return
        if path == "/manage/notify/test":
            ok, detail = bbnotify.test((body.get("id") or "").strip())
            # The remote's own answer does not come back out of here. A test is
            # synchronous, so handing back "HTTP 403" for one URL and
            # "Connection refused" for another turned this route into a probe
            # for whatever the container can reach. The real reason goes to the
            # container log, which is where someone debugging their own endpoint
            # already looks for the delivery lines.
            sys.stderr.write("bb-monitor-web: notification test: %s\n" % detail)
            self._json(200 if ok else 502,
                       {"schema": bbapi.SCHEMA, "ok": ok,
                        "detail": "delivered" if ok else "not delivered"})
            return
        if path == "/manage/quiet":
            try:
                conf = bbquiet.save(body)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            self._json(200, {"schema": bbapi.SCHEMA, "config": conf, "state": _quiet.state(conf)})
            return
        if path == "/manage/notices/dismiss":
            # The key is checked in bbdismiss against a pattern that admits a
            # bare kind or one drive and nothing else, so nothing from the
            # request reaches a file name however it is spelt. The text is
            # stored only so the Settings list can say what was dismissed.
            try:
                bbdismiss.dismiss(str(body.get("key") or ""), str(body.get("text") or ""))
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            self._json(200, {"schema": bbapi.SCHEMA, "ok": True,
                             "dismissed": bbdismiss.listing()})
            return
        if path == "/manage/notices/reset":
            bbdismiss.reset()
            self._json(200, {"schema": bbapi.SCHEMA, "ok": True,
                             "dismissed": bbdismiss.listing()})
            return
        if path == "/manage/keys":
            label = (body.get("label") or "").strip()
            scopes = body.get("scopes") or []
            if not label:
                self._json(400, {"error": "a label is required"})
                return
            exp = body.get("expires_days")
            try:
                rec, secret = bbapi.create(label, scopes,
                                           exp if exp not in (None, "", 0) else None)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            # The only time the secret leaves this process.
            self._json(200, {"schema": bbapi.SCHEMA, "key": rec, "secret": secret})
        elif path == "/manage/keys/revoke":
            kid = (body.get("id") or "").strip()
            if bbapi.revoke(kid):
                self._json(200, {"schema": bbapi.SCHEMA, "revoked": kid,
                                 "enabled": bbapi.live(), "switch": bbapi.enabled(),
                "has_keys": bool(bbapi.active())})
            else:
                self._json(404, {"error": "no active key with that id"})
        else:
            self._json(404, {"error": "no such endpoint"})

    def do_GET(self):
        path = urlsplit(self.path).path   # strip any ?query string before routing
        if self._api_v1("GET", path):
            return
        if self._manage_get(path):
            return
        if path == "/apikeys":
            payload = KEYS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/settings":
            payload = SETTINGS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/tools":
            payload = TOOLS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path in ("/status", "/skipped"):
            payload = STATUS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/api/status":
            with _lock:
                payload = json.dumps(_latest).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
        elif path in ("/", "/index.html"):
            payload = INDEX_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            # The one page that was left out. It is a static template today, but
            # a proxy holding a build behind for a container that has been
            # updated is a confusing thing to debug, and every sibling page says
            # not to cache it.
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
        else:
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dump-rtt", action="store_true",
                     help="Print what the kernel reports for the live upload "
                          "connections, then exit. For checking the netlink read "
                          "inside the container without going through the UI.")
    ap.add_argument("--port", type=int, default=8099)
    # Loopback by default: nginx fronts this, and binding 0.0.0.0 would put
    # the names of every backed-up file on the LAN with no authentication.
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    if args.dump_rtt:
        uid = _threadpush_uid()
        print("threadpush uid:  %s" % (uid if uid else "none (nothing uploading)"))
        if hasattr(socket, "AF_NETLINK"):
            rows = []
            for fam in (socket.AF_INET, socket.AF_INET6):
                try:
                    rows += [(p, u, d, r) for p, u, d, r in _diag_dump(fam)]
                except OSError as e:
                    print("netlink dump failed for family %s: %s" % (fam, e))
            print("established TCP sockets reporting tcp_info: %d" % len(rows))
            for peer, u, dport, rtt in rows:
                mark = " <- upload" if (dport == 443 and str(u) == str(uid)) else ""
                print("  %-40s uid=%-6s dport=%-5d rtt=%.1f ms%s"
                      % (peer, u, dport, rtt / 1000.0, mark))
        else:
            print("no AF_NETLINK on this platform")
        ms, peer, note = _upload_rtt()
        print("reported: %s" % ("n/a (%s)" % note if ms is None
                                 else "%.1f ms via %s" % (ms, peer)))
        return

    threading.Thread(target=_loop, daemon=True).start()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    print("bb-monitor-web listening on http://%s:%d/" % (args.host, args.port))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
