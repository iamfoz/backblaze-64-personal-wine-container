      hw.style.display = 'block';
      // The band is the headline; the Status tab has the detail and what to do.
      hw.innerHTML = '<a href="/?tab=status" target="_top" title="Open the Status tab">' +
        d.health.map(function(h){ return esc(h.text); }).join(' &bull; ') + '</a>';
    } else { hw.style.display = 'none'; }
    var cw = document.getElementById('completion');
    if(d.completion){
      // days comes from the first-pass counter, which the client drops the
      // moment it catches up. If the mark was written after that point the
      // count is zero, and "in 0 days" would be worse than saying nothing.
      var span = d.completion.days > 0
        ? ' in ' + esc(d.completion.days) + ' day' + (d.completion.days === 1 ? '' : 's')
        : '';
