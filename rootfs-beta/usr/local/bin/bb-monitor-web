    <option value="90">In 90 days</option>
    <option value="365">In a year</option>
  </select>
  <p class="dim" style="margin:4px 0 12px">Leave this at Never unless the key is for a
  one-off.</p>
  <p class="dim" style="margin:4px 0 12px"><code>read</code> on its own is enough for a
  status display. Ticking a group selects everything in it.</p>
