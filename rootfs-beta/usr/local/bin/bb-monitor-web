  .ok{color:var(--good);} .warn{color:var(--warn);} .fail{color:var(--bad);font-weight:600;}
  .fixed{color:var(--good);font-weight:600;} .heading{color:var(--title);font-weight:600;}
  .note{color:var(--dim);} .rule{color:var(--dim);}
  /* bb-health's answer is a verdict, so it is shown in the card with a mark
     rather than in an output box: a tick, a warning sign or a cross, with the
     tool's own lines under it as the evidence. */
  .verdict{display:flex;gap:12px;align-items:flex-start;margin-top:10px;padding:10px 12px;
    background:var(--bg);border:1px solid var(--border);border-radius:4px;}
  /* display:flex would otherwise beat the hidden attribute and leave an empty
     bordered strip in the card, the same trap pre[hidden] guards against. */
  .verdict[hidden]{display:none;}
  .mark{font-size:22px;line-height:1;flex:0 0 auto;}
  .mark.ok{color:var(--good);} .mark.fail{color:var(--bad);} .mark.warn{color:var(--warn);}
  .mark.run{color:var(--dim);}
  .verdict strong{display:block;}
  .verdict .detail{white-space:pre-wrap;word-break:break-word;margin-top:4px;color:var(--dim);
    font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;}
  table{width:100%;border-collapse:collapse;margin-top:10px;}
  th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--border);
    font-size:13px;vertical-align:top;}
  th{color:var(--dim);font-weight:600;white-space:nowrap;}
  td.name{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;word-break:break-all;}
  td.act{white-space:nowrap;text-align:right;}
  td.act button, td.act a{margin-left:6px;}
  .err{color:var(--bad);margin-top:8px;}
  @media (max-width:560px){ table,thead,tbody,tr,th,td{display:block;}
    thead{display:none;} tr{border-bottom:1px solid var(--border);padding:6px 0;}
    th,td{border:none;padding:2px 0;white-space:normal;} td.act{text-align:left;} }
</style></head><body>

