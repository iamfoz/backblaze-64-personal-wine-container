<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
function when(ts){ return ts ? new Date(ts*1000).toLocaleString() : '\u2014'; }
function post(path, body){
  return fetch(path, {method:'POST', cache:'no-store',
    headers:{'Content-Type':'application/json','X-Requested-With':'bb64'},
    body: JSON.stringify(body||{})}).then(function(r){
      return r.json().then(function(j){ return {ok:r.ok, body:j}; }); });
}
function permRow(p){
  var dis = p.reserved ? ' disabled' : '';
  var note = p.reserved ? ' <span class="dim">(not yet available)</span>' : '';
  var pre = p.name === 'read' ? ' checked' : '';
  return '<label><input type="checkbox" class="perm" value="'+esc(p.name)+'"'+dis+pre+
         '><span><code>'+esc(p.name)+'</code>'+note+
         '<br><span class="dim">'+esc(p.does)+'</span></span></label>';
}
function syncGroups(){
  // A group box is ticked when every member is, and half-ticked when some are.
  [].slice.call(document.querySelectorAll('.groupall')).forEach(function(g){
    var members = [].slice.call(document.querySelectorAll(
      '.perm[value^="'+g.value+':"]:not(:disabled)'));
    var on = members.filter(function(m){ return m.checked; }).length;
    g.checked = members.length > 0 && on === members.length;
    g.indeterminate = on > 0 && on < members.length;
  });
  var all = [].slice.call(document.querySelectorAll('.perm:not(:disabled)'));
  var every = document.getElementById('all');
  var n = all.filter(function(m){ return m.checked; }).length;
  every.checked = n === all.length && all.length > 0;
  every.indeterminate = n > 0 && n < all.length;
}
function render(d){
  var on = d.enabled;
  var st = document.getElementById('state');
  st.textContent = on ? 'on' : 'off';
  st.className = 'state ' + (on ? 'on' : 'off');
  var sw = document.getElementById('switch');
  sw.checked = !!d.switch;
  sw.disabled = !d.has_keys;
  document.getElementById('state-note').textContent = !d.has_keys
    ? 'No keys, no API. Every path answers 404 until you make one. Revoke the last key and it switches off again.'
    : (d.switch ? 'On. Switch it off here to stop every path answering, without revoking a key.'
                : 'Switched off. The keys are kept; every path answers 404 until you switch it on again.');

  var box = document.getElementById('scopes');
  if(!box.dataset.built){
    var html = '<label class="everyone"><input type="checkbox" id="all">' +
               '<span><strong>Select all</strong></span></label>';
    var done = {};
    d.permissions.forEach(function(p){
      if(p.group && !done[p.group]){
        done[p.group] = 1;
        var members = (d.groups[p.group] || []);
        html += '<div class="group"><label class="grouphead">' +
                '<input type="checkbox" class="groupall" value="'+esc(p.group)+'">' +
                '<span><strong>'+esc(p.group)+'</strong> <span class="dim">(' +
                members.length + ')</span></span></label><div class="members">' +
                d.permissions.filter(function(q){ return q.group === p.group; })
                             .map(permRow).join('') + '</div></div>';
      } else if(!p.group){
        html += permRow(p);
      }
    });
    box.innerHTML = html;
    box.dataset.built = '1';
    box.addEventListener('change', function(e){
      var t = e.target;
      if(t.id === 'all' || t.classList.contains('groupall')){
        var sel = t.id === 'all' ? '.perm:not(:disabled)'
                                 : '.perm[value^="'+t.value+':"]:not(:disabled)';
        [].slice.call(document.querySelectorAll(sel)).forEach(function(m){
          m.checked = t.checked;
        });
      }
      syncGroups();
    });
    syncGroups();
  }

  var rows = document.getElementById('rows');
  rows.innerHTML = d.keys.map(function(k){
    return '<tr class="'+(k.state === 'active' ? '' : 'revoked')+'">' +
      '<td><code>'+esc(k.id)+'</code></td>' +
      '<td class="label">'+esc(k.label)+'</td>' +
      '<td>'+esc(k.scopes.join(', '))+'</td>' +
      '<td>'+when(k.created)+'</td>' +
      '<td>'+when(k.last_used)+'</td>' +
      '<td>'+(k.expires ? when(k.expires) : '<span class="dim">never</span>')+'</td>' +
      '<td>'+(k.state === 'active'
        ? '<button class="ghost" data-revoke="'+esc(k.id)+'">Revoke</button>'
        : '<span class="dim">'+esc(k.state)+'</span> <button class="ghost icon-btn" data-delete="'+esc(k.id)+'" data-state="'+esc(k.state)+'" title="Delete this key" aria-label="Delete this key">' +
          '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button>')+'</td></tr>';
  }).join('');
  document.getElementById('none').hidden = d.keys.length > 0;
}
function load(){
  return fetch('manage/keys', {cache:'no-store'}).then(function(r){ return r.json(); })
    .then(render);
}
document.getElementById('create').addEventListener('click', function(){
  var label = document.getElementById('label').value.trim();
  var scopes = [].slice.call(document.querySelectorAll('#scopes .perm:checked'))
                 .map(function(i){ return i.value; });
  var err = document.getElementById('err');
  err.hidden = true;
  var exp = document.getElementById('expiry').value;
  post('manage/keys', {label: label, scopes: scopes,
                       expires_days: exp ? Number(exp) : null}).then(function(res){
    if(!res.ok){ err.textContent = res.body.error || 'Could not create the key.';
                 err.hidden = false; return; }
    document.getElementById('secret').textContent = res.body.secret;
    document.getElementById('secretbox').hidden = false;
    document.getElementById('label').value = '';
    document.getElementById('expiry').value = '';
    return load();
  });
});
document.getElementById('copy').addEventListener('click', function(){
  var t = document.getElementById('secret').textContent;
  if(navigator.clipboard) navigator.clipboard.writeText(t);
  this.textContent = 'Copied';
});
document.getElementById('rows').addEventListener('click', function(e){
  // The click may land on the icon inside the button; find the button.
  var t = e.target && e.target.closest ? e.target.closest('button') : e.target;
  if(!t || !t.getAttribute) return;
  var id = t.getAttribute('data-revoke');
  if(id){
    if(!confirm('Revoke key ' + id + '? Anything using it stops working immediately.')) return;
    post('manage/keys/revoke', {id: id}).then(load);
    return;
  }
  id = t.getAttribute('data-delete');
  if(id){
    if(!confirm('Delete key ' + id + ' for good? It is already ' + t.getAttribute('data-state') + ', so nothing changes for anything using it; this only removes the row.')) return;
    post('manage/keys/delete', {id: id}).then(load);
  }
});
document.getElementById('switch').addEventListener('change', function(){
  var sw = this;
  post('manage/keys/enabled', {enabled: sw.checked}).then(function(res){
    if(!res.ok){ sw.checked = !sw.checked; }
    return load();
  });
});

// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '6' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var t = localStorage.getItem('bbMonitorTheme');
  if(t) document.documentElement.setAttribute('data-theme', t);
} catch(e){}
load();
</script>
</body></html>
"""


