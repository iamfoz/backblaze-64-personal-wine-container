# What the three plain pages add to the palettes: the page background carried
# onto html, so a centred body sits on its own colour rather than on the
# viewport's. The measure and the prose caps are set on body in each page.
PAGE_CSS = """  html{background:var(--bg);}
"""

# The key management page, framed by the API tab in the shell. Served from
# /apikeys, which is reached as /monitor/apikeys and so sits behind the same
# auth_request as the dashboard. Creating a key must never be reachable from the
# exempted /api/v1/ path, which is why the management calls live under /manage/.
KEYS_HTML = """<!doctype html>
<html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Backblaze 64 API</title>
<style>
""" + THEME_CSS + PAGE_CSS + """  *{box-sizing:border-box;}
  body{margin:0 auto;max-width:1132px;padding:16px;background:var(--bg);color:var(--text);
    font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    font-size:14px;line-height:1.5;}
  h1{font-size:18px;margin:0 0 4px;color:var(--title);}
  h2{font-size:14px;margin:20px 0 8px;color:var(--title);font-weight:600;}
  p{margin:0 0 12px;max-width:100ch;}
  .dim{color:var(--dim);}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:6px;
    padding:14px;margin-bottom:16px;}
  .state{display:inline-block;padding:2px 8px;border-radius:10px;font-size:12px;}
  .on{background:var(--good);color:#04101f;}
  .off{background:var(--dim);color:#04101f;}
  .row{display:flex;gap:14px;align-items:center;flex-wrap:wrap;}
  /* A switch rather than a button pair: it shows the current state and the
     other state in one control, and it reads the same on a phone. */
  .switch{display:inline-flex;gap:8px;align-items:center;font-size:13px;cursor:pointer;margin:0;}
  .switch input{appearance:none;-webkit-appearance:none;width:38px;height:20px;margin:0;border-radius:10px;
    background:var(--dim);position:relative;cursor:pointer;border:0;flex:0 0 auto;}
  .switch input:checked{background:var(--good);}
  .switch input::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;
    background:var(--bg);transition:left .15s;}
  .switch input:checked::after{left:20px;}
  .switch input:disabled{opacity:.4;cursor:default;}
  h3{font-size:13px;margin:16px 0 6px;color:var(--title);}
