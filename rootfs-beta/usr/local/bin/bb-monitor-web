<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
var HDR = {'X-Requested-With':'bb64', 'Content-Type':'application/json'};
function asJson(r){ return r.json().then(function(j){
  if(!r.ok) throw new Error(j && j.error ? j.error : ('HTTP ' + r.status)); return j; }); }
function get(url){ return fetch(url, {cache:'no-store'}).then(asJson); }
function post(url, body){ return fetch(url, {method:'POST', headers:HDR, cache:'no-store',
  body:JSON.stringify(body || {})}).then(asJson); }
function showErr(e){ var el = document.getElementById('err');
  el.textContent = String(e && e.message || e); el.hidden = false; }
function clearErr(){ document.getElementById('err').hidden = true; }

// The prefixes bb-doctor prints, and bb-health's three words. A line that
// matches none of them is shown plain, so a change of wording in a tool loses
// colour and nothing else.
function cls(line){
  if(line.indexOf('  [ ok ] ') === 0) return 'ok';
  if(line.indexOf('  [warn] ') === 0) return 'warn';
  if(line.indexOf('  [FAIL] ') === 0) return 'fail';
  if(line.indexOf('         -> fixed: ') === 0) return 'fixed';
  if(line.indexOf('         ') === 0) return 'note';
  if(line.indexOf('-----') === 0) return 'rule';
  if(line === 'OK') return 'ok';
  if(line.indexOf('HANG') === 0 || line.indexOf('WEDGE') === 0 || line.indexOf('FROZEN') === 0) return 'fail';
  if(line.length && line.charAt(0) !== ' ') return 'heading';
  return '';
}
function fmtBytes(n){ if(n == null) return ''; if(n < 1024) return n + ' B';
  if(n < 1048576) return (n/1024).toFixed(0) + ' KB'; return (n/1048576).toFixed(1) + ' MB'; }
function fmtWhen(epoch){ try { return new Date(epoch*1000).toLocaleString(); } catch(e){ return ''; } }
function stamp(){ var d = new Date(), p = function(n){ return (n < 10 ? '0' : '') + n; };
  return '' + d.getFullYear() + p(d.getMonth()+1) + p(d.getDate()) + p(d.getHours()) + p(d.getMinutes()); }

var TOOLS = {};   // name -> descriptor from manage/tools
var JOBS = {};    // name -> the job shown for that tool

function renderTool(t){
  var opts = t.options.map(function(o){
    return '<label class="opt"><input type="checkbox" id="opt-' + esc(t.name) + '-' + esc(o.key) +
           '" data-tool="' + esc(t.name) + '"' + (t.available ? '' : ' disabled') + '> <span><code>' +
           esc(o.flag) + '</code> ' + esc(o.label) + '<br><span class="dim">' + esc(o.does) +
           '</span></span></label>';
  }).join('');
  var n = esc(t.name);
  // Two shapes. A tool whose whole output is a verdict (bb-health) shows it in
  // the card with a mark. The others get an output box that can be hidden, and
  // Copy and Download for taking the text elsewhere. Both can be cleared.
  var buttons = t.inline
    ? '<button class="ghost" data-clear="' + n + '" hidden>Clear result</button>'
    : '<button class="ghost" data-copy="' + n + '" hidden>Copy</button>' +
      '<button class="ghost" data-dl="' + n + '" hidden>Download</button>' +
      '<button class="ghost" data-toggle="' + n + '" hidden>Hide output</button>' +
      '<button class="ghost" data-clear="' + n + '" hidden>Clear result</button>';
  var body = t.inline ? '<div class="verdict" id="v-' + n + '" hidden></div>'
                      : '<pre id="out-' + n + '" hidden></pre>';
  return '<div class="panel" id="t-' + n + '">' +
    '<h2>' + esc(t.label) + '</h2><p class="dim">' + esc(t.does) + '</p>' + opts +
    '<div class="row">' +
      '<button data-run="' + n + '"' + (t.available ? '' : ' disabled') + '>Run</button>' + buttons +
      '<span class="status" id="st-' + n + '">' + (t.available ? '' : 'not in this image') + '</span>' +
    '</div>' + body + '</div>';
}

var COLLAPSED = {};   // tool -> the user hid its output box

// The mark for a finished verdict: a tick when the tool exited clean, a cross
// when it reported a fault, a warning sign when it could not run at all.
function mark(j){
  if(j.state === 'running') return ['run', '&#8230;', 'running'];
  if(j.state === 'failed') return ['warn', '&#9888;', j.result || 'could not run'];
  if(j.exit_code === 0) return ['ok', '&#10003;', j.result];
  return ['fail', '&#10007;', j.result];
}

function renderInline(name, j){
  var v = document.getElementById('v-' + name);
  var m = mark(j), lines = j.lines || [];
  var head = lines.length ? lines[0] : (j.state === 'running' ? 'Checking' : m[2]);
  var rest = lines.slice(1).join('\\n').replace(/^\\s+|\\s+$/g, '');
  v.innerHTML = '<span class="mark ' + m[0] + '" aria-label="' + esc(m[2]) + '">' + m[1] + '</span>' +
    '<div><strong class="' + (m[0] === 'run' ? '' : m[0]) + '">' + esc(head) + '</strong>' +
    (rest ? '<div class="detail">' + esc(rest) + '</div>' : '') + '</div>';
  v.hidden = false;
}

function renderOut(name){
  var j = JOBS[name]; if(!j) return;
  var t = TOOLS[name] || {};
  var running = j.state === 'running';
  var box = document.getElementById('t-' + name);
  var has = !!(j.lines && j.lines.length);
  if(t.inline){
    renderInline(name, j);
  } else {
    var pre = document.getElementById('out-' + name);
    var follow = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 4;
    pre.innerHTML = (j.lines || []).map(function(l){
      var c = cls(l); return c ? '<span class="' + c + '">' + esc(l) + '</span>' : esc(l);
    }).join('\\n') + (j.truncated ? '\\n<span class="warn">[output truncated]</span>' : '');
    // A fresh run reopens a box the user had hidden; there is new output to see.
    if(running) COLLAPSED[name] = false;
    pre.hidden = !!COLLAPSED[name];
    if(!pre.hidden && (follow || running)) pre.scrollTop = pre.scrollHeight;
    var tg = box.querySelector('[data-toggle]');
    tg.hidden = !has;
    tg.textContent = COLLAPSED[name] ? 'Show output' : 'Hide output';
    box.querySelector('[data-copy]').hidden = running || !has;
    box.querySelector('[data-dl]').hidden = running || !has;
  }
  var st = document.getElementById('st-' + name);
  st.textContent = (running ? 'running, ' + j.elapsed + 's' : j.result + ', ' + j.elapsed + 's') +
                   (j.command && !t.inline ? '  (' + j.command + ')' : '');
  box.querySelector('[data-run]').disabled = running;
  box.querySelector('[data-clear]').hidden = running;
}

function toggleOut(name){
  COLLAPSED[name] = !COLLAPSED[name];
  renderOut(name);
}

// Drops the result from the page and from the service, so a reload does not
// bring it back. A run in progress is left to finish.
function clearOut(name){
  clearErr();
  post('manage/tools/clear/' + name, {}).then(function(){
    delete JOBS[name];
    var box = document.getElementById('t-' + name);
    var pre = document.getElementById('out-' + name), v = document.getElementById('v-' + name);
    if(pre){ pre.hidden = true; pre.innerHTML = ''; }
    if(v){ v.hidden = true; v.innerHTML = ''; }
    ['copy', 'dl', 'toggle', 'clear'].forEach(function(k){
      var b = box.querySelector('[data-' + k + ']'); if(b) b.hidden = true; });
    document.getElementById('st-' + name).textContent = '';
  }).catch(showErr);
}

function poll(name, jid){
  get('manage/tools/job/' + jid).then(function(st){
    JOBS[name] = st; renderOut(name);
    if(st.state === 'running') setTimeout(function(){ poll(name, jid); }, 1000);
  }).catch(showErr);
}

function run(name){
  var t = TOOLS[name]; if(!t) return;
  var opts = [], ask = null;
  t.options.forEach(function(o){
    var cb = document.getElementById('opt-' + name + '-' + o.key);
    if(cb && cb.checked){ opts.push(o.key); if(o.confirm) ask = o.confirm; }
  });
  // The confirmation is the option's own text, which names what can change.
  if(ask && !window.confirm(ask)) return;
  clearErr();
  post('manage/tools/' + name, {options: opts}).then(function(st){
    JOBS[name] = st; renderOut(name);
    if(st.state === 'running') setTimeout(function(){ poll(name, st.id); }, 1000);
  }).catch(showErr);
}

function outText(name){ var j = JOBS[name]; return j && j.lines ? j.lines.join('\\n') + '\\n' : ''; }
function copyOut(name){
  var txt = outText(name), st = document.getElementById('st-' + name);
  function done(){ var keep = st.textContent; st.textContent = 'copied'; setTimeout(function(){ st.textContent = keep; }, 1200); }
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done, function(){ fallback(); });
  } else { fallback(); }
  function fallback(){
    var ta = document.createElement('textarea'); ta.value = txt; ta.setAttribute('readonly', '');
    ta.style.position = 'fixed'; ta.style.left = '-1000px'; document.body.appendChild(ta);
    ta.select(); try { document.execCommand('copy'); done(); } catch(e){} document.body.removeChild(ta);
  }
}
function dlOut(name){
  var blob = new Blob([outText(name)], {type:'text/plain'});
  var a = document.createElement('a'); a.href = URL.createObjectURL(blob);
  a.download = (TOOLS[name] ? TOOLS[name].label : name) + '-' + stamp() + '.txt';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(a.href); }, 1000);
}

// ---- diagnostic bundles ----
function setRepStatus(st){
  var el = document.getElementById('rep-status'), btn = document.getElementById('rep-run');
  if(!st){ el.textContent = ''; btn.disabled = false; return; }
  if(st.state === 'running'){ el.textContent = 'building, ' + Math.max(0, Math.floor(Date.now()/1000 - st.started)) + 's'; btn.disabled = true; }
  else if(st.state === 'done'){ el.textContent = 'built ' + (st.name || ''); btn.disabled = false; }
  else { el.textContent = 'failed: ' + (st.error || 'unknown'); btn.disabled = false; }
}
function renderBundles(list){
  var rows = document.getElementById('rep-rows');
  document.getElementById('rep-table').hidden = !(list && list.length);
  document.getElementById('rep-none').hidden = !!(list && list.length);
  rows.innerHTML = (list || []).map(function(b){
    return '<tr><td class="name">' + esc(b.name) + '</td><td>' + esc(fmtBytes(b.size_bytes)) +
           '</td><td>' + esc(fmtWhen(b.modified)) + '</td><td class="act">' +
           '<a href="manage/report/download/' + encodeURIComponent(b.name) + '">Download</a>' +
           '<button class="ghost" data-del="' + esc(b.name) + '">Delete</button></td></tr>';
  }).join('');
}
function loadReport(){
  return get('manage/report').then(function(j){
    if(j.available === false){ document.getElementById('rep-run').disabled = true;
      document.getElementById('rep-status').textContent = 'not in this image'; }
    renderBundles(j.bundles);
    if(j.running) pollReport(j.running); else if(!j.running && document.getElementById('rep-run').disabled && j.available !== false) setRepStatus(null);
  }).catch(showErr);
}
function pollReport(jid){
  get('manage/report/job/' + jid).then(function(st){
    setRepStatus(st);
    if(st.state === 'running') setTimeout(function(){ pollReport(jid); }, 1500);
    else loadReport();
  }).catch(showErr);
}
function buildReport(){
  clearErr();
  post('manage/report', {}).then(function(st){
    setRepStatus(st);
    if(st.state === 'running') setTimeout(function(){ pollReport(st.job); }, 1500);
    else loadReport();
  }).catch(showErr);
}
function delBundle(name){
  if(!window.confirm('Delete ' + name + '? This cannot be undone.')) return;
  clearErr();
  post('manage/report/delete', {name: name}).then(function(j){ renderBundles(j.bundles); }).catch(showErr);
}

document.addEventListener('click', function(e){
  var t = e.target; if(!t || !t.getAttribute) return;
  if(t.getAttribute('data-run')) return run(t.getAttribute('data-run'));
  if(t.getAttribute('data-copy')) return copyOut(t.getAttribute('data-copy'));
  if(t.getAttribute('data-dl')) return dlOut(t.getAttribute('data-dl'));
  if(t.getAttribute('data-toggle')) return toggleOut(t.getAttribute('data-toggle'));
  if(t.getAttribute('data-clear')) return clearOut(t.getAttribute('data-clear'));
  if(t.getAttribute('data-del')) return delBundle(t.getAttribute('data-del'));
});
document.getElementById('rep-run').addEventListener('click', buildReport);
document.getElementById('rep-refresh').addEventListener('click', loadReport);

// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '6' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var th = localStorage.getItem('bbMonitorTheme');
  if(th) document.documentElement.setAttribute('data-theme', th);
} catch(e){}

get('manage/tools').then(function(j){
  document.getElementById('build').textContent = j.build ? 'Build ' + j.build : '';
  var box = document.getElementById('tools');
  box.innerHTML = j.tools.map(function(t){ TOOLS[t.name] = t; return renderTool(t); }).join('');
  // A run that is still going, or the last one finished, so a reload does not
  // lose what the tool said.
  j.tools.forEach(function(t){ if(t.running || t.last_job) poll(t.name, t.running || t.last_job); });
}).catch(showErr);
loadReport();
// A link from the Status tab can ask for a bundle straight away.
try { if(new URLSearchParams(location.search).get('run') === 'report') buildReport(); } catch(e){}
</script>
</body></html>
