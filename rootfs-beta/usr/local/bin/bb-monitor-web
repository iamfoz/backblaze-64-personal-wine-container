<h2>Quiet hours</h2>
<div class="panel" id="quiet">
  <p class="dim">Pause the backup on a schedule. At the start of a window the container asks the client
  to pause; at the end it starts the backup again. The client's own pause lasts about two hours, so
  inside a window the container renews it. If you start the backup yourself during a window, it stays
  running until that window ends. Times are in the container's time zone.</p>
  <div class="row">
    <label class="switch"><input type="checkbox" id="quiet-enabled"> <span>Quiet hours enabled</span></label>
    <span class="dim" id="quiet-state"></span>
  </div>
  <div id="windows"></div>
  <button class="ghost" id="win-add">Add window</button>
  <div class="row" style="margin-top:12px"><button id="quiet-save">Save quiet hours</button><span class="dim" id="quiet-msg"></span></div>
  <div id="quiet-err" class="err" hidden></div>
</div>

<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
function post(path, body){
  return fetch(path, {method:'POST', cache:'no-store',
    headers:{'Content-Type':'application/json','X-Requested-With':'bb64'},
    body: JSON.stringify(body||{})}).then(function(r){
      return r.json().then(function(j){ return {ok:r.ok, body:j}; }); });
}
// ---- the backup client ----
// The label and the description of every setting come from bbconfig, which took
// them from bzcli's own help text. Nothing here keeps its own list of settings:
// a key absent from that whitelist cannot be written, and does not appear.
var CLIENT = null;
// What the client's own help text does not say, and someone running it in this
// container needs to know. Beside the setting rather than in the text above,
// because each of these is about one setting and nothing else.
var CS_EXTRA = {
  net_throttle: 'Megabits per second per thread, not for the backup as a whole. It does nothing at all while the automatic throttle above is on.',
  num_backup_threads: 'A ceiling, not a target: the client opens as many as it has work for. Under Wine each thread is separately limited by the send buffer divided by the round trip, so raising this only helps while that per-thread limit is not already what is holding the rate down.'
};
// The throttle multiplied out. Worked from the reader's own two settings rather
// than from an example: a fixed illustration using someone else's numbers reads
// as a description of the reader's setup and is wrong for almost everyone.
// `rows` is the describe() list, not a map of values, so the two figures are
// looked up by key rather than read off an object.
function csValue(rows, key){
  if(!rows || !rows.length) return null;
  for(var i = 0; i < rows.length; i++) if(rows[i].key === key) return rows[i].value;
  return null;
}
function throttleTotal(rows){
  var per = Number(csValue(rows, 'net_throttle')), n = Number(csValue(rows, 'num_backup_threads'));
  if(!(per > 0) || !(n > 0)) return '';
  return ' At ' + per + ' Mbps across ' + n + ' thread' + (n === 1 ? '' : 's') +
         ', that is a ceiling of about ' + (per * n) + ' Mbps for the backup as a whole.';
}
function mbit(bytesPerSec){ return (bytesPerSec * 8 / 1e6).toFixed(1); }
// The live per-thread ceiling from the Monitor, so the thread count can be read
// against the thing that actually bounds a thread rather than on its own.
function perThreadNote(rl){
  if(!rl || rl.per_thread == null) return '';
  var line = 'Right now a thread is bounded at about ' + esc(mbit(rl.per_thread)) +
    ' Mbit/s by the send buffer and the round trip, so the threads in use model out at about ' +
    esc(mbit(rl.modelled)) + ' Mbit/s against ' + esc(mbit(rl.observed)) + ' Mbit/s measured.';
  if(rl.verdict === 'at') line += ' The rate is at that ceiling, so more threads should carry more.';
  else if(rl.verdict === 'below') line += ' The rate is below that ceiling, so something other than the thread count is holding it down and more threads are unlikely to help.';
  else if(rl.verdict === 'above') line += ' The rate is above that ceiling, so the model is understating what one thread can carry.';
  return line;
}
function csControl(s){
  if(s.type === 'bool'){
    return '<label class="switch"><input type="checkbox" class="cs-val"' +
      (s.value === true || String(s.value) === 'true' ? ' checked' : '') +
      '> <span>' + esc(s.label) + '</span></label>';
  }
  if(s.type === 'int'){
    return '<input type="number" class="cs-val" value="' + esc(s.value == null ? '' : s.value) + '">' +
      (s.unit ? ' <span class="dim">' + esc(s.unit) + '</span>' : '');
  }
  return '<input type="text" class="cs-val" value="' + esc(s.value == null ? '' : s.value) + '">';
}
function csRow(s, limits){
  var extra = CS_EXTRA[s.key] || '';
  if(s.key === 'num_backup_threads'){
    var pt = perThreadNote(limits);
    if(pt) extra += (extra ? ' ' : '') + pt;
  }
  if(s.key === 'net_throttle') extra += throttleTotal(CLIENT && CLIENT.settings);
  return '<div class="cs" data-key="' + esc(s.key) + '">' +
    '<div class="cs-name">' + esc(s.label) + '</div>' +
    '<p class="cs-does">' + esc(s.does) + '</p>' +
    (s.note ? '<p class="cs-note">' + esc(s.note) + '</p>' : '') +
    (extra ? '<p class="cs-note">' + extra + '</p>' : '') +
    '<div class="cs-acts">' + csControl(s) +
    '<button class="ghost cs-save">Save</button><span class="cs-msg"></span></div></div>';
}
function renderClient(d){
  CLIENT = d;
  var box = document.getElementById('client-settings');
  if(!d.available){
    box.innerHTML = '<p class="dim">There is no bzcli in this image, so the client cannot be read ' +
      'or changed from here.</p>';
    return;
  }
  var list = d.settings || [];
  var vals = (d.client && d.client.settings) || null;
  if(!list.length || !vals){
    box.innerHTML = '<p class="dim">The client has not been read yet. Each reading starts a Windows ' +
      'process under Wine, so the first one arrives a little after the monitor starts. Reload this ' +
      'page in a moment.</p>';
    return;
  }
  box.innerHTML = list.map(function(s){ return csRow(s, d.rate_limits); }).join('');
}
function loadClient(){
  var err = document.getElementById('client-err');
  return fetch('manage/client', {cache:'no-store'}).then(function(r){ return r.json(); })
    .then(function(j){ err.hidden = true; renderClient(j); })
    .catch(function(){ err.textContent = 'Could not read the client settings.'; err.hidden = false; });
}
document.getElementById('client-settings').addEventListener('click', function(e){
  var t = e.target;
  if(!t.classList || !t.classList.contains('cs-save')) return;
  var row = t.closest('.cs'), key = row.getAttribute('data-key');
  var el = row.querySelector('.cs-val');
  var val = el.type === 'checkbox' ? el.checked : el.value;
  var msg = row.querySelector('.cs-msg');
  msg.className = 'cs-msg'; msg.textContent = 'Saving.';
  t.disabled = true;
  post('manage/client', {key: key, value: val}).then(function(res){
    t.disabled = false;
    // A refusal says which rule it broke, in the validator's own words or the
    // client's, rather than a bare "could not save".
    if(!res.ok){ msg.className = 'cs-msg bad'; msg.textContent = res.body.error || 'Could not save.'; return; }
    msg.className = 'cs-msg good';
    msg.textContent = 'Saved. A restart may be needed before a running backup honours it.';
    // Show what the client now holds rather than what was typed: the two differ
    // if it stored something other than the figure that was sent.
    if(res.body.value != null){
      if(el.type === 'checkbox') el.checked = (res.body.value === true || String(res.body.value) === 'true');
      else el.value = res.body.value;
    }
  }, function(){
    t.disabled = false; msg.className = 'cs-msg bad'; msg.textContent = 'Could not save.';
  });
});

// ---- notifications ----
var NOTIFY = null;
var KINDS = [['ntfy', 'ntfy topic'], ['pushbullet', 'Pushbullet'], ['discord', 'Discord webhook'],
             ['slack', 'Slack webhook'], ['gotify', 'Gotify'], ['webhook', 'Webhook (JSON)'], ['custom', 'Custom JSON body']];
// What goes in the URL box for each kind, and which kinds want a token by default.
var URL_HINT = {ntfy: 'https://ntfy.sh/your-topic', pushbullet: 'https://api.pushbullet.com/v2/pushes',
                discord: 'https://discord.com/api/webhooks/...', slack: 'https://hooks.slack.com/services/...',
                gotify: 'https://gotify.example/message', webhook: 'https://your-receiver/hook', custom: 'https://your-receiver/hook'};
var AUTH_DEFAULT = {pushbullet: 'bearer', gotify: 'none'};
var AUTHS = [['none', 'No auth'], ['bearer', 'Bearer token'], ['basic', 'Basic auth']];
function opts(list, cur){ return list.map(function(o){ return '<option value="'+esc(o[0])+'"'+(o[0]===cur?' selected':'')+'>'+esc(o[1])+'</option>'; }).join(''); }
function epRow(e, i){
  return '<div class="ep" data-i="'+i+'">' +
    '<label class="f">Label<input type="text" class="ep-label" value="'+esc(e.label||'')+'" placeholder="Phone"></label>' +
    '<label class="f">Kind<select class="ep-kind">'+opts(KINDS, e.kind||'ntfy')+'</select></label>' +
    '<label class="f">URL<input type="text" class="ep-url" value="'+esc(e.url||'')+'" placeholder="https://ntfy.sh/your-topic"></label>' +
    '<label class="f">Auth<select class="ep-auth">'+opts(AUTHS, e.auth||'none')+'</select></label>' +
    '<label class="f">User (basic)<input type="text" class="ep-user" value="'+esc(e.user||'')+'"></label>' +
    '<label class="f">Token or password<input type="password" class="ep-token" value="" placeholder="'+(e.has_token ? 'set, leave blank to keep' : '')+'" autocomplete="new-password"></label>' +
    '<div class="acts"><button class="ghost ep-test" '+(e.id ? '' : 'disabled title="Save first"')+'>Test</button>' +
    '<button class="ghost ep-remove">Remove</button><input type="hidden" class="ep-id" value="'+esc(e.id||'')+'"></div>' +
    '<label class="f ep-tpl"' + ((e.kind||'ntfy') === 'custom' ? '' : ' hidden') + '>Body template, JSON. Placeholders: ' +
      '{title} {message} {event} {container} {build} {state} {time} {priority}' +
      '<textarea class="ep-template" rows="3" spellcheck="false">' + esc(e.template || '{"title": "{title}", "text": "{message}"}') + '</textarea></label>' +
    '<p class="dim ep-hint"></p>' + lastDelivery(e) + '</div>';
}
// The last delivery, so an endpoint that stopped working says so here rather
// than only in the container log.
function lastDelivery(e){
  var d = e.last_delivery;
  if(!d) return '<p class="dim ep-last">Nothing sent yet.</p>';
  var when = '';
  try { when = new Date(d.at*1000).toLocaleString(); } catch(err){}
  return '<p class="ep-last ' + (d.ok ? 'good' : 'bad') + '">' +
         (d.ok ? 'Delivered' : 'Failed') + ' \u2014 ' + esc(d.event) + ', ' + esc(when) +
         (d.detail ? ' (' + esc(d.detail) + ')' : '') + '</p>';
}
var KIND_HINT = {
  pushbullet: 'Auth: Bearer with your Pushbullet access token. Sent as a note with the event as its title.',
  gotify: 'Put the application token in the token box; it is sent as X-Gotify-Key. Priority 5 for a freeze or a stall, 3 otherwise.',
  discord: 'The webhook URL carries its own secret; leave auth at none.',
  slack: 'The incoming-webhook URL carries its own secret; leave auth at none.',
  ntfy: 'Title, priority and tag go in headers; the message is the body. Add a token if the topic is protected.',
  webhook: 'JSON with container, build, event, title, message, body, state and time. For Home Assistant or a script.',
  custom: 'Your own JSON body. Strings are escaped for you; {priority} and {time} are numbers.'
};
function applyKind(row){
  var kind = row.querySelector('.ep-kind').value;
  row.querySelector('.ep-url').placeholder = URL_HINT[kind] || '';
  row.querySelector('.ep-tpl').hidden = kind !== 'custom';
  row.querySelector('.ep-hint').textContent = KIND_HINT[kind] || '';
  if(AUTH_DEFAULT[kind] && !row.querySelector('.ep-id').value) row.querySelector('.ep-auth').value = AUTH_DEFAULT[kind];
  var url = row.querySelector('.ep-url');
  if(!url.value && kind === 'pushbullet') url.value = URL_HINT.pushbullet;
}
function renderNotify(d){
  NOTIFY = d;
  document.getElementById('endpoints').innerHTML = (d.endpoints||[]).map(epRow).join('') ||
    '<p class="dim">No endpoints yet.</p>';
  [].slice.call(document.querySelectorAll('#endpoints .ep')).forEach(applyKind);
  document.getElementById('events').innerHTML = (d.event_list||[]).map(function(ev){
    return '<label><input type="checkbox" class="ev-key" value="'+esc(ev.key)+'"'+(d.events[ev.key] ? ' checked' : '')+
           '><span><strong>'+esc(ev.label)+'</strong>'+(ev.clears ? ' <span class="dim">(and when it clears)</span>' : '')+
           '<br><span class="dim">'+esc(ev.does)+'</span></span></label>';
  }).join('');
  document.getElementById('skipped-threshold').value = d.skipped_threshold || 1;
}
function collectNotify(){
  var eps = [].slice.call(document.querySelectorAll('#endpoints .ep')).map(function(r){
    var g = function(c){ var el = r.querySelector(c); return el ? el.value : ''; };
    return {id: g('.ep-id'), label: g('.ep-label'), kind: g('.ep-kind'), url: g('.ep-url'),
            auth: g('.ep-auth'), user: g('.ep-user'), token: g('.ep-token'), template: g('.ep-template')};
  });
  var events = {};
  [].slice.call(document.querySelectorAll('.ev-key')).forEach(function(c){ events[c.value] = c.checked; });
  return {endpoints: eps, events: events, skipped_threshold: Number(document.getElementById('skipped-threshold').value || 1)};
}
function loadNotify(){
  return fetch('manage/notify', {cache:'no-store'}).then(function(r){ return r.json(); }).then(renderNotify);
}
document.getElementById('ep-add').addEventListener('click', function(){
  var box = document.getElementById('endpoints');
  if(box.querySelector('p')) box.innerHTML = '';
  box.insertAdjacentHTML('beforeend', epRow({kind:'ntfy', auth:'none'}, box.children.length));
  applyKind(box.lastElementChild);
});
document.getElementById('endpoints').addEventListener('change', function(e){
  if(e.target.classList && e.target.classList.contains('ep-kind')) applyKind(e.target.closest('.ep'));
});
document.getElementById('endpoints').addEventListener('click', function(e){
  var t = e.target; if(!t.classList) return;
  var row = t.closest('.ep');
  if(t.classList.contains('ep-remove')){ row.remove(); if(!document.querySelector('#endpoints .ep')) document.getElementById('endpoints').innerHTML = '<p class="dim">No endpoints yet.</p>'; }
  if(t.classList.contains('ep-test')){
    var id = row.querySelector('.ep-id').value; var msg = document.getElementById('notify-msg');
    msg.textContent = 'sending a test\u2026';
    post('manage/notify/test', {id: id}).then(function(res){
      // The route answers "delivered" or "not delivered" and nothing more, so
      // the reason for a failure is in the container log rather than here.
      msg.textContent = res.ok ? 'Test delivered.'
        : 'Test not delivered. The container log says what the endpoint answered.';
    });
  }
});
document.getElementById('notify-save').addEventListener('click', function(){
  var err = document.getElementById('notify-err'), msg = document.getElementById('notify-msg');
  err.hidden = true; msg.textContent = '';
  post('manage/notify', collectNotify()).then(function(res){
    if(!res.ok){ err.textContent = res.body.error || 'Could not save.'; err.hidden = false; return; }
    renderNotify(res.body); msg.textContent = 'Saved.'; setTimeout(function(){ msg.textContent = ''; }, 1500);
  });
});

// ---- quiet hours ----
var DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
function winRow(w){
  var days = DAYS.map(function(d, i){ return '<label><input type="checkbox" class="win-day" value="'+i+'"'+((w.days||[]).indexOf(i) >= 0 ? ' checked' : '')+'> '+d+'</label>'; }).join('');
  return '<div class="win"><div class="days">'+days+'</div>' +
    '<div class="acts"><label>from <input type="time" class="win-start" value="'+esc(w.start||'22:00')+'"></label>' +
    '<label>to <input type="time" class="win-end" value="'+esc(w.end||'07:00')+'"></label>' +
    '<button class="ghost win-remove">Remove</button></div></div>';
}
function quietStateText(st){
  if(!st) return '';
  if(st.in_window){
    var until = st.window_end ? new Date(st.window_end*1000).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '';
    if(st.override_until) return 'In a window until ' + until + '; started by hand, so left running until then.';
    return 'In a window until ' + until + (st.active ? '; paused by quiet hours.' : '.');
  }
  if(st.next_start) return 'Next window: ' + new Date(st.next_start*1000).toLocaleString([], {weekday:'short', hour:'2-digit', minute:'2-digit'}) + '.';
  return st.enabled ? 'No windows yet.' : '';
}
function renderQuiet(d){
  document.getElementById('quiet-enabled').checked = !!d.config.enabled;
  document.getElementById('windows').innerHTML = (d.config.windows||[]).map(winRow).join('') || '<p class="dim">No windows yet.</p>';
  document.getElementById('quiet-state').textContent = quietStateText(d.state);
}
function collectQuiet(){
  return {enabled: document.getElementById('quiet-enabled').checked,
          windows: [].slice.call(document.querySelectorAll('#windows .win')).map(function(r){
            return {days: [].slice.call(r.querySelectorAll('.win-day:checked')).map(function(c){ return Number(c.value); }),
                    start: r.querySelector('.win-start').value, end: r.querySelector('.win-end').value};
          })};
}
function loadQuiet(){
  return fetch('manage/quiet', {cache:'no-store'}).then(function(r){ return r.json(); }).then(renderQuiet);
}
document.getElementById('win-add').addEventListener('click', function(){
  var box = document.getElementById('windows');
  if(box.querySelector('p')) box.innerHTML = '';
  box.insertAdjacentHTML('beforeend', winRow({days:[0,1,2,3,4]}));
});
document.getElementById('windows').addEventListener('click', function(e){
  if(e.target.classList && e.target.classList.contains('win-remove')){
    e.target.closest('.win').remove();
    if(!document.querySelector('#windows .win')) document.getElementById('windows').innerHTML = '<p class="dim">No windows yet.</p>';
  }
});
// Ask the shell to show the Monitor and open its settings on the status panel.
// The Monitor's frame is loaded once and never re-pointed, so this travels as a
// message rather than as a URL: a query string would need the frame reloaded,
// which would drop its poll and its scroll position.
document.getElementById('to-monitor').addEventListener('click', function(){
  if(window.parent !== window) window.parent.postMessage({bb64: 'monitor-settings'}, location.origin);
  else window.location = '/monitor/?settings=status';
});
// ---- dismissed warnings ----
// The list is what was turned off and when, so the reset button is not a blind
// one: somebody coming back to a container weeks later can see what a previous
// self accepted before deciding to put it all back.
function renderNotices(d){
  var list = d.dismissed || [];
  document.getElementById('dismissed').innerHTML = list.length
    ? '<table><thead><tr><th>Warning</th><th>Key</th><th>Dismissed</th></tr></thead><tbody>' +
      list.map(function(n){
        var when = '';
        try { when = new Date(n.at*1000).toLocaleString(); } catch(e){}
        return '<tr><td class="label">' + esc(n.text || '(no wording recorded)') +
               '</td><td><code>' + esc(n.key) + '</code></td><td>' + esc(when) + '</td></tr>';
      }).join('') + '</tbody></table>'
    : '<p class="dim">Nothing dismissed.</p>';
}
function loadNotices(){
  return fetch('manage/notices', {cache:'no-store'}).then(function(r){ return r.json(); }).then(renderNotices);
}
document.getElementById('notices-reset').addEventListener('click', function(){
  var err = document.getElementById('notices-err'), msg = document.getElementById('notices-msg');
  err.hidden = true; msg.textContent = '';
  post('manage/notices/reset', {}).then(function(res){
    if(!res.ok){ err.textContent = res.body.error || 'Could not reset.'; err.hidden = false; return; }
    renderNotices(res.body); msg.textContent = 'Reset.'; setTimeout(function(){ msg.textContent = ''; }, 1500);
  });
});
document.getElementById('quiet-save').addEventListener('click', function(){
  var err = document.getElementById('quiet-err'), msg = document.getElementById('quiet-msg');
  err.hidden = true; msg.textContent = '';
  post('manage/quiet', collectQuiet()).then(function(res){
    if(!res.ok){ err.textContent = res.body.error || 'Could not save.'; err.hidden = false; return; }
    renderQuiet(res.body); msg.textContent = 'Saved.'; setTimeout(function(){ msg.textContent = ''; }, 1500);
  });
});
// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '6' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var t = localStorage.getItem('bbMonitorTheme');
  if(t) document.documentElement.setAttribute('data-theme', t);
} catch(e){}
loadClient();
loadNotify();
loadQuiet();
loadNotices();
setInterval(loadQuiet, 30000);
</script>
</body></html>
