var DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
function winRow(w){
  var days = DAYS.map(function(d, i){ return '<label><input type="checkbox" class="win-day" value="'+i+'"'+((w.days||[]).indexOf(i) >= 0 ? ' checked' : '')+'> '+d+'</label>'; }).join('');
  return '<div class="win"><div class="days">'+days+'</div>' +
    '<div class="acts"><label>from <input type="time" class="win-start" value="'+esc(w.start||'22:00')+'"></label>' +
    '<label>to <input type="time" class="win-end" value="'+esc(w.end||'07:00')+'"></label>' +
    '<button class="ghost win-remove">Remove</button></div></div>';
}
function quietStateText(st){
  if(!st) return '';
  if(st.in_window){
    var until = st.window_end ? new Date(st.window_end*1000).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '';
    if(st.override_until) return 'In a window until ' + until + '; started by hand, so left running until then.';
    return 'In a window until ' + until + (st.active ? '; paused by quiet hours.' : '.');
  }
  if(st.next_start) return 'Next window: ' + new Date(st.next_start*1000).toLocaleString([], {weekday:'short', hour:'2-digit', minute:'2-digit'}) + '.';
  return st.enabled ? 'No windows yet.' : '';
}
function renderQuiet(d){
  document.getElementById('quiet-enabled').checked = !!d.config.enabled;
  document.getElementById('windows').innerHTML = (d.config.windows||[]).map(winRow).join('') || '<p class="dim">No windows yet.</p>';
  document.getElementById('quiet-state').textContent = quietStateText(d.state);
}
function collectQuiet(){
  return {enabled: document.getElementById('quiet-enabled').checked,
          windows: [].slice.call(document.querySelectorAll('#windows .win')).map(function(r){
            return {days: [].slice.call(r.querySelectorAll('.win-day:checked')).map(function(c){ return Number(c.value); }),
                    start: r.querySelector('.win-start').value, end: r.querySelector('.win-end').value};
          })};
}
function loadQuiet(){
  return fetch('manage/quiet', {cache:'no-store'}).then(function(r){ return r.json(); }).then(renderQuiet);
}
document.getElementById('win-add').addEventListener('click', function(){
  var box = document.getElementById('windows');
  if(box.querySelector('p')) box.innerHTML = '';
  box.insertAdjacentHTML('beforeend', winRow({days:[0,1,2,3,4]}));
});
document.getElementById('windows').addEventListener('click', function(e){
  if(e.target.classList && e.target.classList.contains('win-remove')){
    e.target.closest('.win').remove();
    if(!document.querySelector('#windows .win')) document.getElementById('windows').innerHTML = '<p class="dim">No windows yet.</p>';
  }
});
document.getElementById('quiet-save').addEventListener('click', function(){
  var err = document.getElementById('quiet-err'), msg = document.getElementById('quiet-msg');
  err.hidden = true; msg.textContent = '';
  post('manage/quiet', collectQuiet()).then(function(res){
    if(!res.ok){ err.textContent = res.body.error || 'Could not save.'; err.hidden = false; return; }
    renderQuiet(res.body); msg.textContent = 'Saved.'; setTimeout(function(){ msg.textContent = ''; }, 1500);
  });
});
// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '5' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var t = localStorage.getItem('bbMonitorTheme');
  if(t) document.documentElement.setAttribute('data-theme', t);
} catch(e){}
load();
loadNotify();
loadQuiet();
setInterval(loadQuiet, 30000);
</script>
