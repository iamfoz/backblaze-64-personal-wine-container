# The skipped files page, framed by the Skipped Files tab in the shell. Served
# from /skipped, reached as /monitor/skipped, so it sits behind the same
# auth_request as the dashboard. That matters more here than anywhere else in
# the monitor: this page is a list of paths on the user's own share, and a list
# of paths is the one thing that must never be readable without the web login.
# It began as the Skipped Files page and now leads with everything the client
# has to say about itself: warnings, a pause, a first backup running or just
# finished, and then the skipped list under it. One place to look when the
# monitor shows a red band.
STATUS_HTML = """<!doctype html>
<html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Backblaze 64 Status</title>
<style>
""" + THEME_CSS + PAGE_CSS + """  *{box-sizing:border-box;}
  body{margin:0 auto;max-width:1132px;padding:16px;background:var(--bg);color:var(--text);
    font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    font-size:14px;line-height:1.5;}
  h1{font-size:18px;margin:0 0 4px;color:var(--title);}
  p{margin:0 0 12px;max-width:100ch;}
  .dim{color:var(--dim);}
  .good{color:var(--good);}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:6px;
    padding:14px;margin-bottom:16px;}
  button{padding:7px 14px;border-radius:4px;border:1px solid var(--border);
    background:var(--title);color:var(--bg);font:inherit;font-weight:600;cursor:pointer;}
  button.ghost{background:transparent;color:var(--text);font-weight:400;}
  input[type=text]{width:100%;max-width:340px;padding:6px 8px;border-radius:4px;
    border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;}
  .controls{display:flex;gap:8px;align-items:center;margin-bottom:16px;}
  /* The reasons double as the filter, so they are buttons rather than text: a
     count is only half an answer, and the other half is which files it means. */
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
  .chip{padding:3px 10px;border-radius:10px;font-size:12px;font-weight:400;
    background:transparent;color:var(--text);}
  .chip.on{background:var(--title);color:var(--bg);font-weight:600;}
  table{width:100%;border-collapse:collapse;margin-top:6px;}
  th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--border);
    font-size:13px;vertical-align:top;}
  th{color:var(--dim);font-weight:600;white-space:nowrap;}
  td.reason{white-space:nowrap;}
  /* Paths on a mounted share get long and there is nothing to abbreviate them
     to, so they wrap on the separator rather than overflowing the panel. */
  td.path{word-break:break-all;color:var(--dim);}
  a{color:var(--title);}
  h2{font-size:15px;margin:18px 0 4px;color:var(--title);}
  /* One notice per thing that needs attention, with a coloured edge that says
     how urgently. Text, not icons, so a screen reader gets the same message.
     On the page background rather than the panel colour: the drive notice sits
     inside a panel, where a panel-coloured box has no edge at all. */
  .notice{border:1px solid var(--dim);border-left:4px solid var(--dim);background:var(--bg);
    border-radius:4px;padding:10px 12px;margin-bottom:8px;max-width:100ch;}
  .notice.n-bad{border-left-color:var(--bad);}
  .notice.n-warn{border-left-color:var(--warn);}
  .notice.n-good{border-left-color:var(--good);}
  .notice.n-info{border-left-color:var(--title);}
  .notice a{color:var(--title);}
  /* Deliberately quiet. Turning a warning off is a thing to reach for once you
     have read it, not the first thing the eye lands on. */
  .notice a.dismiss{color:var(--dim);white-space:nowrap;}
  /* State transitions, newest last, as a plain list with the time in a fixed
     column so the eye can run down it. */
  .tl{list-style:none;margin:0 0 6px;padding:8px 10px;font-size:13px;max-height:220px;overflow:auto;
    background:var(--panel);border:1px solid var(--border);border-radius:4px;}
  .tl li{display:flex;gap:12px;padding:2px 0;align-items:baseline;}
  .tl time{color:var(--dim);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    flex:0 0 5.5em;}
  .tl .note{color:var(--dim);}
  .err{color:var(--bad);margin-top:8px;}
  @media (max-width:560px){ table,thead,tbody,tr,th,td{display:block;}
    thead{display:none;} tr{border-bottom:1px solid var(--border);padding:6px 0;}
    th,td{border:none;padding:2px 0;white-space:normal;} }
</style></head><body>

<h1>Status</h1>
