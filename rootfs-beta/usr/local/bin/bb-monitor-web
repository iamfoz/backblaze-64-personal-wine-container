                              etaTrendHtml(d.eta_trend)) : '', 2)],
        ['drives', perVolumeHtml(d.per_volume)],
        ['remaining', '<span class="stat"'+(d.remaining_shape ? ' title="What is left averages '+esc(d.remaining_shape.avg_remaining_str)+' a file, against '+esc(d.remaining_shape.avg_done_str)+' for what has already gone. A remainder made of large files takes far longer than its count suggests."' : '')+'>Files Remaining: '+
