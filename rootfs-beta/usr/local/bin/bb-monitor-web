<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
// The client reports its own constants, BZ_FILE_PERMANENT_BAD_PERMISSIONS and
// the like. Shouting an identifier at someone is not an explanation, so the
// prefix goes and the rest is read as words; the raw value stays in the title
// attribute for anyone searching Backblaze support for it verbatim.
function pretty(r){
  var s = String(r==null?'':r).replace(/^BZ_/, '').replace(/^FILE_/, '');
  return s ? s.toLowerCase().replace(/_/g, ' ') : String(r==null?'':r);
}
var PERM = 'BZ_FILE_PERMANENT_BAD_PERMISSIONS';
var DATA = null;   // the last answer from /manage/status
var REASON = '';   // the reason chip in force, empty meaning all of them

function render(){
  var list = DATA && DATA.list;
  var files = (list && list.files) || [];
  document.getElementById('none').hidden = files.length > 0;
  document.getElementById('some').hidden = files.length === 0;
  document.getElementById('filter').hidden = files.length === 0;
  if(!files.length) return;

  // Counted from the list rather than from the counter beside it. The counter
  // reads every line that has three columns, which includes the report header
  // the client writes at the top, so it reports one file too many under a reason
  // that is really a date. The list keeps only lines with a real path, so its
  // total is the one that matches the rows on screen.
  var reasons = {};
  // The data layer counts reasons across every skipped file, not only the ones
  // sent down, so a truncated listing still reports how many of each exist.
  // Counting the rows here is the fallback for a container old enough not to
  // send that field.
  if (list && list.reasons) { reasons = list.reasons; }
  else { files.forEach(function(f){ reasons[f.reason] = (reasons[f.reason] || 0) + 1; }); }
  var total = list.total;
  document.getElementById('summary').innerHTML =
    '<strong>' + total + (total === 1 ? ' file' : ' files') + ' skipped.</strong>';

  var names = Object.keys(reasons).sort(function(a, b){ return reasons[b] - reasons[a]; });
  var chips = '<button class="chip' + (REASON ? '' : ' on') + '" data-reason="">All</button>';
  names.forEach(function(n){
    chips += '<button class="chip' + (REASON === n ? ' on' : '') + '" data-reason="' +
             esc(n) + '" title="' + esc(n) + '">' + esc(pretty(n)) +
             ' (' + reasons[n] + ')</button>';
  });
  document.getElementById('chips').innerHTML = chips;
  document.getElementById('permnote').hidden = !reasons[PERM];

  var trunc = document.getElementById('trunc');
  trunc.hidden = !(list.shown < list.total);
  if(!trunc.hidden){
    // Said plainly, because the counts by reason are then counts of what is
    // listed and not of everything, and a summary that quietly means something
    // narrower than it says is worse than no summary.
    trunc.textContent = 'Listing the ' + list.shown + ' most recent of ' + list.total +
                        '. The counts by reason cover all of them.';
  }

  var q = document.getElementById('filter').value.trim().toLowerCase();
  var shown = files.filter(function(f){
    if(REASON && f.reason !== REASON) return false;
    // The name is the tail of the path, so matching the path alone covers both.
    if(q && String(f.path || '').toLowerCase().indexOf(q) < 0) return false;
    return true;
  });
  document.getElementById('rows').innerHTML = shown.map(function(f){
    return '<tr><td class="reason" title="' + esc(f.reason) + '">' + esc(pretty(f.reason)) +
           '</td><td>' + esc(f.name) + '</td><td class="path">' + esc(f.path) + '</td></tr>';
  }).join('');
  document.getElementById('empty').hidden = shown.length > 0;
}

// The link that turns one notice off. The key comes from the payload rather
// than being built here out of a kind and a drive letter: the key is what gets
// stored, and its shape is bbdismiss's business, not the page's. The text
// travels with it so the Settings list can say what was dismissed rather than
// showing a bare identifier.
function dismissLink(key, text){
  return ' <a href="#" class="dismiss" data-key="' + esc(key) +
         '" data-text="' + esc(text) + '">Dismiss</a>';
}
// Everything above the skipped list. Each notice is one thing the client's own
// records say needs attention, and the ones bb-doctor can diagnose point at the
// Tools tab. When there is nothing, the page says so rather than showing an
// empty space that might be a page that failed to load.
function renderNotices(j){
  var out = [];
  var tools = '<a href="/?tab=tools" target="_top">Tools tab</a>';
  if(j.ok === false){
    out.push('<div class="notice n-info"><strong>Collecting.</strong> <span class="dim">' +
             esc(j.error || 'the monitor is starting') + '</span></div>');
  }
  (j.health || []).forEach(function(h){
    // Dismissed means the person has looked at this and accepted it, so the
    // Status tab says nothing. The API still reports the entry, marked
    // dismissed, and Settings lists it with a Reset.
    if(h.dismissed) return;
    var extra = '';
    if(h.kind === 'skipped') extra = ' They are listed below.';
    else if(h.kind === 'frozen') extra = ' Backblaze has stopped the client because something ' +
      'looked wrong with the drive it was backing up. Nothing is deleted. Run bb-doctor from the ' +
      tools + ', and read <a href="https://www.backblaze.com/computer-backup/docs/resolve-a-safety-freeze" ' +
      'target="_blank" rel="noopener noreferrer">the Backblaze page on resolving a safety freeze</a> ' +
      'before you change anything. Its uninstall and reinstall step means, in this container, deleting ' +
      '<code>/config/wine/drive_c/Program Files/Backblaze/</code> and restarting: the client is put back ' +
      'on the next start. It does not mean recreating the Wine prefix, which would destroy the backup ' +
      'state you are trying to save. If you get that far, ask before you do it.';
    else if(h.kind === 'licence') extra = ' Backblaze reports this account as something other than ' +
      'active. A licence that has lapsed stops the backup, and the client keeps running as though ' +
      'nothing were wrong, so the monitor will not show a fault until files start going stale. ' +
      'Check the billing page on your Backblaze account. Nothing already backed up is deleted ' +
      'while a licence is being sorted out, but do not leave it: Backblaze remove the data after ' +
      'the account has been inactive long enough, and how long that is depends on the plan.';
    else if(h.kind === 'renewal') extra = ' The card or the billing details Backblaze holds did not ' +
      'go through. Nothing new is being backed up until it does. Sign in at backblaze.com and ' +
      'update the payment details on the account; the client picks it up on its own afterwards.';
    else if(h.kind === 'filecheck') extra = ' Run bb-doctor from the ' + tools + '.';
    else if(h.kind === 'stale') extra = ' The client has not finished a pass within the limit set in its own settings.';
    out.push('<div class="notice n-bad"><strong>' + esc(h.text) + '.</strong>' + extra +
             dismissLink(h.key || h.kind, h.text) + '</div>');
  });
  if(j.paused){
    var pausing = j.state === 'Pausing', pl = j.pause_label || {}, q = j.quiet || {};
    var title = pausing ? 'Backup pausing.' : (q.active ? 'Paused for quiet hours.' : (pl.title || 'Backup paused') + '.');
    var detail = pausing ? 'The client is finishing the transfers already in flight.'
               : q.active ? 'The backup starts again when the window ends' +
                            (q.window_end ? ', at ' + esc(fmtTime(q.window_end)) : '') + '.'
               // Escaped like everything else here. For a code the monitor
               // knows this is one of its own constants, but for one it does
               // not it is the reason string out of the client's pauseinfo.xml,
               // which is the only Backblaze-written text on this page that
               // reaches innerHTML.
               : esc(pl.detail || 'Nothing uploads until the backup is started again, from the Monitor tab or the desktop.') +
                 (pl.until_str ? ' Until ' + esc(pl.until_str) + '.' : '');
    var who = pl.who === 'client' ? ' The client did this itself.'
            : pl.who === 'here' && !q.active ? ' Start it again from the Monitor tab when you are ready.' : '';
    out.push('<div class="notice n-warn"' + (pl.code ? ' title="' + esc(pl.code) + '"' : '') + '><strong>' +
             esc(title) + '</strong> ' + detail + who + '</div>');
  }
  (j.milestones || []).forEach(function(m){
    out.push('<div class="notice n-good"><strong>' + esc(m.label) + ',</strong> on ' +
             esc(fmtDate(m.at)) + '.</div>');
  });
  if(j.completion){
    var d = j.completion.days;
    out.push('<div class="notice n-good"><strong>First backup complete.</strong> ' +
             esc(j.completion.total_str) + ' uploaded' +
             (d > 0 ? ' in ' + esc(d) + ' day' + (d === 1 ? '' : 's') : '') + '.</div>');
  } else if(j.first_backup){
    var fd = j.first_backup.days;
    out.push('<div class="notice n-info"><strong>First backup in progress.</strong> ' +
             esc(j.first_backup.pct) + '% sent after ' + esc(fd) + ' day' + (fd === 1 ? '' : 's') +
             '. A first upload of a large set takes as long as it takes. This is not a fault.</div>');
  }
  if(!out.length){
    out.push('<div class="notice n-good"><strong class="good">Nothing needs your attention.</strong> ' +
             '<span class="dim">State: ' + esc(j.state || 'unknown') + '.</span></div>');
  }
  document.getElementById('notices').innerHTML = out.join('');
}

// What the client says about itself: whether a private key is set, which
// datacentre it is assigned to, and, per drive, whether it is set to back that
// drive up at all. The last of those is the one worth the space: a drive set to
// none is ticked in the client settings window and still backs nothing up.
function renderClient(c){
  var body = document.getElementById('client-body'), none = document.getElementById('client-none');
  if(!c){ body.hidden = true; none.hidden = false; return; }
  none.hidden = true; body.hidden = false;
  var out = [];
  var sel = c.drive_selection || {};
  var drives = Object.keys(sel).sort();
  // One notice per drive rather than one for all of them, because each carries
  // its own Dismiss and a person may well know about one drive and not another.
  // The list comes from the payload, which has already left out the container's
  // own drives: see selection_notices().
  (c.selection_notices || []).forEach(function(n){
    if(n.dismissed) return;
    var text = n.drive + ' is set to back up nothing';
    out.push('<div class="notice n-bad" style="margin-bottom:12px"><strong>' + esc(text) +
      '.</strong> The client is set to skip everything on that drive. It still shows ' +
      'as ticked in the Backblaze settings window, which is what makes this one hard to find, and it ' +
      'is the state behind the message "No files are selected". Fix it in the Backblaze settings ' +
      'window, under Settings and then Exclusions, by removing the exclusion on the drive itself.' +
      dismissLink(n.key, text) + '</div>');
  });
  out.push('<p style="margin:0 0 8px"><strong>Private encryption key:</strong> ' +
    (c.encrypted === true
      ? 'set. Backblaze cannot recover a forgotten private encryption key and cannot restore your ' +
        'backup without it, so keep a copy of it somewhere that is not this machine.'
      : c.encrypted === false
      ? 'not set. Your data is encrypted in transit and where it is stored, with Backblaze holding ' +
        'the key, so a restore needs only your account.'
      : 'not reported.') + '</p>');
  out.push('<p style="margin:0 0 8px"><strong>Cluster:</strong> ' +
    (c.cluster ? esc(c.cluster) : 'not reported') +
    (c.cluster_url ? ' <span class="dim">(' + esc(c.cluster_url) + ')</span>' : '') +
    ' <span class="dim">The datacentre this account is assigned to. When its authority server stops ' +
    'answering, the client pauses itself, and the pause has nothing to do with your connection.</span></p>');
  if(c.summary){
    out.push('<p style="margin:0 0 8px"><strong>The client says:</strong> ' + esc(c.summary) +
      (c.transmit ? ' <span class="dim">(transfer: ' + esc(c.transmit) + ')</span>' : '') +
      '</p>');
  }
  if(drives.length){
    out.push('<table><thead><tr><th>Drive</th><th>Set to back up</th></tr></thead><tbody>' +
      drives.map(function(k){
        var s = sel[k] || {};
        // A system drive that backs up nothing is the right answer, not a
        // fault, so it is stated plainly in the dim colour rather than in the
        // one the page uses for something that needs fixing.
        var answer = s.backed_up
          ? 'Yes, all files'
          : s.system
          ? '<span class="dim">No, nothing (the container' +
            "'s own drive; nothing here needs backing up)</span>"
          : '<strong style="color:var(--bad)">No, nothing</strong> <span class="dim">(' +
            esc(s.whichfiles == null ? 'not set' : s.whichfiles) + ')</span>';
        return '<tr><td>' + esc(k) + '</td><td>' + answer + '</td></tr>';
      }).join('') + '</tbody></table>');
  }
  if(c.at){
    var when = '';
    try { when = new Date(c.at*1000).toLocaleTimeString(); } catch(e){}
    out.push('<p class="dim" style="margin:8px 0 0">Read from the client at ' + esc(when) +
      '. Reading it starts a Windows process, so it is taken every few minutes rather than every poll.' +
      (c.error ? ' Last reading reported: ' + esc(c.error) : '') + '</p>');
  }
  body.innerHTML = out.join('');
}

function fmtTime(epoch){ try { var d = new Date(epoch*1000); return (d.getHours()<10?'0':'')+d.getHours()+':'+(d.getMinutes()<10?'0':'')+d.getMinutes(); } catch(e){ return ''; } }
function fmtDate(epoch){ try { return new Date(epoch*1000).toLocaleDateString(undefined, {day:'numeric', month:'long'}); } catch(e){ return ''; } }
function renderTimeline(list){
  var ul = document.getElementById('timeline'), none = document.getElementById('tl-none');
  list = list || [];
  ul.hidden = !list.length; none.hidden = !!list.length;
  // Newest first: the question is "what just happened", and a box that scrolls
  // should open on the answer. Summary lines after a spell of uploading sit in
  // the list at the moment the spell ended.
  ul.innerHTML = list.slice().reverse().map(function(t){
    return '<li><time>' + esc(fmtTime(t.at)) + '</time>' +
           (t.state ? '<span>' + esc(t.state) + '</span>' : '') +
           (t.note ? '<span class="note">' + esc(t.note) + '</span>' : '') + '</li>';
  }).join('');
}
function copySummary(){
  var btn = document.getElementById('summary');
  fetch('manage/summary', {cache:'no-store'}).then(function(r){ return r.text(); }).then(function(txt){
    function done(){ var keep = 'Copy status summary'; btn.textContent = 'Copied'; setTimeout(function(){ btn.textContent = keep; }, 1200); }
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(txt).then(done, function(){ prompt('Copy this:', txt); }); }
    else { prompt('Copy this:', txt); }
  }).catch(function(){ btn.textContent = 'Could not fetch'; });
}

function load(){
  var err = document.getElementById('err');
  // Every fifteen seconds. The skipped list changes only when the client
  // rescans, but the notices above it follow the client's state, and a pause or
  // a freeze should not wait for a page reload to appear.
  return fetch('manage/status', {cache:'no-store'})
    .then(function(r){ return r.json(); })
    .then(function(j){ DATA = j; err.hidden = true; renderNotices(j); renderClient(j.client);
                       renderTimeline(j.timeline); render(); })
    .catch(function(){ err.textContent = 'Could not read the status.';
                       err.hidden = false; });
}

document.getElementById('refresh').addEventListener('click', load);
document.getElementById('summary').addEventListener('click', copySummary);
document.getElementById('filter').addEventListener('input', render);
// Every Dismiss link on the page, caught once on the document, because the
// notices are rebuilt from scratch on each poll and a listener bound to one of
// them would be thrown away with it. The header is the same one the other
// /manage/ posts send: it is what forces a preflight on anything cross-origin,
// which is what stops another site borrowing this browser session.
document.addEventListener('click', function(e){
  var a = e.target;
  if(!a || !a.classList || !a.classList.contains('dismiss')) return;
  e.preventDefault();
  var key = a.getAttribute('data-key');
  if(!key) return;
  fetch('manage/notices/dismiss', {method:'POST', cache:'no-store',
    headers:{'Content-Type':'application/json','X-Requested-With':'bb64'},
    body: JSON.stringify({key: key, text: a.getAttribute('data-text') || ''})
  }).then(function(r){
    // Hidden straight away rather than waiting for the next poll, which is up
    // to fifteen seconds away and long enough to look as though the click did
    // nothing. The poll then redraws without it anyway.
    if(r.ok){ var n = a.parentNode; if(n) n.hidden = true; load(); }
    else { var err = document.getElementById('err');
           err.textContent = 'Could not dismiss that warning.'; err.hidden = false; }
  }).catch(function(){
    var err = document.getElementById('err');
    err.textContent = 'Could not dismiss that warning.'; err.hidden = false;
  });
});
document.getElementById('chips').addEventListener('click', function(e){
  var r = e.target.getAttribute && e.target.getAttribute('data-reason');
  if(r === null || r === undefined) return;
  REASON = r;
  render();
});
// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '6' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var t = localStorage.getItem('bbMonitorTheme');
  if(t) document.documentElement.setAttribute('data-theme', t);
} catch(e){}
load();
setInterval(load, 15000);
</script>
</body></html>
"""


# The command-line tools, run from the page. Served from /tools, reached as
# /monitor/tools, so it sits behind the same auth_request as the dashboard:
# bb-doctor prints directory paths on the user's share, which is the same class
# of data the Status tab protects. The page runs the binaries the console runs
# (see bbtools.py) and shows their output as text, coloured by the prefixes
# bb-doctor prints; a line it does not recognise is shown plain, so a change of
# wording in a tool never hides anything.
TOOLS_HTML = """<!doctype html>
<html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Backblaze 64 Tools</title>
