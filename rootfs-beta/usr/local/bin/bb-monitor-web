#!/usr/bin/env python3
"""bb-monitor-web: same live upload dashboard as bb-monitor, served over HTTP.

Reuses the exact same data sources as bb-monitor (proc, cgroup, and
Backblaze's own bzdata log/XML files) -- no curses, no subprocesses.
A background thread gathers a fresh snapshot every INT seconds; the HTTP
server just hands out the latest snapshot as JSON, plus a static HTML/JS
page that polls it and redraws.

In the container image this runs as a supervised service bound to loopback,
with nginx proxying /monitor/ to it on the existing web port (5800). That way
it inherits whatever WEB_AUTHENTICATION and SECURE_CONNECTION the user has
configured for the GUI, instead of exposing backed-up file names on a second
open port.

Standalone, for testing:
    python3 bb-monitor-web --host 127.0.0.1 --port 8099
"""
import argparse, json, os, re, socket, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

# ---- shared data layer ----------------------------------------------------
# Everything that reads /proc, the cgroups and Backblaze's own files lives in
# bbdata, so this file and bb-monitor cannot drift apart. This one owns HTTP and
# the page; the terminal one owns curses. Neither owns data collection.
sys.path.insert(0, "/usr/local/lib/bb-monitor")
import bbapi
import bbconfig
import bbctl
import bbdata
import bbdismiss
import bbreport
import bbtools
import bbnotify
import bbquiet
import bbtimeline
from bbdata import (BUILD_INFO, BUILD_LABEL, INT, eta_str, gather, human,
                     rec_cols, uptime_str, _diag_dump, _threadpush_uid,
                     _upload_host, _upload_rtt)

_lock = threading.Lock()
APP_NAME = "Backblaze 64"
APP_COMPONENT = "Upload Monitor"
APP_COPYRIGHT = "Copyright \u00a9 2026 Martyn Forryan"
APP_LICENSE = "GNU Affero General Public License v3.0"
APP_URL = "https://github.com/iamfoz/backblaze-64-personal-wine-container"

# Contributed work credited in the About tab: (forum handle, one-line description).
# An empty list hides the Thanks section, so a missing handle never ships as
# placeholder text.
CREDITS = [("rogman", "web monitor, themes & features")]







# Static, so it rides along with every payload including the error ones. The
# About tab is most useful precisely when collection is broken and someone needs
# to quote a build in a bug report.
ABOUT = {
    "name": APP_NAME,
    "component": APP_COMPONENT,
    "copyright": APP_COPYRIGHT,
    "license": APP_LICENSE,
    "url": APP_URL,
    "build": BUILD_INFO,
    "credits": [{"who": w, "what": t} for w, t in CREDITS],
}

# Restated now ABOUT exists, so even the pre-first-sample payload carries it.
_latest = {"ok": False, "error": "warming up", "about": ABOUT}
_latest_api = {"schema": bbapi.SCHEMA, "ok": False, "error": "warming up"}

# Cross-origin access for a consumer that runs in a browser, which cannot reach
# the API at all without it. Off unless API_CORS_ORIGINS names origins, and an
# allow-list rather than "*": the key is still required either way, but with "*"
# any page the user happens to visit could poll their container in the
# background, and the answer names every file being backed up.
#
# This applies to /api/v1/ only. /manage/ is authorised by the browser session,
# so allowing another origin to call it would hand key creation to any page the
# user has open. That is the CSRF hole the X-Requested-With guard exists to close.
CORS_ORIGINS = tuple(o.strip().rstrip("/") for o in
                     os.environ.get("API_CORS_ORIGINS", "").split(",") if o.strip())


# ---- what the client says about itself --------------------------------------
# Read through Backblaze's own bzcli, which starts a Wine process for every
# reading, so bbconfig caches it and nothing here ever reads it directly. Before
# the first reading lands, and on an image with no bzcli in it, cached() answers
# None and every field below is absent rather than wrong.
def client_reading():
    """The client's own account of itself, one shape for the page and the API.

    Spelled out field by field rather than passed through, for the same reason
    api_v1_payload is: bbconfig's shape is its own business, and passing it
    through would make it a published contract the moment it shipped. "licence"
    is spelt the British way because it is our field name; bbconfig keeps
    Backblaze's spelling for the field it reads.
    """
    d = bbconfig.cached()
    if not d:
        return None
    lic = d.get("license") or {}
    failure = lic.get("renewal_failure")
    sel = bbconfig.drive_selection(d)
    return {
        # When the reading was taken, so a page can say how old it is rather
        # than presenting a five-minute-old value as the state of things now.
        "at": d.get("at"),
        "ok": d.get("ok"),
        "error": d.get("error"),
        "version": d.get("client_version"),
        "licence": {
            "status": lic.get("status"),
            "type": lic.get("type"),
            # Two fields for one question: whether the last renewal failed, and
            # what the client called the failure. A failed renewal stops the
            # backup, and nothing else in this container can see it happen.
            "renewal_failed": bool(failure and failure != "none"),
            "renewal_failure": failure,
            "renewal_failed_at": lic.get("renewal_failed_at"),
        },
        "encrypted": d.get("encrypted"),
        "cluster": d.get("cluster"),
        "cluster_url": d.get("cluster_url"),
        "safety_freeze": d.get("safety_freeze"),
        # The client's own words, beside the state the monitor derives from the
        # files. Not a replacement for it, which is finer grained, but the phrase
        # to quote in a support thread.
        "summary": d.get("summary"),
        "transmit": d.get("transmit"),
        "settings": d.get("settings") or {},
        # Read only, and it stays that way: the container's own quiet hours
        # already cover this ground, and two mechanisms fighting over one
        # behaviour is a fault waiting to happen.
        "schedule": d.get("schedule") or {},
        # Both of these name directories on the user's own share, so both are
        # dropped for a key without read:files. See strip_file_names().
        "drive_selection": sel,
        "excluded_dirs": bbconfig.excluded_dirs(d),
        # One entry per drive that warrants the "set to back up nothing" notice,
        # with the key that dismisses it worked out here. The page draws the
        # notice, but it has no business building a key out of a drive letter:
        # the key is a stored identifier and its shape belongs to bbdismiss.
        "selection_notices": selection_notices(sel),
    }


def selection_notices(sel):
    """The drives worth warning about, and whether the warning was dismissed.

    A system drive is left out entirely rather than dismissed: the prefix drive
    and Wine's root mapping are the container itself, so there was never
    anything there to accept.
    """
    if not sel:
        return []
    done = bbdismiss.keys()
    out = []
    for drive in sorted(sel):
        row = sel[drive] or {}
        if row.get("system") or row.get("backed_up"):
            continue
        key = bbdismiss.key_for("selection", drive)
        out.append({"key": key, "drive": drive, "dismissed": key in done})
    return out


def client_health(pairs):
    """The health list with the client's own warnings merged into it.

    bbdata raises "frozen" from status.json and bbconfig raises it again from the
    field the client documents, so a freeze would otherwise be reported twice on
    one page. De-duplicated by kind, with whatever is already there kept: the
    file is read every poll, and the bzcli reading can be minutes old.
    """
    out = list(pairs or [])
    seen = set(k for k, _ in out)
    try:
        extra = bbconfig.health()
    except Exception as exc:        # a settings reading must not break health
        sys.stderr.write("bb-monitor-web: client health: %s\n" % exc)
        return out
    for kind, text in extra:
        if kind not in seen:
            seen.add(kind)
            out.append((kind, text))
    return out


def health_entries(pairs):
    """The health list as both the page and the API carry it.

    The key is the kind, because a health warning is raised once for the whole
    container: there is one freeze, one licence. The selection warnings are the
    ones that need a subject in the key, and they travel separately, under the
    client reading, because that is where the drive they name already is.
    """
    done = bbdismiss.keys()
    return [{"kind": k, "text": t, "key": k, "dismissed": k in done}
            for k, t in client_health(pairs)]


def strip_client_dirs(client):
    """The client reading with nothing left in it that names a directory on the
    user's share. The licence, the cluster and the container's own settings stay:
    they say nothing about what is being backed up."""
    if not client:
        return client
    out = dict(client)
    out["drive_selection"] = None
    out["excluded_dirs"] = None
    # A selection notice names a drive and nothing else, but a drive letter is
    # what drive_selection is withheld for, so it goes the same way rather than
    # being argued about separately.
    out["selection_notices"] = None
    return out


# ---- JSON snapshot builder ------------------------------------------------
def snapshot_to_json(d):
    r = d["rate"]
    mem = d["mem"]
    swap = d["swap"]
    lat_ms, lat_host, lat_note = _upload_rtt()
    files_out = []
    for name, part, fsize, pct, parts in d["files"]:
        size_str = (human(fsize) + (" (chunked)" if fsize > part * 1.5 else "")) if fsize > 0 else "%d MB" % (part / 1048576)
        row = {"name": name, "pct": round(pct, 1), "size_str": size_str}
        if parts:
            row["parts"] = {"done": parts[0], "total": parts[1]}
        files_out.append(row)
    recent_out = []
    for rr in d["recent"]:
        th, size, rate = rec_cols(rr)
        recent_out.append({"time": rr["t"], "thread": th, "size": size, "rate": rate, "name": rr["name"]})
    return {
        "ok": True,
        "clock": time.strftime("%H:%M:%S"),
        "threads": d["threads"],
        "state": d["state"],
        "rate_mb": round(r, 3),
        "rate_str": "%.2f MB/s" % r,
        # SI megabits, from the bytes/s figure, because that is the unit a line
        # speed is sold in and it is what summary_text and the timeline use.
        # r is MiB/s, so multiplying it by 8 was 5% high against both of them.
        "rate_mbit_str": "~%d Mbit/s" % (r * 1048576 * 8 / 1e6),
        "chunks": d["chunks"],
        "session_str": human(d["sess"]),
        "mem": {"used_str": human(mem[0]), "total_str": human(mem[1]), "pct": round(mem[2], 1)} if mem else None,
        "memory_by_process": d.get("memory_by_process"),
        "swap": {"used_str": human(swap[0]), "total_str": human(swap[1]), "pct": round(swap[2], 1)} if swap else None,
        # Two places on this one gauge: see human(). The percent moves about
        # 0.005 points every quarter of an hour on a large backup, so one place
        # there is as still as the byte figure was.
        "backup": ({"used_str": human(d["backup"]["done"], 2),
                     "total_str": human(d["backup"]["total"], 2),
                     "pct": round(d["backup"]["pct"], 2),
                     "files": ("%d/%d files" % (d["backup"]["done_files"], d["backup"]["total_files"]))
                               if d["backup"]["done_files"] is not None else "",
                     "eta": eta_str(d["backup"].get("eta_seconds")),
                     # The same estimate as a calendar date. A duration answers
                     # "how long", a date answers "when", and only the second one
                     # can be compared against anything the user has planned.
                     "eta_date": bbdata.eta_date(d["backup"].get("eta_seconds")),
                     "eta_samples": d["backup"].get("eta_samples", 0),
                     "remaining_files": d["backup"].get("remaining_files")}
                    if d.get("backup") else None),
        "files": files_out,
        "recent": recent_out,
        "build_label": BUILD_LABEL,
        "interval": INT,
        "uptime": uptime_str(),
        "current_file": d.get("current_file"),
        "activity": d.get("activity"),
        "scan": ({"pct": round(d["scan"]["pct"], 1),
                   "dirs": "%d/%d" % (d["scan"]["dirs_done"], d["scan"]["dirs_total"]),
                   "files": d["scan"]["files"],
                   "size_str": human(d["scan"]["bytes"]) if d["scan"]["bytes"] else None}
                  if d.get("scan") else None),
        "perf": d.get("perf"),
        "health": health_entries(d.get("health")),
        "upload_success": d.get("upload_success"),
        # Raw counts rather than a pre-drawn chart: the page scales the bars to
        # its own tallest day, and the day strings are already display-ready.
        "upload_history": d.get("upload_history"),
        # The size is formatted here because the banner states it as prose, and
        # the days figure is a whole number of days by construction.
        "completion": ({"done_at": d["completion"]["done_at"],
                         "days": d["completion"]["days"],
                         "total_str": human(d["completion"]["total_bytes"])}
                        if d.get("completion") else None),
        # What the set is actually made of. Counts only, and only the categories
        # the client itself counted, so the page can say what a couple of million
        # files are rather than only how many there are.
        "composition": d.get("composition"),
        # YYYYMMDD as the client records it. The page formats it for display,
        # because the raw string is also what the API hands a consumer that wants
        # to parse the date rather than read it, and one shape serves both.
        "backing_up_since": d.get("backing_up_since"),
        # Whether the estimate is better or worse than the last day recorded.
        # An ETA on its own says nothing about whether it is being caught up.
        "eta_trend": d.get("eta_trend"),
        # The pause state as a single flag, which is all the title bar button
        # needs to choose its label. The full pause record, with the deadline and
        # the reason, stays in the API payload where a consumer can act on it.
        "paused": (d.get("pause") or {}).get("paused", False),
        # The pause in words: who set it, why, and until when. A bare "Paused"
        # raised the question this answers.
        "pause": d.get("pause"),
        "pause_label": d.get("pause_label"),
        "milestones": d.get("milestones"),
        "progress_history": d.get("progress_history"),
        "compress_saved": human(d["compress_saved"]) if d.get("compress_saved") else None,
        # Which drive is holding the backup up, and how big what is left is
        # against what has gone. Both come from files already read.
        "per_volume": ([{"path": v["path"], "pct": round(v["pct"], 2),
                          "used_str": human(v["done"], 2), "total_str": human(v["total"], 2),
                          "remaining_files": v["remaining_files"]}
                         for v in d["per_volume"]] if d.get("per_volume") else None),
        "remaining_shape": ({"avg_remaining_str": human(d["remaining_shape"]["avg_remaining"]),
                              "avg_done_str": human(d["remaining_shape"]["avg_done"]),
                              "ratio": round(d["remaining_shape"]["ratio"], 1)}
                             if d.get("remaining_shape") and d["remaining_shape"].get("ratio") else None),
        "rate_limits": bbdata.rate_limits(int(d.get("rate", 0) * 1048576),
                                          d.get("threads"), lat_ms),
        "skipped": d.get("skipped"),
        # The skipped files themselves, not just the counts. The Skipped Files
        # page needs the names to be useful at all, and it reads them from the
        # cached snapshot rather than calling gather() itself, so the raw list
        # has to travel in the snapshot the collector thread already builds.
        "skipped_list": d.get("skipped_list"),
        # Two places for the same reason the backup gauge has them: this is the
        # same percentage, and at one place it sat as still.
        "first_backup": ({"days": round(d["first_backup"]["days"]),
                           "pct": round(d["first_backup"]["pct"], 2)}
                          if d.get("first_backup") else None),
        "last_backup_days": (round(d["last_backup_days"], 1)
                             if d.get("last_backup_days") is not None else None),
        "chunkmap": d.get("chunkmap"),
        "latency_ms": (round(lat_ms, 1) if lat_ms is not None else None),
        "latency_host": lat_host,
        "latency_note": lat_note,
        "upload_pod": _upload_host(),
        # What the client says about itself: licence, cluster, encryption, its
        # own summary, and the settings behind them. None until the first bzcli
        # reading lands, and on an image that has no bzcli.
        "client": client_reading(),
        "about": ABOUT,
    }



# The palettes, once, spliced into every page at import time so a theme chosen
# in the Monitor applies to the Status, Tools and API pages as well, and any
# page added later inherits them by construction. The Monitor also uses
# --hi-bg, --hi-fg and the track colours; the other pages use --dim, which is
# derived from each palette below rather than kept as a fourteenth value.
