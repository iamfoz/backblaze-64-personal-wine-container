var KINDS = [['ntfy', 'ntfy topic'], ['webhook', 'Webhook (JSON)']];
var AUTHS = [['none', 'No auth'], ['bearer', 'Bearer token'], ['basic', 'Basic auth']];
function opts(list, cur){ return list.map(function(o){ return '<option value="'+esc(o[0])+'"'+(o[0]===cur?' selected':'')+'>'+esc(o[1])+'</option>'; }).join(''); }
function epRow(e, i){
  return '<div class="ep" data-i="'+i+'">' +
    '<label class="f">Label<input type="text" class="ep-label" value="'+esc(e.label||'')+'" placeholder="Phone"></label>' +
