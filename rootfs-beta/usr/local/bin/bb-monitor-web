        ['rate', '<span class="stat" title="'+esc(rateTitle(d))+'">Up: <span class="'+rateCls+'">'+d.rate_str+'</span> ('+d.rate_mbit_str+')'+sparklineSvg(rateHistory,70,16)+'</span>'],
        ['threads', '<span class="stat">Threads: '+d.threads+'</span>'],
        ['chunks', '<span class="stat">Chunks/60s: '+d.chunks+'</span>'],
        ['rtt', pingHtml(d)],
        ['session', '<span class="stat">Session: '+d.session_str+'</span>'],
        ['scan', d.scan ? '<span class="stat">Scanning: '+d.scan.dirs+' dirs \u2022 ' +
                  esc((d.scan.files||0).toLocaleString())+' files' +
                  (d.scan.size_str ? ' \u2022 '+esc(d.scan.size_str) : '') + '</span>' : ''],
