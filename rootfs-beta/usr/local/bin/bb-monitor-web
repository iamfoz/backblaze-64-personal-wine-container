<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
// The client reports its own constants, BZ_FILE_PERMANENT_BAD_PERMISSIONS and
// the like. Shouting an identifier at someone is not an explanation, so the
// prefix goes and the rest is read as words; the raw value stays in the title
// attribute for anyone searching Backblaze support for it verbatim.
function pretty(r){
  var s = String(r==null?'':r).replace(/^BZ_/, '').replace(/^FILE_/, '');
  return s ? s.toLowerCase().replace(/_/g, ' ') : String(r==null?'':r);
}
var PERM = 'BZ_FILE_PERMANENT_BAD_PERMISSIONS';
var DATA = null;   // the last answer from /manage/status
var REASON = '';   // the reason chip in force, empty meaning all of them

function render(){
  var list = DATA && DATA.list;
  var files = (list && list.files) || [];
  document.getElementById('none').hidden = files.length > 0;
  document.getElementById('some').hidden = files.length === 0;
  document.getElementById('filter').hidden = files.length === 0;
  if(!files.length) return;

  // Counted from the list rather than from the counter beside it. The counter
  // reads every line that has three columns, which includes the report header
  // the client writes at the top, so it reports one file too many under a reason
  // that is really a date. The list keeps only lines with a real path, so its
  // total is the one that matches the rows on screen.
  var reasons = {};
  // The data layer counts reasons across every skipped file, not only the ones
  // sent down, so a truncated listing still reports how many of each exist.
  // Counting the rows here is the fallback for a container old enough not to
  // send that field.
  if (list && list.reasons) { reasons = list.reasons; }
  else { files.forEach(function(f){ reasons[f.reason] = (reasons[f.reason] || 0) + 1; }); }
  var total = list.total;
  document.getElementById('summary').innerHTML =
    '<strong>' + total + (total === 1 ? ' file' : ' files') + ' skipped.</strong>';

  var names = Object.keys(reasons).sort(function(a, b){ return reasons[b] - reasons[a]; });
  var chips = '<button class="chip' + (REASON ? '' : ' on') + '" data-reason="">All</button>';
  names.forEach(function(n){
    chips += '<button class="chip' + (REASON === n ? ' on' : '') + '" data-reason="' +
             esc(n) + '" title="' + esc(n) + '">' + esc(pretty(n)) +
             ' (' + reasons[n] + ')</button>';
  });
  document.getElementById('chips').innerHTML = chips;
  document.getElementById('permnote').hidden = !reasons[PERM];

  var trunc = document.getElementById('trunc');
  trunc.hidden = !(list.shown < list.total);
  if(!trunc.hidden){
    // Said plainly, because the counts by reason are then counts of what is
    // listed and not of everything, and a summary that quietly means something
    // narrower than it says is worse than no summary.
    trunc.textContent = 'Listing the ' + list.shown + ' most recent of ' + list.total +
                        '. The counts by reason cover all of them.';
  }

  var q = document.getElementById('filter').value.trim().toLowerCase();
  var shown = files.filter(function(f){
    if(REASON && f.reason !== REASON) return false;
    // The name is the tail of the path, so matching the path alone covers both.
    if(q && String(f.path || '').toLowerCase().indexOf(q) < 0) return false;
    return true;
  });
  document.getElementById('rows').innerHTML = shown.map(function(f){
    return '<tr><td class="reason" title="' + esc(f.reason) + '">' + esc(pretty(f.reason)) +
           '</td><td>' + esc(f.name) + '</td><td class="path">' + esc(f.path) + '</td></tr>';
  }).join('');
  document.getElementById('empty').hidden = shown.length > 0;
}

// Everything above the skipped list. Each notice is one thing the client's own
// records say needs attention, and the ones bb-doctor can diagnose point at the
// Tools tab. When there is nothing, the page says so rather than showing an
// empty space that might be a page that failed to load.
function renderNotices(j){
  var out = [];
  var tools = '<a href="/?tab=tools" target="_top">Tools tab</a>';
  if(j.ok === false){
    out.push('<div class="notice n-info"><strong>Collecting.</strong> <span class="dim">' +
             esc(j.error || 'the monitor is starting') + '</span></div>');
  }
  (j.health || []).forEach(function(h){
    var extra = '';
    if(h.kind === 'skipped') extra = ' They are listed below.';
    else if(h.kind === 'frozen') extra = ' Backblaze has stopped the client because something ' +
      'looked wrong with the drive it was backing up. Nothing is deleted. Run bb-doctor from the ' +
      tools + ', and read <a href="https://www.backblaze.com/computer-backup/docs/resolve-a-safety-freeze" ' +
      'target="_blank" rel="noopener noreferrer">the Backblaze page on resolving a safety freeze</a> ' +
      'before you change anything. Its uninstall and reinstall step means, in this container, deleting ' +
      '<code>/config/wine/drive_c/Program Files/Backblaze/</code> and restarting: the client is put back ' +
      'on the next start. It does not mean recreating the Wine prefix, which would destroy the backup ' +
      'state you are trying to save. If you get that far, ask before you do it.';
    else if(h.kind === 'filecheck') extra = ' Run bb-doctor from the ' + tools + '.';
    else if(h.kind === 'stale') extra = ' The client has not finished a pass within the limit set in its own settings.';
    out.push('<div class="notice n-bad"><strong>' + esc(h.text) + '.</strong>' + extra + '</div>');
  });
  if(j.paused){
    var pausing = j.state === 'Pausing', pl = j.pause_label || {}, q = j.quiet || {};
    var title = pausing ? 'Backup pausing.' : (q.active ? 'Paused for quiet hours.' : (pl.title || 'Backup paused') + '.');
    var detail = pausing ? 'The client is finishing the transfers already in flight.'
               : q.active ? 'The backup starts again when the window ends' +
                            (q.window_end ? ', at ' + esc(fmtTime(q.window_end)) : '') + '.'
               : (pl.detail || 'Nothing uploads until the backup is started again, from the Monitor tab or the desktop.') +
                 (pl.until_str ? ' Until ' + esc(pl.until_str) + '.' : '');
    var who = pl.who === 'client' ? ' The client chose this; it is not something to fix here.'
            : pl.who === 'here' && !q.active ? ' Start it again from the Monitor tab when you are ready.' : '';
    out.push('<div class="notice n-warn"' + (pl.code ? ' title="' + esc(pl.code) + '"' : '') + '><strong>' +
             esc(title) + '</strong> ' + detail + who + '</div>');
  }
  (j.milestones || []).forEach(function(m){
    out.push('<div class="notice n-good"><strong>' + esc(m.label) + ',</strong> on ' +
             esc(fmtDate(m.at)) + '.</div>');
  });
  if(j.completion){
    var d = j.completion.days;
    out.push('<div class="notice n-good"><strong>First backup complete.</strong> ' +
             esc(j.completion.total_str) + ' uploaded' +
             (d > 0 ? ' in ' + esc(d) + ' day' + (d === 1 ? '' : 's') : '') + '.</div>');
  } else if(j.first_backup){
    var fd = j.first_backup.days;
    out.push('<div class="notice n-info"><strong>First backup in progress.</strong> ' +
             esc(j.first_backup.pct) + '% sent after ' + esc(fd) + ' day' + (fd === 1 ? '' : 's') +
             '. A first upload of a large set takes as long as it takes. This is not a fault.</div>');
  }
  if(!out.length){
    out.push('<div class="notice n-good"><strong class="good">Nothing needs your attention.</strong> ' +
             '<span class="dim">State: ' + esc(j.state || 'unknown') + '.</span></div>');
  }
  document.getElementById('notices').innerHTML = out.join('');
}

function fmtTime(epoch){ try { var d = new Date(epoch*1000); return (d.getHours()<10?'0':'')+d.getHours()+':'+(d.getMinutes()<10?'0':'')+d.getMinutes(); } catch(e){ return ''; } }
function fmtDate(epoch){ try { return new Date(epoch*1000).toLocaleDateString(undefined, {day:'numeric', month:'long'}); } catch(e){ return ''; } }
function renderTimeline(list){
  var ul = document.getElementById('timeline'), none = document.getElementById('tl-none');
  list = list || [];
  ul.hidden = !list.length; none.hidden = !!list.length;
  ul.innerHTML = list.map(function(t){
    return '<li><time>' + esc(fmtTime(t.at)) + '</time><span>' + esc(t.state || '?') + '</span></li>';
  }).join('');
}
function copySummary(){
  var btn = document.getElementById('summary');
  fetch('manage/summary', {cache:'no-store'}).then(function(r){ return r.text(); }).then(function(txt){
    function done(){ var keep = 'Copy status summary'; btn.textContent = 'Copied'; setTimeout(function(){ btn.textContent = keep; }, 1200); }
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(txt).then(done, function(){ prompt('Copy this:', txt); }); }
    else { prompt('Copy this:', txt); }
  }).catch(function(){ btn.textContent = 'Could not fetch'; });
}

function load(){
  var err = document.getElementById('err');
  // Every fifteen seconds. The skipped list changes only when the client
  // rescans, but the notices above it follow the client's state, and a pause or
  // a freeze should not wait for a page reload to appear.
  return fetch('manage/status', {cache:'no-store'})
    .then(function(r){ return r.json(); })
    .then(function(j){ DATA = j; err.hidden = true; renderNotices(j); renderTimeline(j.timeline); render(); })
    .catch(function(){ err.textContent = 'Could not read the status.';
                       err.hidden = false; });
}

document.getElementById('refresh').addEventListener('click', load);
document.getElementById('summary').addEventListener('click', copySummary);
document.getElementById('filter').addEventListener('input', render);
document.getElementById('chips').addEventListener('click', function(e){
  var r = e.target.getAttribute && e.target.getAttribute('data-reason');
  if(r === null || r === undefined) return;
  REASON = r;
  render();
});
// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '5' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var t = localStorage.getItem('bbMonitorTheme');
  if(t) document.documentElement.setAttribute('data-theme', t);
} catch(e){}
load();
setInterval(load, 15000);
</script>
</body></html>
