<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]; }); }
var HDR = {'X-Requested-With':'bb64', 'Content-Type':'application/json'};
function asJson(r){ return r.json().then(function(j){
  if(!r.ok) throw new Error(j && j.error ? j.error : ('HTTP ' + r.status)); return j; }); }
function get(url){ return fetch(url, {cache:'no-store'}).then(asJson); }
function post(url, body){ return fetch(url, {method:'POST', headers:HDR, cache:'no-store',
  body:JSON.stringify(body || {})}).then(asJson); }
function showErr(e){ var el = document.getElementById('err');
  el.textContent = String(e && e.message || e); el.hidden = false; }
function clearErr(){ document.getElementById('err').hidden = true; }

// The prefixes bb-doctor prints, and bb-health's three words. A line that
// matches none of them is shown plain: a change of wording in a tool degrades
// to monochrome and never hides output. This is the one contract between the
// page and the tools, and it is a soft one on purpose.
function cls(line){
  if(line.indexOf('  [ ok ] ') === 0) return 'ok';
  if(line.indexOf('  [warn] ') === 0) return 'warn';
  if(line.indexOf('  [FAIL] ') === 0) return 'fail';
  if(line.indexOf('         -> fixed: ') === 0) return 'fixed';
  if(line.indexOf('         ') === 0) return 'note';
  if(line.indexOf('-----') === 0) return 'rule';
  if(line === 'OK') return 'ok';
  if(line.indexOf('HANG') === 0 || line.indexOf('WEDGE') === 0 || line.indexOf('FROZEN') === 0) return 'fail';
  if(line.length && line.charAt(0) !== ' ') return 'heading';
  return '';
}
function fmtBytes(n){ if(n == null) return ''; if(n < 1024) return n + ' B';
  if(n < 1048576) return (n/1024).toFixed(0) + ' KB'; return (n/1048576).toFixed(1) + ' MB'; }
function fmtWhen(epoch){ try { return new Date(epoch*1000).toLocaleString(); } catch(e){ return ''; } }
function stamp(){ var d = new Date(), p = function(n){ return (n < 10 ? '0' : '') + n; };
  return '' + d.getFullYear() + p(d.getMonth()+1) + p(d.getDate()) + p(d.getHours()) + p(d.getMinutes()); }

var TOOLS = {};   // name -> descriptor from manage/tools
var JOBS = {};    // name -> the job shown for that tool

function renderTool(t){
  var opts = t.options.map(function(o){
    return '<label class="opt"><input type="checkbox" id="opt-' + esc(t.name) + '-' + esc(o.key) +
           '" data-tool="' + esc(t.name) + '"' + (t.available ? '' : ' disabled') + '> <span><code>' +
           esc(o.flag) + '</code> ' + esc(o.label) + '<br><span class="dim">' + esc(o.does) +
           '</span></span></label>';
  }).join('');
  var n = esc(t.name);
  // Two shapes. A tool whose whole output is a verdict (bb-health) shows it in
  // the card with a mark. The others get an output box that can be hidden, and
  // Copy and Download for taking the text elsewhere. Both can be cleared.
  var buttons = t.inline
    ? '<button class="ghost" data-clear="' + n + '" hidden>Clear result</button>'
    : '<button class="ghost" data-copy="' + n + '" hidden>Copy</button>' +
      '<button class="ghost" data-dl="' + n + '" hidden>Download</button>' +
      '<button class="ghost" data-toggle="' + n + '" hidden>Hide output</button>' +
      '<button class="ghost" data-clear="' + n + '" hidden>Clear result</button>';
  var body = t.inline ? '<div class="verdict" id="v-' + n + '" hidden></div>'
                      : '<pre id="out-' + n + '" hidden></pre>';
  return '<div class="panel" id="t-' + n + '">' +
    '<h2>' + esc(t.label) + '</h2><p class="dim">' + esc(t.does) + '</p>' + opts +
    '<div class="row">' +
      '<button data-run="' + n + '"' + (t.available ? '' : ' disabled') + '>Run</button>' + buttons +
      '<span class="status" id="st-' + n + '">' + (t.available ? '' : 'not in this image') + '</span>' +
    '</div>' + body + '</div>';
}

var COLLAPSED = {};   // tool -> the user hid its output box

// The mark for a finished verdict: a tick when the tool exited clean, a cross
// when it reported a fault, a warning sign when it could not run at all.
function mark(j){
  if(j.state === 'running') return ['run', '&#8230;', 'running'];
  if(j.state === 'failed') return ['warn', '&#9888;', j.result || 'could not run'];
  if(j.exit_code === 0) return ['ok', '&#10003;', j.result];
  return ['fail', '&#10007;', j.result];
}

function renderInline(name, j){
  var v = document.getElementById('v-' + name);
  var m = mark(j), lines = j.lines || [];
  var head = lines.length ? lines[0] : (j.state === 'running' ? 'Checking' : m[2]);
  var rest = lines.slice(1).join('\\n').replace(/^\\s+|\\s+$/g, '');
  v.innerHTML = '<span class="mark ' + m[0] + '" aria-label="' + esc(m[2]) + '">' + m[1] + '</span>' +
    '<div><strong class="' + (m[0] === 'run' ? '' : m[0]) + '">' + esc(head) + '</strong>' +
    (rest ? '<div class="detail">' + esc(rest) + '</div>' : '') + '</div>';
  v.hidden = false;
}

function renderOut(name){
  var j = JOBS[name]; if(!j) return;
  var t = TOOLS[name] || {};
  var running = j.state === 'running';
  var box = document.getElementById('t-' + name);
  var has = !!(j.lines && j.lines.length);
  if(t.inline){
    renderInline(name, j);
  } else {
    var pre = document.getElementById('out-' + name);
    var follow = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 4;
    pre.innerHTML = (j.lines || []).map(function(l){
      var c = cls(l); return c ? '<span class="' + c + '">' + esc(l) + '</span>' : esc(l);
    }).join('\\n') + (j.truncated ? '\\n<span class="warn">[output truncated]</span>' : '');
    // A fresh run reopens a box the user had hidden; there is new output to see.
    if(running) COLLAPSED[name] = false;
    pre.hidden = !!COLLAPSED[name];
    if(!pre.hidden && (follow || running)) pre.scrollTop = pre.scrollHeight;
    var tg = box.querySelector('[data-toggle]');
    tg.hidden = !has;
    tg.textContent = COLLAPSED[name] ? 'Show output' : 'Hide output';
    box.querySelector('[data-copy]').hidden = running || !has;
    box.querySelector('[data-dl]').hidden = running || !has;
  }
  var st = document.getElementById('st-' + name);
  st.textContent = (running ? 'running, ' + j.elapsed + 's' : j.result + ', ' + j.elapsed + 's') +
                   (j.command && !t.inline ? '  (' + j.command + ')' : '');
  box.querySelector('[data-run]').disabled = running;
  box.querySelector('[data-clear]').hidden = running;
}

function toggleOut(name){
  COLLAPSED[name] = !COLLAPSED[name];
  renderOut(name);
}

// Drops the result from the page and from the service, so a reload does not
// bring it back. A run in progress is left to finish.
function clearOut(name){
  clearErr();
  post('manage/tools/clear/' + name, {}).then(function(){
    delete JOBS[name];
    var box = document.getElementById('t-' + name);
    var pre = document.getElementById('out-' + name), v = document.getElementById('v-' + name);
    if(pre){ pre.hidden = true; pre.innerHTML = ''; }
    if(v){ v.hidden = true; v.innerHTML = ''; }
    ['copy', 'dl', 'toggle', 'clear'].forEach(function(k){
      var b = box.querySelector('[data-' + k + ']'); if(b) b.hidden = true; });
    document.getElementById('st-' + name).textContent = '';
  }).catch(showErr);
}

function poll(name, jid){
  get('manage/tools/job/' + jid).then(function(st){
    JOBS[name] = st; renderOut(name);
    if(st.state === 'running') setTimeout(function(){ poll(name, jid); }, 1000);
  }).catch(showErr);
}

function run(name){
  var t = TOOLS[name]; if(!t) return;
  var opts = [], ask = null;
  t.options.forEach(function(o){
    var cb = document.getElementById('opt-' + name + '-' + o.key);
    if(cb && cb.checked){ opts.push(o.key); if(o.confirm) ask = o.confirm; }
  });
  // The confirmation is the option's own text, which names what can change.
  if(ask && !window.confirm(ask)) return;
  clearErr();
  post('manage/tools/' + name, {options: opts}).then(function(st){
    JOBS[name] = st; renderOut(name);
    if(st.state === 'running') setTimeout(function(){ poll(name, st.id); }, 1000);
  }).catch(showErr);
}

function outText(name){ var j = JOBS[name]; return j && j.lines ? j.lines.join('\\n') + '\\n' : ''; }
function copyOut(name){
  var txt = outText(name), st = document.getElementById('st-' + name);
  function done(){ var keep = st.textContent; st.textContent = 'copied'; setTimeout(function(){ st.textContent = keep; }, 1200); }
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done, function(){ fallback(); });
  } else { fallback(); }
  function fallback(){
    var ta = document.createElement('textarea'); ta.value = txt; ta.setAttribute('readonly', '');
    ta.style.position = 'fixed'; ta.style.left = '-1000px'; document.body.appendChild(ta);
    ta.select(); try { document.execCommand('copy'); done(); } catch(e){} document.body.removeChild(ta);
  }
}
function dlOut(name){
  var blob = new Blob([outText(name)], {type:'text/plain'});
  var a = document.createElement('a'); a.href = URL.createObjectURL(blob);
  a.download = (TOOLS[name] ? TOOLS[name].label : name) + '-' + stamp() + '.txt';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(a.href); }, 1000);
}

// ---- diagnostic bundles ----
function setRepStatus(st){
  var el = document.getElementById('rep-status'), btn = document.getElementById('rep-run');
  if(!st){ el.textContent = ''; btn.disabled = false; return; }
  if(st.state === 'running'){ el.textContent = 'building, ' + Math.max(0, Math.floor(Date.now()/1000 - st.started)) + 's'; btn.disabled = true; }
  else if(st.state === 'done'){ el.textContent = 'built ' + (st.name || ''); btn.disabled = false; }
  else { el.textContent = 'failed: ' + (st.error || 'unknown'); btn.disabled = false; }
}
function renderBundles(list){
  var rows = document.getElementById('rep-rows');
  document.getElementById('rep-table').hidden = !(list && list.length);
  document.getElementById('rep-none').hidden = !!(list && list.length);
  rows.innerHTML = (list || []).map(function(b){
    return '<tr><td class="name">' + esc(b.name) + '</td><td>' + esc(fmtBytes(b.size_bytes)) +
           '</td><td>' + esc(fmtWhen(b.modified)) + '</td><td class="act">' +
           '<a href="manage/report/download/' + encodeURIComponent(b.name) + '">Download</a>' +
           '<button class="ghost" data-del="' + esc(b.name) + '">Delete</button></td></tr>';
  }).join('');
}
function loadReport(){
  return get('manage/report').then(function(j){
    if(j.available === false){ document.getElementById('rep-run').disabled = true;
      document.getElementById('rep-status').textContent = 'not in this image'; }
    renderBundles(j.bundles);
    if(j.running) pollReport(j.running); else if(!j.running && document.getElementById('rep-run').disabled && j.available !== false) setRepStatus(null);
  }).catch(showErr);
}
function pollReport(jid){
  get('manage/report/job/' + jid).then(function(st){
    setRepStatus(st);
    if(st.state === 'running') setTimeout(function(){ pollReport(jid); }, 1500);
    else loadReport();
  }).catch(showErr);
}
function buildReport(){
  clearErr();
  post('manage/report', {}).then(function(st){
    setRepStatus(st);
    if(st.state === 'running') setTimeout(function(){ pollReport(st.job); }, 1500);
    else loadReport();
  }).catch(showErr);
}
function delBundle(name){
  if(!window.confirm('Delete ' + name + '? This cannot be undone.')) return;
  clearErr();
  post('manage/report/delete', {name: name}).then(function(j){ renderBundles(j.bundles); }).catch(showErr);
}

document.addEventListener('click', function(e){
  var t = e.target; if(!t || !t.getAttribute) return;
  if(t.getAttribute('data-run')) return run(t.getAttribute('data-run'));
  if(t.getAttribute('data-copy')) return copyOut(t.getAttribute('data-copy'));
  if(t.getAttribute('data-dl')) return dlOut(t.getAttribute('data-dl'));
  if(t.getAttribute('data-toggle')) return toggleOut(t.getAttribute('data-toggle'));
  if(t.getAttribute('data-clear')) return clearOut(t.getAttribute('data-clear'));
  if(t.getAttribute('data-del')) return delBundle(t.getAttribute('data-del'));
});
document.getElementById('rep-run').addEventListener('click', buildReport);
document.getElementById('rep-refresh').addEventListener('click', loadReport);

// Digits switch the shell's tabs from inside this frame; the shell owns them.
document.addEventListener('keydown', function(e){
  var tg = e.target && e.target.tagName;
  if(tg === 'INPUT' || tg === 'SELECT' || tg === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;
  if(e.key >= '1' && e.key <= '5' && window.parent !== window) window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
});
try {
  var th = localStorage.getItem('bbMonitorTheme');
  if(th) document.documentElement.setAttribute('data-theme', th);
} catch(e){}

get('manage/tools').then(function(j){
  document.getElementById('build').textContent = j.build ? 'Build ' + j.build : '';
  var box = document.getElementById('tools');
  box.innerHTML = j.tools.map(function(t){ TOOLS[t.name] = t; return renderTool(t); }).join('');
  // A run that is still going, or the last one finished, so a reload does not
  // lose what the tool said.
  j.tools.forEach(function(t){ if(t.running || t.last_job) poll(t.name, t.running || t.last_job); });
}).catch(showErr);
loadReport();
// A link from the Status tab can ask for a bundle straight away.
try { if(new URLSearchParams(location.search).get('run') === 'report') buildReport(); } catch(e){}
</script>
</body></html>
"""


def api_v1_payload(d):
    """The /api/v1/status contract.

    Built from the raw gather() dict rather than from the display payload, and
    deliberately field by field. Two reasons. The display payload is the web
    page's internal shape and would become a contract the moment it shipped, and
    it carries pre-formatted strings ("19.5 TB", "3 days") which are the wrong
    thing to hand a consumer that wants to graph a number or format for its own
    locale. Bytes are bytes and seconds are seconds here.

    Everything the monitor knows is here. What names a file is grouped under
    "files" so it can be withheld from a key without read:files; see
    strip_file_names().
    """
    b = d.get("backup") or {}
    act = d.get("activity") or {}
    sc = d.get("scan") or {}
    mem, swap = d.get("mem"), d.get("swap")
    us = d.get("upload_success")

    def gauge(t):
        if not t:
            return None
        used, total, pct = t
        return {"used_bytes": used, "total_bytes": total, "pct": round(pct, 2)}

    files = []
    for name, part, fsize, pct, parts in (d.get("files") or []):
        row = {"name": name, "pct": round(pct, 1),
               "size_bytes": fsize or None, "part_bytes": part or None}
        if parts:
            row["parts"] = {"done": parts[0], "total": parts[1]}
        files.append(row)

    recent = []
    for r in (d.get("recent") or []):
        row = {"name": r["name"], "time": r["t"], "chunked": bool(r["chunked"])}
        if r["chunked"]:
            row.update(parts={"done": min(r["done"], r["total"]), "total": r["total"]},
                       bytes=r["bytes"], seconds=max(0, r["last"] - r["first"]))
        elif r.get("small"):
            # Caught from the client naming it, not from a transfer record, so
            # there is no thread, size or rate to report.
            row.update(measured=False)
        else:
            row.update(thread=r["thr"], bytes=r["bytes"], seconds=r["secs"],
                       kbit_per_sec=r["kbit"], measured=True)
        recent.append(row)

    cm = d.get("chunkmap")
    return {
        "schema": bbapi.SCHEMA,
        "ok": True,
        "build": BUILD_LABEL,
        "time": int(time.time()),
        "poll_interval_seconds": INT,
        "state": d.get("state"),
        "paused": (d.get("pause") or {}).get("paused", False),
        "pause": d.get("pause"),
        # The same pause as words, so a consumer can show a reason without
        # keeping its own table of the client's codes.
        "pause_label": d.get("pause_label"),
        "activity": {"phase": act.get("phase"), "file": act.get("file"),
                     "part": act.get("part"), "internal": act.get("internal")} if act else None,
        "threads": d.get("threads"),
        "rate_bytes_per_sec": int(d.get("rate", 0) * 1048576) if d.get("rate") else 0,
        "session_bytes": d.get("sess"),
        "chunks_last_minute": d.get("chunks"),
        "uptime_seconds": int(time.time() - bbdata.START_TIME),
        "memory": gauge(mem),
        "memory_by_process": d.get("memory_by_process"),
        "swap": gauge(swap),
        "backup": {"done_bytes": b.get("done"), "total_bytes": b.get("total"),
                   "pct": round(b["pct"], 2) if b.get("pct") is not None else None,
                   "done_files": b.get("done_files"), "total_files": b.get("total_files"),
                   "remaining_files": b.get("remaining_files"),
                   "eta_seconds": b.get("eta_seconds"),
                   # Seconds stay the contract; the date is added alongside so a
                   # consumer that only wants to print "when" need not reimplement
                   # the day-resolution rounding the monitor already applies.
                   "eta_date": bbdata.eta_date(b.get("eta_seconds")),
                   "eta_samples": b.get("eta_samples", 0)} if b else None,
        "scan": {"dirs_done": sc.get("dirs_done"), "dirs_total": sc.get("dirs_total"),
                 "pct": round(sc["pct"], 2) if sc.get("pct") is not None else None,
                 "files": sc.get("files"), "bytes": sc.get("bytes")} if sc else None,
        "health": [{"kind": k, "text": t} for k, t in (d.get("health") or [])],
        "skipped_files": d.get("skipped"),
        # The counts above say how many were given up on; this names them. It is
        # kept at the top level rather than under "files" because it is a
        # different question -- what is not backed up, rather than what is moving
        # -- but it names files just the same, so strip_file_names() drops it for
        # a key without read:files.
        "skipped_list": d.get("skipped_list"),
        "last_backup_days": d.get("last_backup_days"),
        "first_backup": d.get("first_backup"),
        "latency": {"ms": d.get("latency_ms"), "host": d.get("latency_host"),
                    "note": d.get("latency_note")},
        "upload_pod": d.get("upload_pod"),
        "compress_saved_bytes": d.get("compress_saved"),
        # Backblaze's own measurement, not ours.
        "client_measured_kbit": d.get("perf"),
        # "failures" kept for the schema promise; they are retried attempts,
        # not files. The reasons breakdown says so in the data itself.
        "uploads_today": ({"success": us[0], "failures": us[1],
                           "retried_attempts": us[1], "reasons": us[2]}
                          if us else None),
        # uploads_today is one row of this; both stay, because a consumer already
        # reading uploads_today must not have to change to keep working. "day" is
        # null on any row whose date the client did not record.
        "upload_history": d.get("upload_history"),
        # Present only while the first completion is recent, null the rest of the
        # time, so a consumer can treat its arrival as the event itself.
        "completion": d.get("completion"),
        # Quarter, half, three quarters and the first terabyte, each present for a
        # week after it is passed, so its arrival can be treated as the event.
        "milestones": d.get("milestones"),
        # One sample a day of percent complete, oldest first, for plotting.
        "progress_history": d.get("progress_history"),
        # What the set is made of, from the client's own category totals. Counts
        # only: the client does not break its byte total down the same way, so a
        # per-category size would have to be invented rather than reported.
        "composition": d.get("composition"),
        # The date this backup began, YYYYMMDD, which is exactly the resolution
        # the client records it at. Not an epoch, because turning a calendar day
        # into a timestamp would have to pick a time of day that was never known.
        "backing_up_since": d.get("backing_up_since"),
        # Whether the ETA is improving or worsening against the last day
        # recorded, with the signed difference in seconds.
        "eta_trend": d.get("eta_trend"),
        "files": {
            "in_flight": files,
            "recent": recent,
            "chunk_map": ({"file": cm["file"], "total": cm["total"],
                           "sent": cm["sent"], "in_flight": cm["inflight"]}
                          if cm else None),
        },
    }


# What names a file the user is backing up. A key without read:files gets status
# without any of it: a dashboard tile showing rate, progress, memory and latency
# has no need for the name of every file on the array.
def strip_file_names(payload):
    out = dict(payload)
    out["files"] = None
    # Every entry in the skipped list is a full path on the source share, which
    # names the file just as plainly as the in-flight list does. The counts in
    # skipped_files stay: they say how much is not backed up without saying what.
    out["skipped_list"] = None
    act = out.get("activity")
    if act:
        act = dict(act)
        act["file"] = None
        out["activity"] = act
    return out


def _loop():
    prev = None
    while True:
        try:
            d = gather(prev)
            prev = d["_tx"]
            js = snapshot_to_json(d)
            # snapshot_to_json fills in latency and the pod, which gather() does
            # not carry, so the API payload is built from the enriched view.
            d.setdefault("latency_ms", js.get("latency_ms"))
            d.setdefault("latency_host", js.get("latency_host"))
            d.setdefault("latency_note", js.get("latency_note"))
            d.setdefault("upload_pod", js.get("upload_pod"))
            api = api_v1_payload(d)
        except Exception as e:
            js = {"ok": False, "error": str(e), "about": ABOUT}
            # schema is on every response, including this one: a consumer that
            # reads it first must not break precisely when collection fails.
            api = {"schema": bbapi.SCHEMA, "ok": False, "error": str(e)}
        with _lock:
            global _latest, _latest_api
            _latest = js
            _latest_api = api
        _after_snapshot(api)
        time.sleep(INT)


# ---- observers fed by the poll loop -----------------------------------------
# State transitions for the Status tab's timeline, the notifier, the quiet-hours
# scheduler, and the wake-up for anyone holding an events stream. All of them
# see the API payload, which is the contract, so what they react to is what a
# consumer would see.
_timeline = []                     # [(epoch, state)], newest last, 24 hours
_timeline_lock = threading.Lock()
_events_cv = threading.Condition()
_events_seq = 0
_quiet = bbquiet.Scheduler(bbctl.run)
_WATCHED = ("state", "paused")


def _after_snapshot(api):
    global _events_seq
    if not api or not api.get("ok"):
        return
    now = time.time()
    changed = False
    with _timeline_lock:
        if not _timeline or _timeline[-1][1] != api.get("state"):
            _timeline.append((int(now), api.get("state")))
            changed = True
        while _timeline and now - _timeline[0][0] > 86400:
            _timeline.pop(0)
    try:
        if bbnotify.observe(api):
            changed = True
    except Exception as exc:                   # a notifier fault must not stop the poll
        sys.stderr.write("bb-monitor-web: notify: %s\n" % exc)
    try:
        _quiet.observe(api)
    except Exception as exc:
        sys.stderr.write("bb-monitor-web: quiet hours: %s\n" % exc)
    # Wake the events streams on any state change, or every poll when something
    # they watch moved; they compare and decide for themselves.
    with _events_cv:
        _events_seq += 1
        _events_cv.notify_all()


def timeline():
    with _timeline_lock:
        return [{"at": t, "state": st} for t, st in _timeline]


def summary_text(api):
    """The status as five lines of plain text, for pasting into a support thread.
    Nothing in it names a file."""
    if not api or not api.get("ok"):
        return "Backblaze 64 %s: monitor not ready (%s)\n" % (api.get("build") if api else "?",
                                                              (api or {}).get("error"))
    b = api.get("backup") or {}
    lat = api.get("latency") or {}
    rate = api.get("rate_bytes_per_sec") or 0
    parts = ["Backblaze 64 %s, up %s" % (api.get("build"), uptime_str())]
    st = api.get("state") or "?"
    pl = api.get("pause_label")
    if pl:
        st += " (%s%s)" % (pl["title"].lower(), (", until " + pl["until_str"]) if pl.get("until_str") else "")
    line = "State: %s, %.1f Mbit/s, %s threads" % (st, rate * 8 / 1e6, api.get("threads"))
    if lat.get("ms") is not None:
        line += ", RTT %.0f ms" % lat["ms"]
    parts.append(line)
    if b.get("total_bytes"):
        line = "Backup: %s%% of %s" % (b.get("pct"), human(b["total_bytes"]))
        if b.get("total_files"):
            line += ", %s files" % ("%.1fM" % (b["total_files"] / 1e6) if b["total_files"] >= 1e6
                                     else "{:,}".format(b["total_files"]))
        if b.get("eta_date"):
            line += ", ETA %s" % b["eta_date"]
            tr = api.get("eta_trend")
            if tr and tr.get("direction") in ("better", "worse"):
                line += " (%dd %s than yesterday)" % (abs(tr.get("delta_seconds", 0)) // 86400, tr["direction"])
        parts.append(line)
    sc = api.get("scan")
    if sc and sc.get("pct") is not None:
        parts.append("Scan: %s%% of directories, %s files found" % (sc["pct"], sc.get("files")))
    health = [h["text"] for h in (api.get("health") or [])]
    parts.append("Health: " + ("; ".join(health) if health else "no warnings"))
    up = api.get("uploads_today")
    if up:
        parts.append("Today: %s uploads, %s retried" % (up.get("success"), up.get("retried_attempts")))
    return "\n".join(parts) + "\n"


def metrics_text(api):
    """Prometheus text exposition of the numbers in the status payload."""
    out = []
    def g(name, value, help_, labels=""):
        if value is None:
            return
        out.append("# HELP bb64_%s %s" % (name, help_))
        out.append("# TYPE bb64_%s gauge" % name)
        out.append("bb64_%s%s %s" % (name, labels, value))
    if not api or not api.get("ok"):
        g("up", 0, "1 when the monitor has a snapshot")
        return "\n".join(out) + "\n"
    g("up", 1, "1 when the monitor has a snapshot")
    g("rate_bytes_per_second", api.get("rate_bytes_per_sec"), "Upload rate over the last minute")
    g("threads", api.get("threads"), "Push threads in flight")
    g("paused", 1 if api.get("paused") else 0, "1 while the backup is paused")
    g("chunks_last_minute", api.get("chunks_last_minute"), "Chunks completed in the last minute")
    g("uptime_seconds", api.get("uptime_seconds"), "Seconds since the monitor started")
    b = api.get("backup") or {}
    g("backup_done_bytes", b.get("done_bytes"), "Bytes the client reports as backed up")
    g("backup_total_bytes", b.get("total_bytes"), "Bytes selected for backup")
    g("backup_pct", b.get("pct"), "Percent of the selection backed up")
    g("backup_remaining_files", b.get("remaining_files"), "Files still to send")
    g("backup_eta_seconds", b.get("eta_seconds"), "Estimated seconds to catch up")
    sc = api.get("scan") or {}
    g("scan_pct", sc.get("pct"), "Percent of directories indexed in the current scan")
    m = api.get("memory") or {}
    g("memory_used_bytes", m.get("used_bytes"), "Container memory in use")
    g("memory_total_bytes", m.get("total_bytes"), "Container memory limit or host total")
    sw = api.get("swap") or {}
    g("swap_used_bytes", sw.get("used_bytes"), "Swap in use")
    lat = api.get("latency") or {}
    g("upload_rtt_milliseconds", lat.get("ms"), "Smoothed round-trip time to the upload pod")
    sk = api.get("skipped_files") or {}
    g("skipped_files", sk.get("total", 0) if sk else 0, "Files the client has given up on")
    kinds = {h["kind"] for h in (api.get("health") or [])}
    for k in ("frozen", "filecheck", "stale", "skipped"):
        g("health_warning", 1 if k in kinds else 0, "1 while this warning is raised", '{kind="%s"}' % k)
    up = api.get("uploads_today") or {}
    g("uploads_today", up.get("success"), "Successful uploads recorded today")
    g("upload_retries_today", up.get("retried_attempts"), "Attempts a vault turned away today")
    g("compress_saved_bytes", api.get("compress_saved_bytes"), "Bytes saved by compression")
    g("last_backup_days", api.get("last_backup_days"), "Days since a backup pass completed")
    return "\n".join(out) + "\n"


