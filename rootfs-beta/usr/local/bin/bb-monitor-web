<script>
function pctClass(pct, invert){
  // invert=true: higher is worse (mem/swap gauges). invert=false: higher is better (rate).
  if(invert) return pct>=90?'bad':(pct>=70?'warn':'');
  return '';
}
var rateHistory = [];
function sparklineSvg(values, w, h){
  if(values.length < 2) return '';
  var max = Math.max(0.05, Math.max.apply(null, values));
  var stepX = w / (values.length - 1);
  var pts = values.map(function(v, i){
    var x = i * stepX;
    var y = h - (Math.min(v, max) / max) * (h - 1) - 0.5;
    return x.toFixed(1) + ',' + y.toFixed(1);
  }).join(' ');
  return '<svg class="spark" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none">' +
         '<polyline points="'+pts+'" /></svg>';
}
function chunkStrip(cm){
  // Real chunk positions: each cell is a numbered chunk of the file currently
  // being split, lit where that chunk has been seen to finish and highlighted
  // where a thread is carrying it now. Cells never observed stay dim, because
  // a chunk that completed before the page was opened cannot be distinguished
  // from one still queued.
  if(!cm || !cm.total) return '';
  var sent = new Set(cm.sent||[]), busy = new Set(cm.inflight||[]), cells = '';
  for(var i=0;i<cm.total;i++){
    var c = busy.has(i) ? ' busy' : (sent.has(i) ? ' on' : '');
    cells += '<span class="cell'+c+'" title="chunk '+i+'"></span>';
  }
  return '<div class="file-row cells chunkstrip"><div class="track">'+cells+'</div>' +
         '<div class="meta"><span>'+sent.size+'/'+cm.total+' chunks</span>' +
         '<span>'+esc(cm.file)+'</span></div></div>';
}
function pingHtml(d){
  // TCP handshake time, not ICMP. The tooltip names the host actually measured:
  // with no upload running this falls back to the public site, which can be a
  // CDN edge and read far lower than the real storage pod.
  if(d.latency_ms == null){
    // The note says which of the several reasons applies, so n/a is never a
    // mystery: nothing uploading, no netlink, or a locally-terminated connection.
    var why = d.latency_note ? esc(d.latency_note)
                              : 'measured only while an upload is running';
    return '<span class="stat dim" title="RTT: '+why+'">RTT: n/a</span>';
  }
  var tip = ' title="TCP handshake to ' + esc(d.latency_host) +
            ', the pod your uploads are using (not ICMP)"';
  var cls = d.latency_ms < 80 ? 'good' : (d.latency_ms < 200 ? 'warn' : 'bad');
  return '<span class="stat"'+tip+'>RTT: <span class="'+cls+'">' +
         Math.round(d.latency_ms) + 'ms</span></span>';
}
function gaugeHtml(label, g, highIsGood, extra, suffix){
  if(!g) return '<span class="stat">'+label+': n/a</span>';
  var cls = highIsGood
    ? (g.pct>=67 ? '' : (g.pct>=34 ? 'warn' : 'bad'))
    : (g.pct>=90 ? 'bad' : (g.pct>=70 ? 'warn' : ''));
  var tip = extra ? ' title="'+extra+'"' : '';
  var suf = suffix ? ' <span class="dim">'+suffix+'</span>' : '';
  return '<span class="stat gauge '+cls+'"'+tip+'>'+label+': '+esc(g.used_str)+'/'+esc(g.total_str)+
         ' <span class="track"><span class="fill" style="width:'+Math.min(100,g.pct)+'%"></span></span> '+g.pct+'%'+suf+'</span>';
}
// The week of daily upload counts as a bar strip beside today's figure, scaled
// to the busiest day so the shape of the week reads the same whether the client
// is moving thousands of files a day or dozens. A single day is not a trend, so
// anything shorter than two rows draws nothing rather than one bar that implies
// one. Inline styles rather than a class because the bar heights are data.
function uploadStripHtml(hist){
  if(!hist || hist.length < 2) return '';
  var max = hist.reduce(function(m, r){ return Math.max(m, r.success || 0); }, 0);
  if(max <= 0) return '';
  var tip = hist.map(function(r, i){
    // The client does not always record the date on a row, so one without it is
    // named by where it sits in the run instead of being left out of the list.
    var when = (r.day && r.day.length === 8)
      ? r.day.slice(0, 4) + '-' + r.day.slice(4, 6) + '-' + r.day.slice(6, 8)
      : 'day ' + (i + 1);
    return esc(when + ': ' + (r.success || 0).toLocaleString() + ' uploads');
  }).join('&#10;');
  var bars = hist.map(function(r){
    // A floor of two pixels so a quiet day still reads as a day that happened
    // rather than as a gap in the strip.
    var h = Math.max(2, Math.round((r.success || 0) / max * 14));
    return '<span style="display:inline-block;width:4px;margin-right:2px;height:' + h + 'px;' +
           'background:var(--good);vertical-align:bottom"></span>';
  }).join('');
  return '<span class="stat" title="' + tip + '">' +
         '<span style="display:inline-block;height:14px;line-height:0;' +
         'vertical-align:middle">' + bars + '</span>' +
         ' <span style="color:var(--dim)">' + hist.length + 'd</span></span>';
}
// A count in the hundreds of thousands cannot be read at a glance in full, and
// the status row is meant to be glanced at. One decimal from a million up,
// because 1.0M and 1.9M are a real difference; none at the thousand mark,
// because 75k and 75.3k are not. The exact figure lives in the tooltip.
function fmtCount(n){
  if(n == null) return '';
  if(n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
  if(n >= 1000) return Math.round(n / 1000) + 'k';
  return String(n);
}
// What the set is made of, beside how much of it is left. The order is fixed
// rather than sorted by size so the line reads the same shape from one poll to
// the next, and only the categories the client actually counted are drawn: the
// data layer omits the empty ones rather than sending zeroes.
var COMP_ORDER = [['photos','photos'],['documents','docs'],['music','music'],
                  ['video','video'],['other','other']];
function compositionHtml(c){
  if(!c || !c.categories) return '';
  var parts = [], tips = [];
  COMP_ORDER.forEach(function(p){
    var n = c.categories[p[0]];
    if(!n) return;
    parts.push(fmtCount(n) + ' ' + p[1]);
    tips.push(esc(n.toLocaleString() + ' ' + p[0]));
  });
  if(!parts.length) return '';
  // The newline in the tooltip is written as a character entity rather than as
  // a backslash escape. This whole script is inside a Python triple-quoted
  // string, so a backslash-n here would be turned into a real line break before
  // the browser ever saw it, which would end the JavaScript string in mid-air.
  var tip = esc(c.files.toLocaleString() + ' files in total') + '&#10;' +
            tips.join('&#10;');
  return '<span class="stat dim wraps" title="' + tip + '">' +
         esc(fmtCount(c.files)) + ' files: ' + esc(parts.join(' • ')) + '</span>';
}
// An estimate says more against yesterday's than on its own, so the gauge
// carries the change as well as the figure. The arrow and the colour are both
// redundant with the words "better" and "slower" on purpose: a reader who
// cannot tell the good colour from the bad one still gets the answer.
function etaTrendHtml(t){
  if(!t || t.direction === 'steady') return '';
  var secs = Math.abs(t.delta_seconds || 0);
  var span = secs < 86400 ? (Math.round(secs / 3600) + 'h')
                          : (Math.round(secs / 86400) + 'd');
  var better = t.direction === 'improving';
  return ' <span style="color:var(--' + (better ? 'good' : 'bad') + ')">' +
         (better ? '▾ ' : '▴ ') + esc(span) +
         (better ? ' better' : ' slower') + '</span>';
}
// YYYYMMDD as the client records it, drawn as "1 Jun 2026". Parsed by hand
// rather than handed to Date(), which reads a bare digit string as UTC and can
// therefore show the day before the one the client wrote down.
var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function fmtDay(s){
  if(!s || String(s).length !== 8) return '';
  s = String(s);
  var m = parseInt(s.slice(4, 6), 10), day = parseInt(s.slice(6, 8), 10);
  if(!(m >= 1 && m <= 12) || !(day >= 1 && day <= 31)) return '';
  return day + ' ' + MONTHS[m - 1] + ' ' + s.slice(0, 4);
}
// The error strip belongs to the poll, which clears it every couple of seconds.
// A failed control call has to outlive that or it would never be read, so it is
// held for a few seconds and the poll is told to leave it alone until then.
var errHoldUntil = 0;
function showError(text){
  var el = document.getElementById('err');
  el.style.display = 'block';
  el.textContent = text;
  el.title = text;
  errHoldUntil = Date.now() + 6000;
}
var lastState = null;
var compactParts = false;
function updateFavicon(state){
  var cs = getComputedStyle(document.documentElement);
  var color = '#888888';
  if(state === 'Transmitting') color = cs.getPropertyValue('--good').trim() || '#3ddc6b';
  else if(state === 'Scanning' || state === 'Preparing') color = cs.getPropertyValue('--warn').trim() || '#ffd23d';
  var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
            '<circle cx="16" cy="16" r="13" fill="'+color+'" stroke="rgba(0,0,0,0.4)" stroke-width="2"/></svg>';
  var link = document.getElementById('favicon');
  if(link) link.href = 'data:image/svg+xml,' + encodeURIComponent(svg);
}
// Defined before first use by hoisting; called from every path that puts
// Backblaze-derived text into innerHTML. Filenames come off a Linux array
// mapped into Wine's drive-letter view, so they carry no guarantee of avoiding
// HTML-special characters the way native Windows names would.
function esc(s){
  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}
var aboutDone = false, aboutSince = null;
// The start date travels at the top level of the payload rather than inside
// about, because it describes this backup and not this build, so it is passed
// in as a second argument instead of being dug out of a.
// The state, and when paused, who paused it and until when. A bare "Paused" is
// the question; the label is the answer, and the client's own code sits in the
// tooltip for anyone searching Backblaze's help for it.
function stateHtml(d){
  var stateCls = d.state==='Transmitting' ? 'good' : (['Scanning','Preparing'].includes(d.state) ? 'warn' : '');
  var pl = d.pause_label;
  var tip = pl ? (pl.detail || '') + (pl.code ? ' [' + pl.code + ']' : '') : '';
  return '<span class="stat"' + (tip ? ' title="' + esc(tip) + '"' : '') + '>State: <span class="' + stateCls + '">' +
         esc(d.state) + '</span>' +
         (pl ? ' <span class="dim">(' + esc(pl.title.toLowerCase()) +
               (pl.until_str ? ', until ' + esc(pl.until_str) : '') + ')</span>' : '') + '</span>';
}
// The chart gives the shape of the week; this gives today's number.
function todayHtml(d){
  if(!d.upload_success) return '';
  var sk = d.skipped && d.skipped.total ? d.skipped.total : 0;
  return '<span class="stat dim" title="The client counts today: uploads that completed, attempts a busy vault turned away and the client retried, and files it has given up on.">Today: ' +
         d.upload_success[0].toLocaleString() + ' upload' + (d.upload_success[0] === 1 ? '' : 's') +
         (d.upload_success[1] ? ', ' + d.upload_success[1] + ' retried' : '') +
         ', ' + sk + ' skipped</span>';
}
// Percent complete by day, one sample a day, as a small line. After months of
// watching a bar, the line that shows it moving is the thing worth looking at.
function progressSvg(hist){
  if(!hist || hist.length < 2) return '';
  var w = 320, h = 90, padL = 30, padB = 16, padT = 6;
  var n = hist.length, iw = w - padL - 6, ih = h - padB - padT;
  var pts = hist.map(function(s, i){
    var x = padL + (i / (n - 1)) * iw, y = padT + (1 - Math.max(0, Math.min(100, s.pct)) / 100) * ih;
    return x.toFixed(1) + ',' + y.toFixed(1);
  }).join(' ');
  function day(s){ return s.slice(6, 8) + '/' + s.slice(4, 6); }
  return '<svg class="progress" viewBox="0 0 ' + w + ' ' + h + '" width="100%" height="' + h + '" role="img" aria-label="Progress over time">' +
    '<line x1="' + padL + '" y1="' + padT + '" x2="' + padL + '" y2="' + (h - padB) + '" class="axis"/>' +
    '<line x1="' + padL + '" y1="' + (h - padB) + '" x2="' + (w - 6) + '" y2="' + (h - padB) + '" class="axis"/>' +
    '<text x="' + (padL - 4) + '" y="' + (padT + 4) + '" text-anchor="end">100%</text>' +
    '<text x="' + (padL - 4) + '" y="' + (h - padB) + '" text-anchor="end">0%</text>' +
    '<polyline points="' + pts + '"/>' +
    '<text x="' + padL + '" y="' + (h - 3) + '">' + esc(day(hist[0].day)) + '</text>' +
    '<text x="' + (w - 6) + '" y="' + (h - 3) + '" text-anchor="end">' + esc(day(hist[n - 1].day)) + ' • ' + esc(hist[n - 1].pct) + '%</text>' +
    '</svg>';
}
var aboutHist = 0;
function renderAbout(a, since, hist){
  // Build metadata never changes while we run, so this normally draws once. The
  // exception is the date: the payload sent when collection fails still carries
  // about but has no backing_up_since, and latching on that first draw would
  // lose the row for the life of the page. So a date arriving later reopens it.
  var hl = hist ? hist.length : 0;
  if(aboutDone && (since == null || since === aboutSince) && hl === aboutHist) return;
  aboutDone = true;
  aboutSince = (since == null ? null : since);
  aboutHist = hl;
  var b = a.build || {}, rows = '';
  function row(k, v){ if(v) rows += '<dt>'+esc(k)+'</dt><dd>'+esc(v)+'</dd>'; }
  row('Version', b.version); row('Build', b.build);
  row('Revision', b.revision); row('Variant', b.variant); row('Built', b.built);
  row('Backing up since', fmtDay(since));
  var html =
    '<div class="asec" style="border-top:0;padding-top:0;margin-top:0">' +
      '<h3>'+esc(a.name)+' \u2022 '+esc(a.component)+'</h3>' +
      (rows ? '<dl class="adl">'+rows+'</dl>'
            : '<p class="fhint">No build stamp found (running outside a built image).</p>') +
    '</div>' +
    '<div class="asec"><h3>Licence</h3>' +
      '<div class="credit">'+esc(a.copyright)+'</div>' +
      '<div class="credit"><span class="what">'+esc(a.license)+'</span></div>' +
      '<div class="credit"><a href="'+esc(a.url)+'" target="_blank" rel="noopener noreferrer">'+esc(a.url)+'</a></div>' +
    '</div>';
  var ps = progressSvg(hist);
  if(ps) html += '<div class="asec"><h3>Progress</h3>' + ps +
                 '<p class="fhint">Percent complete, one sample a day, since the monitor started keeping them.</p></div>';
  if(a.credits && a.credits.length){
    html += '<div class="asec"><h3>With thanks to</h3>' +
      a.credits.map(function(c){
        return '<div class="credit"><span class="who">'+esc(c.who)+'</span> \u2014 ' +
               '<span class="what">'+esc(c.what)+'</span></div>';
      }).join('') + '</div>';
  }
  document.getElementById('pane-about').innerHTML = html;
}
// The page's own pause control. It posts to /manage/, which rides the same
// browser session that was allowed to load the page, so it needs no API key;
// the X-Requested-With header is the same-origin guard those endpoints require,
// and a cross-site form post cannot set it. The action name is one of two fixed
// strings chosen here, never anything typed or received.
var pauseBusy = false;
function wirePauseButton(){
  var btn = document.getElementById('pause-btn');
  btn.addEventListener('click', async function(){
    if(pauseBusy) return;
    pauseBusy = true;
    btn.disabled = true;
    var action = btn.getAttribute('data-action') === 'backup-now' ? 'backup-now' : 'pause';
    var verb = action === 'pause' ? 'pause the backup' : 'resume the backup';
    try{
      // Relative, like the status poll: the page is served under /monitor/ when
      // proxied and at the root standalone, and the prefix is stripped either way.
      const res = await fetch('manage/control/' + action,
                              {method:'POST', cache:'no-store',
                               headers:{'X-Requested-With':'bb64'}});
      var body = {};
      try { body = await res.json(); } catch(e){}
      if(!res.ok || !body.ok){
        showError('Could not ' + verb + ': ' +
                  (body.detail || body.error || ('HTTP ' + res.status)));
      }
    }catch(e){
      showError('Could not ' + verb + ': ' + e);
    }
    // Whatever happened, the button goes live again and the next poll two
    // seconds from now is what decides which label it carries.
    pauseBusy = false;
    btn.disabled = false;
  });
}
async function tick(){
  try{
    // Relative, so it resolves under /monitor/ when proxied and at / when standalone.
    const res = await fetch('api/status', {cache:'no-store'});
    const d = await res.json();
    if(d.about) renderAbout(d.about, d.backing_up_since, d.progress_history);   // before the ok check: About must work when collection is broken
    if(!d.ok){
      // No state read means no state to act on, so the control goes away rather
      // than sitting there offering to pause something we cannot see.
      document.getElementById('pause-btn').style.display = 'none';
      document.getElementById('err').style.display='block';
      document.getElementById('err').textContent = 'Waiting for data: ' + (d.error||'unknown');
      document.title = 'Backblaze 64 \u2022 Upload Monitor';
      return;
    }
    // A message from a failed control call is held for a few seconds; until it
    // expires the poll leaves the strip alone rather than wiping it unread.
    if(Date.now() >= errHoldUntil) document.getElementById('err').style.display='none';
    var pb = document.getElementById('pause-btn');
    pb.style.display = 'inline-block';
    // Nothing is set optimistically. While a request is in flight the label is
    // left as it was, and the next poll reports what the client actually did.
    if(!pauseBusy){
      // backup-now is Backblaze's own documented way out of a pause, which is
      // why resuming posts that rather than any unpause verb.
      pb.setAttribute('data-action', d.paused ? 'backup-now' : 'pause');
      pb.textContent = d.paused ? 'Resume backup' : 'Pause backup';
      pb.title = d.paused ? 'Ask the client to start a backup now'
                          : 'Ask the running backup to pause, cooperatively';
    }
    var hw = document.getElementById('health');
    if(d.health && d.health.length){
      hw.style.display = 'block';
      // The band is the headline; the Status tab has the detail and what to do.
      hw.innerHTML = '<a href="/?tab=status" target="_top" title="Open the Status tab">' +
        d.health.map(function(h){ return esc(h.text); }).join(' &bull; ') + '</a>';
    } else { hw.style.display = 'none'; }
    var cw = document.getElementById('completion');
    if(d.completion){
      // days comes from the first-pass counter, which the client drops the
      // moment it catches up. If the mark was written after that point the
      // count is zero, and "in 0 days" would be worse than saying nothing.
      var span = d.completion.days > 0
        ? ' in ' + esc(d.completion.days) + ' day' + (d.completion.days === 1 ? '' : 's')
        : '';
      cw.style.display = 'block';
      cw.innerHTML = 'First backup complete \u2014 ' + esc(d.completion.total_str) +
                     span + '.';
    } else { cw.style.display = 'none'; }
    document.getElementById('clock').textContent = d.clock;
    document.getElementById('build').textContent = d.build_label || '';
    document.getElementById('footer-server').textContent =
      d.upload_pod ? ('Upload server: ' + d.upload_pod) : '';
    document.getElementById('topbar-title').innerHTML =
      'Backblaze 64 \u2022 Upload Monitor' +
      (d.uptime ? '<span class="uptime"> \u2022 ' + esc(d.uptime) + '</span>' : '');

    rateHistory.push(d.rate_mb);
    if(rateHistory.length > 40) rateHistory.shift();

    document.title = 'BB64 \u2022 ' + d.rate_str + ' \u2022 ' + (d.backup ? d.backup.pct+'%' : d.state);
    lastState = d.state;
    updateFavicon(d.state);

    var rateCls = d.rate_mb>=1 ? 'good' : (d.rate_mb>0.05 ? 'warn' : 'bad');
    var stateCls = d.state==='Transmitting' ? 'good' : (['Scanning','Preparing'].includes(d.state) ? 'warn' : '');
    var grid = document.getElementById('status-grid');
    grid.innerHTML =
      '<span class="stat">Threads: '+d.threads+'</span>' +
      '<span class="stat" title="'+Math.round(d.rate_mb*1048576).toLocaleString()+' bytes per second">Up: <span class="'+rateCls+'">'+d.rate_str+'</span> ('+d.rate_mbit_str+')'+sparklineSvg(rateHistory,70,16)+'</span>' +
      '<span class="stat">Chunks/60s: '+d.chunks+'</span>' +
      '<span class="stat">Session: '+d.session_str+'</span>' +
      stateHtml(d) +
      pingHtml(d) +
      (d.scan ? '<span class="stat">Scanning: '+d.scan.dirs+' dirs \u2022 ' +
                esc((d.scan.files||0).toLocaleString())+' files' +
                (d.scan.size_str ? ' \u2022 '+esc(d.scan.size_str) : '') + '</span>' : '') +
      (d.first_backup ? '<span class="stat" title="A first upload works through the whole ' +
                'set once. Until it catches up, gaps between completed passes are expected.">' +
                'First backup: day '+d.first_backup.days+' \u2022 '+d.first_backup.pct+'%</span>' : '') +
      (d.upload_success ? '<span class="stat" title="Uploads the client recorded for ' +
                'the most recent day. Retries are attempts a busy storage vault turned ' +
                'away; the client tried another and the file still went up. Not lost ' +
                'files: for those, watch skipped files.">Uploads: ' +
                d.upload_success[0].toLocaleString() +
                (d.upload_success[1] ? ' <span class="dim">('+d.upload_success[1]+' retried)</span>' : '') +
                '</span>' : '') +
      uploadStripHtml(d.upload_history) +
      todayHtml(d) +
      (d.compress_saved ? '<span class="stat dim">Compression saved: '+esc(d.compress_saved)+'</span>' : '') +
      (d.perf ? '<span class="stat dim" title="Measured by the Backblaze client itself. ' +
                'Small files are slower because each costs a round trip.">Client est: ' +
                (d.perf.large_kbit/1000).toFixed(1)+' Mbit/s</span>' : '') +
      gaugeHtml('Mem', d.mem, false,
                d.memory_by_process && d.memory_by_process.length
                  ? 'Largest: ' + esc(d.memory_by_process[0].name) : '') +
      gaugeHtml('Swap', d.swap, false) +
      '<span class="stat">Files Remaining: '+(d.backup && d.backup.remaining_files!=null ? d.backup.remaining_files.toLocaleString() : 'n/a')+'</span>' +
      // What is left, then what the whole thing is made of, then how long it has
      // been running: the three sit together because they answer one question.
      compositionHtml(d.composition) +
      (fmtDay(d.backing_up_since) ? '<span class="stat dim" title="When this backup ' +
                'began, from the date the client recorded at install.">Backing up since: ' +
                esc(fmtDay(d.backing_up_since)) + '</span>' : '') +
      gaugeHtml('Backup', d.backup, true,
                d.backup ? (d.backup.files + ' \u2022 ETA based on last ' + d.backup.eta_samples + ' completed transfer' + (d.backup.eta_samples===1?'':'s')) : '',
                d.backup ? ('ETA '+esc(d.backup.eta) +
                            (d.backup.eta_date ? ' \u2022 '+esc(d.backup.eta_date) : '') +
                            etaTrendHtml(d.eta_trend)) : '');

    var up = document.getElementById('uploading');
    document.getElementById('uploading-title').textContent = d.files.length
      ? 'Uploading Now \u2022 ' + d.files.length + (d.files.length===1?' file':' files')
      : 'Uploading Now';
    // A scan is the only place the client exposes a real percentage, but it runs
    // alongside uploads rather than instead of them, so it heads the panel rather
    // than replacing it.
    var scanHtml = d.scan
      ? '<div class="file-row"><div class="track">' +
        '<span class="fill good" style="width:'+d.scan.pct+'%"></span></div>' +
        '<div class="meta"><span>'+d.scan.pct.toFixed(0)+'%</span>' +
        '<span>'+esc(d.scan.dirs)+' directories</span>' +
        '<span>'+esc((d.scan.files||0).toLocaleString())+' files found</span></div></div>'
      : '';
    // The chunk strip IS the compact multi-part view, so the setting governs it.
    var stripHtml = (compactParts && d.chunkmap) ? chunkStrip(d.chunkmap) : '';
    // Most files are small enough to be gone before the next poll, so they never
    // get a row of their own. The client names the one it has in hand, which is
    // the only way they show up at all.
    var a = d.activity, nowHtml = '';
    if(a && !d.files.some(f => a.file && f.name === a.file)){
      nowHtml = '<div class="nowline"'+(a.internal ? ' title="The client\u2019s own '+
        'bookkeeping going up, not one of your files."' : '')+'>' +
        '<span class="nowphase">'+(d.paused ? 'Paused before'
            : esc(a.phase)+(a.part ? ' part '+a.part : ''))+'</span>' +
        (a.file ? '<span class="nowfile">'+esc(a.file)+'</span>' : '') + '</div>';
    }
    var head = scanHtml + stripHtml + nowHtml;
    if(!d.files.length){
      up.innerHTML = head || '<div id="empty">(nothing in flight)</div>';
    } else {
      var seenCompact = {};
      up.innerHTML = head + d.files.map(f=>{
        if(compactParts && f.parts && f.parts.total > 1){
          // A dozen threads on one film would otherwise draw a dozen identical
          // rows: the compact row counts the file's parts, not the thread's own
          // progress. One row per file, and none for the file the strip covers.
          if(seenCompact[f.name]) return '';
          seenCompact[f.name] = 1;
          if(d.chunkmap && d.chunkmap.file === f.name) return '';
          var cells = '';
          for(var i=0;i<f.parts.total;i++){
            cells += '<span class="cell'+(i < f.parts.done ? ' on' : '')+'"></span>';
          }
          return '<div class="file-row cells"><div class="track">'+cells+'</div>' +
                 '<div class="meta"><span>'+f.parts.done+'/'+f.parts.total+'</span>' +
                 '<span>'+esc(f.size_str)+'</span><span>'+esc(f.name)+'</span></div></div>';
        }
        var cls = f.pct>=67?'good':(f.pct>=34?'warn':'bad');
        return '<div class="file-row"><div class="track"><span class="fill '+cls+'" style="width:'+f.pct+'%"></span></div>' +
               '<div class="meta"><span>'+f.pct.toFixed(0)+'%</span><span>'+esc(f.size_str)+'</span><span>'+esc(f.name)+'</span></div></div>';
      }).join('');
    }

    var tb = document.getElementById('recent-body');
    if(!d.recent.length){
      tb.innerHTML = '<tr><td colspan="5" id="empty">(watching for completions&hellip;)</td></tr>';
    } else {
      tb.innerHTML = d.recent.slice().reverse().map(r=>
        '<tr><td class="col-time">'+esc(r.time)+'</td><td class="col-thread">'+esc(r.thread)+'</td>'+
        '<td class="col-size">'+esc(r.size)+'</td><td class="col-rate">'+esc(r.rate)+'</td>'+
        '<td class="col-file">'+esc(r.name)+'</td></tr>'
      ).join('');
    }
  }catch(e){
    document.getElementById('err').style.display='block';
    document.getElementById('err').textContent = 'Fetch failed: ' + e;
  }
}
(function(){
  var params = new URLSearchParams(location.search);
  if(params.get('compact') === '1' || params.get('compact') === 'true'){
    document.body.classList.add('compact');
  }
  var sel = document.getElementById('theme-select');
  var themeParam = params.get('theme');
  var saved = themeParam || (function(){
    try { return localStorage.getItem('bbMonitorTheme'); } catch(e){ return null; }
  })() || 'blue';
  document.documentElement.setAttribute('data-theme', saved);
  sel.value = saved;
  updateFavicon(lastState);
  sel.addEventListener('change', function(){
    document.documentElement.setAttribute('data-theme', sel.value);
    try { localStorage.setItem('bbMonitorTheme', sel.value); } catch(e){}
    updateFavicon(lastState);
  });

  var cp = document.getElementById('compact-parts');
  try { compactParts = localStorage.getItem('bbCompactParts') === '1'; } catch(e){}
  if(params.get('parts') === '1') compactParts = true;
  cp.checked = compactParts;
  cp.addEventListener('change', function(){
    compactParts = cp.checked;
    try { localStorage.setItem('bbCompactParts', compactParts ? '1' : '0'); } catch(e){}
    tick();   // redraw at once rather than waiting out the poll interval
  });

  wirePauseButton();

  var backdrop = document.getElementById('backdrop');
  var openBtn  = document.getElementById('settings-btn');
  var tabs     = Array.prototype.slice.call(document.querySelectorAll('.mtab'));
  function setTab(name){
    tabs.forEach(function(t){
      t.setAttribute('aria-selected', t.getAttribute('data-tab') === name ? 'true' : 'false');
    });
    document.getElementById('pane-prefs').hidden = (name !== 'prefs');
    document.getElementById('pane-about').hidden = (name !== 'about');
  }
  function openModal(){
    backdrop.hidden = false;
    setTab('prefs');
    document.getElementById('modal-close').focus();
  }
  function closeModal(){
    backdrop.hidden = true;
    openBtn.focus();
  }
  openBtn.addEventListener('click', openModal);
  document.getElementById('modal-close').addEventListener('click', closeModal);
  backdrop.addEventListener('click', function(e){ if(e.target === backdrop) closeModal(); });
  function typing(e){ var t = e.target && e.target.tagName; return t === 'INPUT' || t === 'SELECT' || t === 'TEXTAREA' || (e.target && e.target.isContentEditable); }
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && !backdrop.hidden){ closeModal(); return; }
    if(typing(e) || e.ctrlKey || e.metaKey || e.altKey) return;
    if(e.key === 's'){ document.getElementById('settings-btn').click(); }
    else if(e.key === 'p'){ var pb = document.getElementById('pause-btn'); if(pb && pb.style.display !== 'none') pb.click(); }
    else if(e.key >= '1' && e.key <= '5' && window.parent !== window){
      // The shell owns the tabs; tell it. Same origin, so the target is exact.
      window.parent.postMessage({bb64: 'tab', n: Number(e.key)}, location.origin);
    }
  });
  document.getElementById('copy-summary').addEventListener('click', function(){
    var btn = this;
    fetch('manage/summary', {cache:'no-store'}).then(function(r){ return r.text(); }).then(function(txt){
      function done(){ btn.textContent = 'Copied'; setTimeout(function(){ btn.textContent = 'Copy status summary'; }, 1200); }
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(txt).then(done, function(){ prompt('Copy this:', txt); }); }
      else { prompt('Copy this:', txt); }
    });
  });
  tabs.forEach(function(t){
    t.addEventListener('click', function(){ setTab(t.getAttribute('data-tab')); });
  });
})();
tick();
setInterval(tick, 2000);
</script>
</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    # HTTP/1.1 so a consumer polling every couple of seconds reuses one
    # connection instead of opening a fresh one each time. This is only safe
    # because every response here carries a Content-Length, including the
    # bodyless ones: without it a client waits for a body that never comes and
    # the reused connection desynchronises.
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass  # keep the container log quiet

    def _cors(self, path):
        """Echo the origin back when it is on the list. Never a wildcard, and
        never credentials: the API authenticates with a header, so a browser has
        no reason to send cookies and every reason not to be allowed to."""
        if not CORS_ORIGINS or not path.startswith("/api/v1/"):
            return
        origin = (self.headers.get("Origin") or "").rstrip("/")
        # Vary regardless of the outcome, so a cache cannot serve one origin's
        # allowed response to another origin.
        self.send_header("Vary", "Origin")
        if origin and origin in CORS_ORIGINS:
            self.send_header("Access-Control-Allow-Origin", origin)

    def do_OPTIONS(self):
        path = urlsplit(self.path).path
        # A preflight carries no Authorization header, so it is answered without
        # one. It reveals only that cross-origin access is configured.
        if not CORS_ORIGINS or not path.startswith("/api/v1/"):
            self.send_response(405)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        self.send_response(204)
        self._cors(path)
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type")
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _json(self, code, obj):
        payload = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self._cors(urlsplit(self.path).path)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def _api_route(self, method, path):
        """(scope, handler) for a v1 route, or (None, None).

        The scope is chosen here, per route, rather than assumed. A read key must
        not be able to stop a backup because both arrive on the same surface.
        """
        if method == "GET" and path == "/api/v1/status":
            return "read", self._api_status
        if method == "GET" and path == "/api/v1/key":
            # Any valid key, describing only itself. This is what stops a client
            # having to discover its own grants by collecting 401s, now that the
            # other endpoints tell a key nothing about what it does not hold.
            return None, self._api_key_self
        if method == "GET" and path == "/api/v1/control":
            # Only a key that holds some control, and it lists only that key's
            # own operations. A read-only key is not told what control exists.
            return tuple(bbapi.GROUPS["control"]), self._api_control_list
        if method == "POST" and path == "/api/v1/report":
            return "report", self._api_report_start
        if method == "GET" and path.startswith("/api/v1/report/") \
                and not path.startswith("/api/v1/report/download/"):
            return "report", lambda: self._api_report_status(
                path[len("/api/v1/report/"):])
        if method == "POST" and path.startswith("/api/v1/control/"):
            name = path[len("/api/v1/control/"):]
            # The segment selects a key in a fixed table. It is never used to
            # build an argument list, so a caller cannot reach --clear-pek by
            # spelling it in a URL.
            if name in bbctl.ACTIONS:
                return "control:" + name, lambda: self._api_control_run(name)
        if method == "GET" and path == "/api/v1/summary":
            return "read", self._api_summary
        if method == "GET" and path == "/api/v1/metrics":
            return "read", self._api_metrics
        if method == "GET" and path == "/api/v1/events":
            return "read", self._api_events
        if method == "GET" and path == "/api/v1/openapi.json":
            # Any valid key: the document describes the surface, and a key
            # already proves the caller may know it exists.
            return None, self._api_openapi
        diag = bbapi.DIAGNOSE
        if method == "GET" and path == "/api/v1/tools":
            return diag, self._api_tools_list
        if method == "GET" and path.startswith("/api/v1/tools/job/"):
            return diag, lambda: self._api_tools_job(path[len("/api/v1/tools/job/"):])
        if method == "POST" and path.startswith("/api/v1/tools/"):
            name = path[len("/api/v1/tools/"):]
            if name in bbtools.TOOLS:
                return diag, lambda: self._api_tools_run(name)
        return None, None

    def _text(self, code, text, ctype="text/plain; charset=utf-8"):
        payload = text.encode("utf-8")
        self.send_response(code)
        self._cors(urlsplit(self.path).path)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def _api_summary(self):
        with _lock:
            api = _latest_api
        self._text(200, summary_text(api))

    def _api_metrics(self):
        with _lock:
            api = _latest_api
        self._text(200, metrics_text(api), "text/plain; version=0.0.4; charset=utf-8")

    OPENAPI = "/usr/local/share/bb-monitor/openapi.json"

    def _api_openapi(self):
        try:
            with open(self.OPENAPI, encoding="utf-8") as fh:
                doc = fh.read()
        except OSError:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no OpenAPI document in this image"})
            return
        self._text(200, doc, "application/json")

    def _api_events(self):
        """Server-sent events: one message per change to what a consumer watches,
        and a comment every fifteen seconds so the connection is known alive.
        Nothing here names a file, so it is a plain read."""
        self.send_response(200)
        self._cors(urlsplit(self.path).path)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        last_seq, last_sig, last_beat = -1, None, time.time()
        try:
            self.wfile.write(b": bb64 events\n\n")
            self.wfile.flush()
            while True:
                with _events_cv:
                    _events_cv.wait_for(lambda: _events_seq != last_seq, timeout=15)
                    last_seq = _events_seq
                with _lock:
                    api = _latest_api
                if not api.get("ok"):
                    sig = ("not-ok",)
                else:
                    sig = (api.get("state"), api.get("paused"),
                           tuple(sorted(h["kind"] for h in api.get("health") or [])),
                           (api.get("skipped_files") or {}).get("total"),
                           bool(api.get("completion")),
                           tuple(m["key"] for m in api.get("milestones") or []))
                now = time.time()
                if sig != last_sig:
                    last_sig = sig
                    data = {"time": int(now), "state": api.get("state"),
                            "paused": api.get("paused"), "pause_label": api.get("pause_label"),
                            "health": api.get("health"), "skipped_files": api.get("skipped_files"),
                            "completion": api.get("completion"), "milestones": api.get("milestones")}
                    self.wfile.write(("event: state\ndata: %s\n\n" % json.dumps(data)).encode("utf-8"))
                    last_beat = now
                elif now - last_beat >= 15:
                    self.wfile.write(b": keep-alive\n\n")
                    last_beat = now
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            return

    def _api_tools_list(self):
        self._json(200, {"schema": bbapi.SCHEMA, "build": BUILD_LABEL,
                         "can_repair": "diagnose:repair" in bbapi.perms(self._kid),
                         "tools": bbtools.describe()})

    def _api_tools_job(self, jid):
        st = bbtools.status(jid)
        if st is None:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no such job"})
            return
        st["schema"] = bbapi.SCHEMA
        self._json(200, st)

    def _api_tools_run(self, name):
        if not bbtools.available(name):
            self._json(503, {"schema": bbapi.SCHEMA, "error": "%s is not present in this image" % name})
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or "{}") if n else {}
        except (ValueError, OSError):
            self._json(400, {"schema": bbapi.SCHEMA, "error": "bad request body"})
            return
        opts = body.get("options") or []
        if not isinstance(opts, list) or not all(isinstance(o, str) for o in opts):
            self._json(400, {"schema": bbapi.SCHEMA, "error": "options must be a list of option names"})
            return
        # Checks need diagnose; anything that changes files needs the repair
        # permission as well, so a key issued to look cannot be used to change.
        if bbtools.mutating(name, opts) and "diagnose:repair" not in bbapi.perms(self._kid):
            self._json(403, {"schema": bbapi.SCHEMA, "error": "diagnose:repair is required for that option"})
            return
        try:
            jid, joined = bbtools.start(name, opts)
        except ValueError as exc:
            self._json(400, {"schema": bbapi.SCHEMA, "error": str(exc)})
            return
        st = bbtools.status(jid) or {"id": jid, "state": "running"}
        sys.stderr.write("bb-monitor-web: key %s %s job %s: %s\n"
                         % (self._kid, "joined" if joined else "started", jid, st.get("command", name)))
        st["schema"] = bbapi.SCHEMA
        st["joined_existing"] = joined
        self._json(202, st)

    def _api_status(self):
        with _lock:
            payload = _latest_api
        if "read:files" not in bbapi.perms(self._kid):
            payload = strip_file_names(payload)
        # ?fields=rate_bytes_per_sec,paused trims the payload to what a consumer
        # actually wants, plus schema and ok, which every response carries so a
        # filtered reply is still recognisably the same contract. Unknown names
        # are ignored rather than erroring: a consumer built against a newer
        # container should not break on an older one that lacks a field.
        q = urlsplit(self.path).query
        m = re.search(r'(?:^|&)fields=([^&]*)', q)
        if m:
            want = {f.strip() for f in m.group(1).split(",") if f.strip()}
            if want:
                want |= {"schema", "ok", "error"}
                payload = {k: v for k, v in payload.items() if k in want}
        self._json(200, payload)

    def _api_report_start(self):
        if not bbreport.available():
            self._json(503, {"schema": bbapi.SCHEMA, "error": "bb-report is not present"})
            return
        jid, joined = bbreport.start()
        sys.stderr.write("bb-monitor-web: key %s %s report job %s\n"
                         % (self._kid, "joined" if joined else "started", jid))
        st = bbreport.status(jid) or {"job": jid, "state": "running"}
        st["schema"] = bbapi.SCHEMA
        st["joined_existing"] = joined
        self._json(202, st)

    def _api_report_status(self, jid):
        st = bbreport.status(jid)
        if st is None:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no such job"})
            return
        st["schema"] = bbapi.SCHEMA
        self._json(200, st)

    def _serve_report(self, token):
        """The token is the credential here, so no bearer is required: this is the
        URL a browser follows, and a key in a URL ends up in history and logs."""
        path = bbreport.claim(token)
        if not path:
            self._json(404, {"schema": bbapi.SCHEMA,
                             "error": "link unknown, expired or already used"})
            return
        self._stream_zip(path)

    def _stream_zip(self, path):
        try:
            size = os.path.getsize(path)
            with open(path, "rb") as fh:
                self.send_response(200)
                self._cors(urlsplit(self.path).path)
                self.send_header("Content-Type", "application/zip")
                self.send_header("Content-Length", str(size))
                self.send_header("Content-Disposition",
                                 'attachment; filename="%s"' % os.path.basename(path))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                while True:
                    chunk = fh.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
        except OSError as exc:
            sys.stderr.write("bb-monitor-web: report download failed: %s\n" % exc)

    def _api_key_self(self):
        held = bbapi.perms(self._kid)
        self._json(200, {"schema": bbapi.SCHEMA, "id": self._kid,
                         "permissions": sorted(held)})

    def _api_control_list(self):
        held = set(bbapi.perms(self._kid))
        self._json(200, {"schema": bbapi.SCHEMA,
                         "available": bbctl.available(),
                         "actions": [{"name": n, "does": d}
                                     for n, (_, d) in sorted(bbctl.ACTIONS.items())
                                     if ("control:" + n) in held]})

    def _api_control_run(self, name):
        if not bbctl.available():
            self._json(503, {"schema": bbapi.SCHEMA, "error": "bzcli is not present"})
            return
        ok, msg = bbctl.run(name)
        # Anything that changes the system is recorded with the key that asked for
        # it. The public id only, never the secret. Reads are not logged: they are
        # constant and would bury this.
        sys.stderr.write("bb-monitor-web: key %s ran %s: %s\n"
                         % (self._kid, name, "ok" if ok else "failed, " + msg))
        self._json(200 if ok else 502,
                   {"schema": bbapi.SCHEMA, "action": name, "ok": ok, "detail": msg})

    def _api_v1(self, method, path):
        """Returns True when the request was handled here."""
        if not path.startswith("/api/v1/") and path != "/api/v1":
            return False
        # Ahead of the key check: the single-use token in the path is what
        # authorises this one, which is the whole point of issuing it.
        if method == "GET" and path.startswith("/api/v1/report/download/"):
            self._serve_report(path[len("/api/v1/report/download/"):])
            return True
        # No key means the surface does not exist, so say so rather than 403.
        # A 403 would confirm the endpoint is here; with no key there is nothing
        # to confirm, and every fresh container would be advertising it.
        if not bbapi.live():
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True
        need, handler = self._api_route(method, path)
        auth = self.headers.get("Authorization", "")
        presented = auth[7:] if auth[:7].lower() == "bearer " else ""
        # An unknown path is still authenticated first, so that the set of
        # endpoints is not enumerable without a key. Any valid key is enough to
        # be told 404, since that reveals nothing about what exists.
        ok, kid = bbapi.verify(presented, need if handler else None)
        if not ok:
            # The public id only, never the secret, and only when one parsed.
            sys.stderr.write("bb-monitor-web: api/v1 auth failed%s\n"
                             % (" for key %s" % kid if kid else ""))
            self.send_response(401)
            self.send_header("WWW-Authenticate", 'Bearer realm="bb64"')
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True
        bbapi.touch(kid)
        self._kid = kid
        if handler is None:
            self._json(404, {"schema": bbapi.SCHEMA, "error": "no such endpoint"})
        else:
            handler()
        return True

    def _guard(self):
        """Same-origin check for the management calls.

        These sit behind nginx's auth_request, so the browser session is what
        authorises them, and a browser session is exactly what a cross-site POST
        can borrow. Requiring a header the form sets forces a CORS preflight on
        anything cross-origin, which a plain form post cannot satisfy.
        """
        if self.headers.get("X-Requested-With") != "bb64":
            self.send_response(403)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return False
        return True

    def _manage_get(self, path):
        if path == "/manage/keys":
            self._json(200, {
                "schema": bbapi.SCHEMA, "keys": bbapi.listing(),
                "enabled": bbapi.live(), "switch": bbapi.enabled(),
                "has_keys": bool(bbapi.active()),
                "permissions": [{"name": n, "does": bbapi.PERMISSIONS[n],
                                 # A colon does not make a group. read:files is
                                 # its own permission and belongs at the top
                                 # level; only names in GROUPS get a box.
                                 "group": (n.split(":")[0]
                                           if n.split(":")[0] in bbapi.GROUPS else None),
                                 "reserved": n in bbapi.RESERVED}
                                for n in bbapi.ORDER],
                "groups": {g: list(m) for g, m in bbapi.GROUPS.items()}})
            return True
        if path == "/manage/tools":
            self._json(200, {"schema": bbapi.SCHEMA, "build": BUILD_LABEL,
                             "tools": bbtools.describe()})
            return True
        if path == "/manage/notify":
            self._json(200, dict(bbnotify.public(bbnotify.load()), schema=bbapi.SCHEMA))
            return True
        if path == "/manage/quiet":
            conf = bbquiet.load()
            self._json(200, {"schema": bbapi.SCHEMA, "config": conf,
                             "state": _quiet.state(conf), "days": list(bbquiet.DAYS)})
            return True
        if path == "/manage/timeline":
            self._json(200, {"schema": bbapi.SCHEMA, "timeline": timeline()})
            return True
        if path == "/manage/summary":
            with _lock:
                api = _latest_api
            payload = summary_text(api).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return True
        if path.startswith("/manage/tools/job/"):
            st = bbtools.status(path[len("/manage/tools/job/"):])
            if st is None:
                self._json(404, {"error": "no such job"})
            else:
                st["schema"] = bbapi.SCHEMA
                self._json(200, st)
            return True
        if path == "/manage/report":
            self._json(200, {"schema": bbapi.SCHEMA, "available": bbreport.available(),
                             "bundles": bbreport.listing(), "running": bbreport.current()})
            return True
        if path.startswith("/manage/report/job/"):
            st = bbreport.status(path[len("/manage/report/job/"):])
            if st is None:
                self._json(404, {"error": "no such job"})
            else:
                st["schema"] = bbapi.SCHEMA
                self._json(200, st)
            return True
        if path.startswith("/manage/report/download/"):
            # By name, for the browser session that is already logged in. The
            # single-use token flow stays on /api/v1/, where there is no session
            # and the token is the credential. path_for() admits only names that
            # match the bundle pattern, so nothing outside the store is reachable.
            p = bbreport.path_for(path[len("/manage/report/download/"):])
            if not p:
                self._json(404, {"error": "no such bundle"})
            else:
                self._stream_zip(p)
            return True
        if path in ("/manage/status", "/manage/skipped"):
            # Served from the cached display snapshot, the same one /api/status
            # hands out, so the page costs nothing beyond a dictionary lookup and
            # never re-reads Backblaze's report file itself. Read under the lock
            # because the collector thread rebinds _latest wholesale. The old
            # /manage/skipped name answers the same, for anything that kept it.
            with _lock:
                snap = _latest
            self._json(200, {"schema": bbapi.SCHEMA,
                             "ok": snap.get("ok", False), "error": snap.get("error"),
                             "state": snap.get("state"), "clock": snap.get("clock"),
                             "build": snap.get("build_label"),
                             "health": snap.get("health") or [],
                             "paused": snap.get("paused", False),
                             "completion": snap.get("completion"),
                             "first_backup": snap.get("first_backup"),
                             "last_backup_days": snap.get("last_backup_days"),
                             "skipped": snap.get("skipped"),
                             "list": snap.get("skipped_list"),
                             "pause_label": snap.get("pause_label"),
                             "milestones": snap.get("milestones"),
                             "quiet": _quiet.state(),
                             "timeline": timeline()})
            return True
        return False

    def do_POST(self):
        path = urlsplit(self.path).path
        # Key auth, so no same-origin guard here: that guard exists for /manage/,
        # which rides the browser session a cross-site post could borrow.
        if self._api_v1("POST", path):
            return
        if not path.startswith("/manage/"):
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        if not self._guard():
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or "{}") if n else {}
        except (ValueError, OSError):
            self._json(400, {"error": "bad request body"})
            return

        if path.startswith("/manage/tools/clear/"):
            # Before the run route, which would otherwise read "clear/<name>" as
            # a tool name and answer 404.
            name = path[len("/manage/tools/clear/"):]
            if name not in bbtools.TOOLS:
                self._json(404, {"error": "no such tool"})
                return
            self._json(200, {"schema": bbapi.SCHEMA, "cleared": bbtools.clear(name)})
            return
        if path.startswith("/manage/tools/"):
            # The page's Run button. A tool is named by path and its options by
            # key; both are looked up in bbtools.TOOLS, and nothing else from the
            # request reaches the argument list.
            name = path[len("/manage/tools/"):]
            if name not in bbtools.TOOLS:
                self._json(404, {"error": "no such tool"})
                return
            if not bbtools.available(name):
                self._json(503, {"error": "%s is not present in this image" % name})
                return
            opts = body.get("options") or []
            if not isinstance(opts, list) or not all(isinstance(o, str) for o in opts):
                self._json(400, {"error": "options must be a list of option names"})
                return
            try:
                jid, joined = bbtools.start(name, opts)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            st = bbtools.status(jid) or {"id": jid, "state": "running"}
            # Every run is logged with the command, so a changed prefix or a
            # cleared lock has a line in the container log that explains it.
            sys.stderr.write("bb-monitor-web: web session %s job %s: %s\n"
                             % ("joined" if joined else "started", jid,
                                st.get("command", name)))
            st["schema"] = bbapi.SCHEMA
            st["joined_existing"] = joined
            self._json(202, st)
            return
        if path == "/manage/report":
            if not bbreport.available():
                self._json(503, {"error": "bb-report is not present in this image"})
                return
            jid, joined = bbreport.start()
            sys.stderr.write("bb-monitor-web: web session %s report job %s\n"
                             % ("joined" if joined else "started", jid))
            st = bbreport.status(jid) or {"job": jid, "state": "running"}
            st["schema"] = bbapi.SCHEMA
            st["joined_existing"] = joined
            self._json(202, st)
            return
        if path == "/manage/report/delete":
            name = (body.get("name") or "").strip()
            if bbreport.delete(name):
                sys.stderr.write("bb-monitor-web: web session deleted bundle %s\n" % name)
                self._json(200, {"schema": bbapi.SCHEMA, "deleted": name,
                                 "bundles": bbreport.listing()})
            else:
                self._json(404, {"error": "no such bundle"})
            return
        if path.startswith("/manage/control/"):
            # The page's own pause button. Session-authorised like the rest of
            # /manage/ (auth_request plus the same-origin guard), so no API key
            # is needed to use the page you are already logged into. The action
            # name selects from the same fixed whitelist the API uses; nothing
            # from the request reaches an argument list.
            name = path[len("/manage/control/"):]
            if name not in bbctl.ACTIONS:
                self._json(404, {"error": "no such action"})
                return
            if not bbctl.available():
                self._json(503, {"error": "bzcli is not present"})
                return
            ok, msg = bbctl.run(name)
            sys.stderr.write("bb-monitor-web: web session ran %s: %s\n"
                             % (name, "ok" if ok else "failed, " + msg))
            self._json(200 if ok else 502, {"action": name, "ok": ok, "detail": msg})
            return
        if path == "/manage/keys/enabled":
            on = bbapi.set_enabled(bool(body.get("enabled")))
            sys.stderr.write("bb-monitor-web: web session switched the API %s\n" % ("on" if on else "off"))
            self._json(200, {"schema": bbapi.SCHEMA, "switch": on, "enabled": bbapi.live(),
                             "has_keys": bool(bbapi.active())})
            return
        if path == "/manage/keys/delete":
            kid = (body.get("id") or "").strip()
            if bbapi.delete(kid):
                self._json(200, {"schema": bbapi.SCHEMA, "deleted": kid})
            else:
                self._json(409, {"error": "only a revoked or expired key can be deleted"})
            return
        if path == "/manage/notify":
            try:
                conf = bbnotify.save(body)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            self._json(200, dict(bbnotify.public(conf), schema=bbapi.SCHEMA))
            return
        if path == "/manage/notify/test":
            ok, detail = bbnotify.test((body.get("id") or "").strip())
            self._json(200 if ok else 502, {"schema": bbapi.SCHEMA, "ok": ok, "detail": detail})
            return
        if path == "/manage/quiet":
            try:
                conf = bbquiet.save(body)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            self._json(200, {"schema": bbapi.SCHEMA, "config": conf, "state": _quiet.state(conf)})
            return
        if path == "/manage/keys":
            label = (body.get("label") or "").strip()
            scopes = body.get("scopes") or []
            if not label:
                self._json(400, {"error": "a label is required"})
                return
            exp = body.get("expires_days")
            try:
                rec, secret = bbapi.create(label, scopes,
                                           exp if exp not in (None, "", 0) else None)
            except ValueError as exc:
                self._json(400, {"error": str(exc)})
                return
            # The only time the secret leaves this process.
            self._json(200, {"schema": bbapi.SCHEMA, "key": rec, "secret": secret})
        elif path == "/manage/keys/revoke":
            kid = (body.get("id") or "").strip()
            if bbapi.revoke(kid):
                self._json(200, {"schema": bbapi.SCHEMA, "revoked": kid,
                                 "enabled": bbapi.live(), "switch": bbapi.enabled(),
                "has_keys": bool(bbapi.active())})
            else:
                self._json(404, {"error": "no active key with that id"})
        else:
            self._json(404, {"error": "no such endpoint"})

    def do_GET(self):
        path = urlsplit(self.path).path   # strip any ?query string before routing
        if self._api_v1("GET", path):
            return
        if self._manage_get(path):
            return
        if path == "/apikeys":
            payload = KEYS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/tools":
            payload = TOOLS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path in ("/status", "/skipped"):
            payload = STATUS_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/api/status":
            with _lock:
                payload = json.dumps(_latest).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
        elif path in ("/", "/index.html"):
            payload = INDEX_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        else:
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dump-rtt", action="store_true",
                     help="Print what the kernel reports for the live upload "
                          "connections, then exit. For checking the netlink read "
                          "inside the container without going through the UI.")
    ap.add_argument("--port", type=int, default=8099)
    # Loopback by default: nginx fronts this, and binding 0.0.0.0 would put
    # the names of every backed-up file on the LAN with no authentication.
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    if args.dump_rtt:
        uid = _threadpush_uid()
        print("threadpush uid:  %s" % (uid if uid else "none (nothing uploading)"))
        if hasattr(socket, "AF_NETLINK"):
            rows = []
            for fam in (socket.AF_INET, socket.AF_INET6):
                try:
                    rows += [(p, u, d, r) for p, u, d, r in _diag_dump(fam)]
                except OSError as e:
                    print("netlink dump failed for family %s: %s" % (fam, e))
            print("established TCP sockets reporting tcp_info: %d" % len(rows))
            for peer, u, dport, rtt in rows:
                mark = " <- upload" if (dport == 443 and str(u) == str(uid)) else ""
                print("  %-40s uid=%-6s dport=%-5d rtt=%.1f ms%s"
                      % (peer, u, dport, rtt / 1000.0, mark))
        else:
            print("no AF_NETLINK on this platform")
        ms, peer, note = _upload_rtt()
        print("reported: %s" % ("n/a (%s)" % note if ms is None
                                 else "%.1f ms via %s" % (ms, peer)))
        return

    threading.Thread(target=_loop, daemon=True).start()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    print("bb-monitor-web listening on http://%s:%d/" % (args.host, args.port))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
