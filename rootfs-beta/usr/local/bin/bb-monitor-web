#!/usr/bin/env python3
"""bb-monitor-web: same live upload dashboard as bb-monitor, served over HTTP.

Reuses the exact same data sources as bb-monitor (proc, cgroup, and
Backblaze's own bzdata log/XML files) -- no curses, no subprocesses.
A background thread gathers a fresh snapshot every INT seconds; the HTTP
server just hands out the latest snapshot as JSON, plus a static HTML/JS
page that polls it and redraws.

In the container image this runs as a supervised service bound to loopback,
with nginx proxying /monitor/ to it on the existing web port (5800). That way
it inherits whatever WEB_AUTHENTICATION and SECURE_CONNECTION the user has
configured for the GUI, instead of exposing backed-up file names on a second
open port.

Standalone, for testing:
    python3 bb-monitor-web --host 127.0.0.1 --port 8099
"""
import argparse, json, os, re, socket, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

# ---- shared data layer ----------------------------------------------------
# Everything that reads /proc, the cgroups and Backblaze's own files lives in
# bbdata, so this file and bb-monitor cannot drift apart. This one owns HTTP and
# the page; the terminal one owns curses. Neither owns data collection.
sys.path.insert(0, "/usr/local/lib/bb-monitor")
import bbapi
import bbctl
import bbdata
import bbreport
import bbtools
import bbnotify
import bbquiet
from bbdata import (BUILD_INFO, BUILD_LABEL, INT, eta_str, gather, human,
                     rec_cols, uptime_str, _diag_dump, _threadpush_uid,
                     _upload_host, _upload_rtt)

_lock = threading.Lock()
APP_NAME = "Backblaze 64"
APP_COMPONENT = "Upload Monitor"
APP_COPYRIGHT = "Copyright \u00a9 2026 Martyn Forryan"
APP_LICENSE = "GNU Affero General Public License v3.0"
APP_URL = "https://github.com/iamfoz/backblaze-64-personal-wine-container"

# Contributed work credited in the About tab: (forum handle, one-line description).
# An empty list hides the Thanks section, so a missing handle never ships as
# placeholder text.
CREDITS = [("rogman", "web monitor, themes & features")]







# Static, so it rides along with every payload including the error ones. The
# About tab is most useful precisely when collection is broken and someone needs
# to quote a build in a bug report.
ABOUT = {
    "name": APP_NAME,
    "component": APP_COMPONENT,
    "copyright": APP_COPYRIGHT,
    "license": APP_LICENSE,
    "url": APP_URL,
    "build": BUILD_INFO,
    "credits": [{"who": w, "what": t} for w, t in CREDITS],
}

# Restated now ABOUT exists, so even the pre-first-sample payload carries it.
_latest = {"ok": False, "error": "warming up", "about": ABOUT}
_latest_api = {"schema": bbapi.SCHEMA, "ok": False, "error": "warming up"}

# Cross-origin access for a consumer that runs in a browser, which cannot reach
# the API at all without it. Off unless API_CORS_ORIGINS names origins, and an
# allow-list rather than "*": the key is still required either way, but with "*"
# any page the user happens to visit could poll their container in the
# background, and the answer names every file being backed up.
#
# This applies to /api/v1/ only. /manage/ is authorised by the browser session,
# so allowing another origin to call it would hand key creation to any page the
# user has open. That is the CSRF hole the X-Requested-With guard exists to close.
CORS_ORIGINS = tuple(o.strip().rstrip("/") for o in
                     os.environ.get("API_CORS_ORIGINS", "").split(",") if o.strip())


# ---- JSON snapshot builder ------------------------------------------------
def snapshot_to_json(d):
    r = d["rate"]
    mem = d["mem"]
    swap = d["swap"]
    lat_ms, lat_host, lat_note = _upload_rtt()
    files_out = []
    for name, part, fsize, pct, parts in d["files"]:
        size_str = (human(fsize) + (" (chunked)" if fsize > part * 1.5 else "")) if fsize > 0 else "%d MB" % (part / 1048576)
        row = {"name": name, "pct": round(pct, 1), "size_str": size_str}
        if parts:
            row["parts"] = {"done": parts[0], "total": parts[1]}
        files_out.append(row)
    recent_out = []
    for rr in d["recent"]:
        th, size, rate = rec_cols(rr)
        recent_out.append({"time": rr["t"], "thread": th, "size": size, "rate": rate, "name": rr["name"]})
    return {
        "ok": True,
        "clock": time.strftime("%H:%M:%S"),
        "threads": d["threads"],
        "state": d["state"],
        "rate_mb": round(r, 3),
        "rate_str": "%.2f MB/s" % r,
        "rate_mbit_str": "~%d Mbit/s" % (r * 8),
        "chunks": d["chunks"],
        "session_str": human(d["sess"]),
        "mem": {"used_str": human(mem[0]), "total_str": human(mem[1]), "pct": round(mem[2], 1)} if mem else None,
        "memory_by_process": d.get("memory_by_process"),
        "swap": {"used_str": human(swap[0]), "total_str": human(swap[1]), "pct": round(swap[2], 1)} if swap else None,
        "backup": ({"used_str": human(d["backup"]["done"]), "total_str": human(d["backup"]["total"]),
                     "pct": round(d["backup"]["pct"], 1),
                     "files": ("%d/%d files" % (d["backup"]["done_files"], d["backup"]["total_files"]))
                               if d["backup"]["done_files"] is not None else "",
                     "eta": eta_str(d["backup"].get("eta_seconds")),
                     # The same estimate as a calendar date. A duration answers
                     # "how long", a date answers "when", and only the second one
                     # can be compared against anything the user has planned.
                     "eta_date": bbdata.eta_date(d["backup"].get("eta_seconds")),
                     "eta_samples": d["backup"].get("eta_samples", 0),
                     "remaining_files": d["backup"].get("remaining_files")}
                    if d.get("backup") else None),
        "files": files_out,
        "recent": recent_out,
        "build_label": BUILD_LABEL,
        "interval": INT,
        "uptime": uptime_str(),
        "current_file": d.get("current_file"),
        "activity": d.get("activity"),
        "scan": ({"pct": round(d["scan"]["pct"], 1),
                   "dirs": "%d/%d" % (d["scan"]["dirs_done"], d["scan"]["dirs_total"]),
                   "files": d["scan"]["files"],
                   "size_str": human(d["scan"]["bytes"]) if d["scan"]["bytes"] else None}
                  if d.get("scan") else None),
        "perf": d.get("perf"),
        "health": [{"kind": k, "text": t} for k, t in (d.get("health") or [])],
        "upload_success": d.get("upload_success"),
        # Raw counts rather than a pre-drawn chart: the page scales the bars to
        # its own tallest day, and the day strings are already display-ready.
        "upload_history": d.get("upload_history"),
        # The size is formatted here because the banner states it as prose, and
        # the days figure is a whole number of days by construction.
        "completion": ({"done_at": d["completion"]["done_at"],
                         "days": d["completion"]["days"],
                         "total_str": human(d["completion"]["total_bytes"])}
                        if d.get("completion") else None),
        # What the set is actually made of. Counts only, and only the categories
        # the client itself counted, so the page can say what a couple of million
        # files are rather than only how many there are.
        "composition": d.get("composition"),
        # YYYYMMDD as the client records it. The page formats it for display,
        # because the raw string is also what the API hands a consumer that wants
        # to parse the date rather than read it, and one shape serves both.
        "backing_up_since": d.get("backing_up_since"),
        # Whether the estimate is better or worse than the last day recorded.
        # An ETA on its own says nothing about whether it is being caught up.
        "eta_trend": d.get("eta_trend"),
        # The pause state as a single flag, which is all the title bar button
        # needs to choose its label. The full pause record, with the deadline and
        # the reason, stays in the API payload where a consumer can act on it.
        "paused": (d.get("pause") or {}).get("paused", False),
        # The pause in words: who set it, why, and until when. A bare "Paused"
        # raised the question this answers.
        "pause": d.get("pause"),
        "pause_label": d.get("pause_label"),
        "milestones": d.get("milestones"),
        "progress_history": d.get("progress_history"),
        "compress_saved": human(d["compress_saved"]) if d.get("compress_saved") else None,
        "skipped": d.get("skipped"),
        # The skipped files themselves, not just the counts. The Skipped Files
        # page needs the names to be useful at all, and it reads them from the
        # cached snapshot rather than calling gather() itself, so the raw list
        # has to travel in the snapshot the collector thread already builds.
        "skipped_list": d.get("skipped_list"),
        "first_backup": ({"days": round(d["first_backup"]["days"]),
                           "pct": round(d["first_backup"]["pct"], 1)}
                          if d.get("first_backup") else None),
        "last_backup_days": (round(d["last_backup_days"], 1)
                             if d.get("last_backup_days") is not None else None),
        "chunkmap": d.get("chunkmap"),
        "latency_ms": (round(lat_ms, 1) if lat_ms is not None else None),
        "latency_host": lat_host,
        "latency_note": lat_note,
        "upload_pod": _upload_host(),
        "about": ABOUT,
    }



# The palettes, once, spliced into every page at import time so a theme chosen
# in the Monitor applies to the Status, Tools and API pages as well, and any
