+/* discard the contents of the pages of a free block which overlap the given range, so
+ * that the memory of large free blocks in the middle of a subheap is given back to the system */
+static void heap_reset_free_pages( struct heap *heap, const SUBHEAP *subheap, struct block *block,
+                                   const struct block *next, const char *range, const char *range_end )
+{
+    const SIZE_T page_mask = 0xfff;
+    char *start = (char *)((struct entry *)block + 1), *end = (char *)block + block_get_size( block );
+    const char *commit_end = subheap_commit_end( subheap );
+    void *addr;
+    SIZE_T size;
+
+    if (heap->flags & HEAP_FREE_CHECKING_ENABLED) return;
+
+    /* the next block back pointer is stored at the end of the free block */
+    if (next) end -= sizeof(struct block *);
+    if (end > commit_end) end = (char *)commit_end;
+
+    start = (char *)ROUND_SIZE( (UINT_PTR)start, page_mask );
+    end = ROUND_ADDR( end, page_mask );
+
+    /* only reset pages overlapping the range, the others were reset already */
+    range = (char *)ROUND_ADDR( range, page_mask ) - (page_mask + 1);
+    range_end = (char *)ROUND_SIZE( (UINT_PTR)range_end, page_mask ) + page_mask + 1;
+    if (start < range) start = (char *)range;
+    if (end > range_end) end = (char *)range_end;
+    if (start >= end) return;
+
+    addr = start;
+    size = end - start;
+    NtAllocateVirtualMemory( NtCurrentProcess(), &addr, 0, &size, MEM_RESET, PAGE_READWRITE );
+}
