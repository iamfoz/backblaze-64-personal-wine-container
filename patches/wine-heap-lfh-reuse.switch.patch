         if (!status && heap->bins)
         {
-            SIZE_T bin = BLOCK_SIZE_BIN( block_size );
+            SIZE_T bin = BLOCK_SIZE_BIN( lfh_reuse ? block_size : block_get_size( (struct block *)ptr - 1 ) );
             InterlockedIncrement( &heap->bins[bin].count_alloc );
             if (!ReadNoFence( &heap->bins[bin].enabled )) bin_try_enable( heap, &heap->bins[bin] );
         }
