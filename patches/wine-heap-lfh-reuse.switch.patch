ntdll: Put LFH group reuse behind WINE_HEAP_LFH_REUSE.

Fork-only companion to wine-heap-lfh-reuse.patch. With WINE_HEAP_LFH_REUSE=1
the heap reuses partially freed groups, uses the smaller LFH size classes and
releases large free blocks as that patch describes. Without it the LFH uses
upstream's lock-free groups and per-thread affinity groups, every block takes
at least 48 bytes and free blocks keep their pages, as in upstream Wine. The
HeapSize correction for LFH blocks shrunk in place is not switched. The
variable is read once, from the Unix environment through a new ntdll unix call,
when the process heap is created: processes the client's service starts get a
Windows environment without the container's variables.

--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -252,6 +252,22 @@ C_ASSERT( BIN_SIZE_STEP_7 + 3 * BLOCK_ALIGN <= FIELD_MAX( struct block, tail_siz
 /* number of fully freed groups each bin keeps for reuse before releasing them */
 #define BIN_MAX_EMPTY_GROUPS 2
 
+/* WINE_HEAP_LFH_REUSE=1 turns on partially freed LFH group reuse, the smaller LFH size
+ * classes and the release of large free blocks. Without it the heap behaves as in
+ * upstream Wine. Decided once, when the process heap is created, from the Unix
+ * environment: a process can be started with a Windows environment that lacks it. */
+static BOOL lfh_reuse;
+
+static BOOL heap_lfh_reuse_wanted(void)
+{
+    BOOL enabled = FALSE;
+    WINE_UNIX_CALL( unix_heap_lfh_reuse, &enabled );
+    return enabled;
+}
+
+static BYTE affinity_mapping[] = {20,6,31,15,14,29,27,4,18,24,26,13,0,9,2,30,17,7,23,25,10,19,12,3,22,21,5,16,1,28,11,8};
+static LONG next_thread_affinity;
+
 /* a bin, tracking heap blocks of a certain size */
 struct bin
 {
@@ -273,8 +289,23 @@ struct bin
      * reused instead of being kept until all their blocks are freed.
      */
     struct list groups;
+
+    /* without lfh_reuse: lock-free list of groups with free blocks */
+    SLIST_HEADER stock_groups;
+
+    /* without lfh_reuse: array of affinity reserved groups, interleaved with other bins
+     * to keep all pointers of the same affinity and different bin grouped together,
+     * and pointers of the same bin and different affinity away from each other,
+     * hopefully in separate cache lines.
+     */
+    struct group **affinity_group_base;
 };
 
+static inline struct group **bin_get_affinity_group( struct bin *bin, BYTE affinity )
+{
+    return bin->affinity_group_base + affinity * BLOCK_SIZE_BIN_COUNT;
+}
+
