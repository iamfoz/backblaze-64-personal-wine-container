server: Put the LocalSystem group behind WINE_SERVICE_TOKEN.

Fork-only companion to wine-token-localsystem.patch. The group is added to
the default token only with WINE_SERVICE_TOKEN=1. It is the last entry in
the array, so leaving it out is a count one shorter and the primary group
index is unchanged. With the variable unset the token is as in upstream Wine.

--- a/server/token.c
+++ b/server/token.c
@@ -733,6 +733,20 @@ struct token *get_token_obj( struct process *process, obj_handle_t handle, unsig
     return (struct token *)get_handle_obj( process, handle, access, &token_ops );
 }
 
+/* WINE_SERVICE_TOKEN=1 adds the LocalSystem group to the default token.
+ * Without it the token has the groups it has in upstream Wine. */
+static int localsystem_group_enabled( void )
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *str = getenv( "WINE_SERVICE_TOKEN" );
+        enabled = str && str[0] == '1' && !str[1];
+    }
+    return enabled;
+}
+
 struct token *token_create_admin( unsigned primary, int impersonation_level, int elevation, unsigned int session_id )
 {
     struct token *token = NULL;
@@ -789,7 +803,9 @@ struct token *token_create_admin( unsigned primary, int impersonation_level, int
         { &local_system_sid, SE_GROUP_ENABLED|SE_GROUP_ENABLED_BY_DEFAULT|SE_GROUP_MANDATORY },
     };
 
-    token = create_token( primary, session_id, user_sid, admin_groups, ARRAY_SIZE( admin_groups ),
+    /* the LocalSystem group is last, so leaving it out is a shorter count */
+    token = create_token( primary, session_id, user_sid, admin_groups,
+                          ARRAY_SIZE( admin_groups ) - (localsystem_group_enabled() ? 0 : 1),
                           admin_privs, ARRAY_SIZE( admin_privs ), default_dacl,
                           NULL, 4 /* domain_users */, impersonation_level, elevation );
     /* we really need a primary group */
