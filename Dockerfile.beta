# ============================================================================
# Beta image. Ubuntu 26.04 with Wine built from source and the upload-speed
# patch applied. Published as the :beta tag.
#
# Stock Wine caps a single upload stream at roughly 140 KB/s for senders like
# libcurl, which Backblaze's bztransmit uses. Wine reports a socket as
# not writable while its send buffer still has room, so the sending loop waits
# out a full timeout instead of sending. patches/wine-writability-fix.patch
# reports writability from the kernel's send-accept condition, at both the
# poll answer and the blocking-send gate, matching Windows semantics (verified
# against Windows Server 2022 and 2025).
#
# The fix is filed as WineHQ bug 59893 and submitted upstream (MR !11272).
# Once it ships in a Wine release this file can go and the stable images will
# carry the fix.
#
# This image is not the supported path. It carries a Wine build that has not
# been through WineHQ review, and it tracks the newer LTS. Use the stable tags
# unless upload speed is the reason you are here.
#
# Wine is licensed under the LGPL. This image contains a modified Wine built
# from the public source at gitlab.winehq.org, with the patch in patches/ in
# this repository applied. Both are available at those locations.
#
# WINE_REF pins the Wine source. git apply fails loudly if the source has
# moved, which is the signal to re-verify rather than ship a mispatched Wine.
# The patch is the same artifact submitted upstream, applied verbatim.
#
# wine-11.19, skipping 11.18. 11.18's process-startup rework placed the first
# thread data at a randomised high address that could take 0x140000000, where
# bztransmit.exe (no relocations) must load, and the chunk child died with
# "failed to create main module, status c0000018" (19 Sep 2026). 11.19 carries
# 76159fce "Make sure that the first thread data is outside of the exe range".
# 11.17 had a regression (bug 60298, fixed in 11.18) that hung processes
# opening non-filesystem names. Before trusting 11.19 for stable, confirm a long
# pass shows no "failed to create main module" in docker logs.
# ============================================================================
ARG WINE_REF=wine-11.19

# Pinned by digest, as the runtime base is, so a rebuild uses the same image.
# Bump the digest with the tag. CI fetches it through mirror.gcr.io (see the
# buildx setup in the workflow), not straight from Docker Hub.
FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7 AS wine-builder
ARG WINE_REF
ARG MAKE_JOBS
ENV DEBIAN_FRONTEND=noninteractive

# patches/build-wine.sh is the one recipe for the fork's Wine, shared with the
# :latest-patched stage in Dockerfile.ubuntu24 so the two cannot drift. The
# toolchain layer comes first and keys only on the script, so a patch change
# does not reinstall it.
#
# The series (patches/series) fixes the order; each patch has its own
# --check, so a context mismatch fails the build with the patch named. A
# patch the source already has is skipped with its switch, so a fix accepted
# upstream drops out when WINE_REF moves past it. The patches are authored
# against Wine master while WINE_REF pins a release, so a --check failure
# after a WINE_REF bump usually means the context moved and the patch needs
# regenerating, not that the fix is wrong. Each fork patch has a runtime
# switch (patches/*.switch.patch); unset, Wine behaves as upstream. The
# runtime stage below sets the beta's defaults.
COPY patches/build-wine.sh /wine/patches/build-wine.sh
RUN sh /wine/patches/build-wine.sh deps
COPY patches/ /wine/patches/
RUN sh /wine/patches/build-wine.sh build

# ============================================================================
# Stage 2 - the runtime image: jlesage GUI base running Backblaze under our Wine.
# ============================================================================
FROM jlesage/baseimage-gui:ubuntu-26.04-v4.14.0@sha256:ba4b93918b17f74c21ab2a0ae7c44c0821efef4f7fd17455b754cf812add84af

ENV WINEPREFIX=/config/wine/
# Backblaze 10.x is a native 64-bit app, so the prefix must be win64.
ENV WINEARCH=win64
ENV LANG=en_US.UTF-8
ENV APP_NAME="Backblaze 64-Bit Personal Backup (beta)"
ENV FORCE_LATEST_UPDATE="true"
# No pin: this image carries the Wine fixes 10.0.3.1075 needs, so it follows
# Backblaze's newest client the way it always did. The stable images pin
# 10.0.1.1069 because they run an unpatched Wine. Set a version to pin one.
# It is installed over a newer or older client in place, so the machine
# identity in bzinstall.xml survives and no inherit is needed.
ENV BACKBLAZE_VERSION=""
# The Wine patch switches (see rootfs/usr/local/share/bb64/wine-switches.tsv).
# Unset, the patched Wine behaves as upstream Wine, so these are what keep
# the beta's fixes and performance patches on. The Settings tab overrides them.
# The experimental one, datasets as folders, is off and set per drive.
ENV WINE_SOCK_SEND_READY="1" \
    WINE_SOCK_FDWRITE_REARM="1" \
    WINE_SERVICE_TOKEN="1" \
    WINE_OFD_LOCKS="1" \
    WINE_CASE_CACHE="1"
ENV DISABLE_AUTOUPDATE="false"
ENV DISABLE_VIRTUAL_DESKTOP="false"
ENV DISPLAY_WIDTH="900"
ENV DISPLAY_HEIGHT="700"
# Disable Wine debug noise
ENV WINEDEBUG=-all
# Set DISPLAY so GUI programs can find the X server
ENV DISPLAY=:0
# Our Wine is installed under /opt/wine. startapp.sh calls wine/wineserver/etc.
# from PATH, so it must come first.
ENV PATH="/opt/wine/bin:${PATH}"

# Unraid reads these labels to show a WebUI button and the app icon on the
# Docker page, including for containers started with `docker run`.
LABEL net.unraid.docker.webui="http://[IP]:[PORT:5800]/" \
      net.unraid.docker.icon="https://cdn.jsdelivr.net/gh/selfhst/icons/png/backblaze.png"

# Our patched Wine, built in stage 1.
COPY --from=wine-builder /opt/wine /opt/wine

# Expose the Wine binaries on the default PATH. The jlesage base launches the app
# service with its own PATH that does NOT pick up the ENV PATH above, so the bare
# `wine`/`wineserver`/`wineboot`/... calls in startapp.sh must be resolvable
# directly. Link the binaries Wine and the startup script invoke by name into
# /usr/bin - where winehq-stable used to install them, and which is on the app
# service's PATH. Wine still finds its libraries relative to /opt/wine via
# the symlink target.
RUN set -eu; for b in wine wine64 wineserver wineboot winepath winecfg wineconsole; do \
        if [ -e "/opt/wine/bin/$b" ]; then ln -sf "/opt/wine/bin/$b" "/usr/bin/$b"; fi; \
    done

# Runtime dependencies. Because we build a pure win64 Wine from source we no
# longer need the WineHQ apt repo, the i386/WoW64 libraries, winetricks, or the
# systemd-pinning gymnastics that winehq-stable's dependency chain (libsane ->
# libgphoto2 -> udev -> systemd) used to force. We install only:
#   * the tools startapp.sh uses (curl, 7z, cabextract, xvfb),
#   * the shared libraries our Wine links against (fonts, TLS, the X stack),
#   * locales for the en_US.UTF-8 the prefix expects.
# The init_env scaffolding (and its later cleanup) mirrors the base image's
# add-pkg helper, so font/ca-certificate postinst scripts succeed on this
# otherwise minimal base.
RUN mkdir -p /config/log /tmp/run && \
    /etc/cont-init.d/10-init-users.sh && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl xvfb cabextract p7zip-full python3 \
        libfreetype6 libfontconfig1 libgnutls30t64 libpng16-16t64 \
        libx11-6 libxext6 libxrender1 libxrandr2 libxi6 libxfixes3 \
        libxcursor1 libxinerama1 libxcomposite1 libxxf86vm1 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends locales && \
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* \
        /tmp/.passwd /tmp/.group /tmp/.shadow /tmp/.gshadow /tmp/run /config/log

# Image/release version, shown by bb-version and baked into the build stamp below.
# CI passes the release tag via --build-arg. Local builds default to "dev".
# Declared HERE, after the heavy apt layer, so a version change does not bust its
# build cache. Without this ARG, Docker ignores the build-arg CI passes
# and every published image would stamp itself "dev".
ARG DOCKER_IMAGE_VERSION=dev
ENV DOCKER_IMAGE_VERSION=${DOCKER_IMAGE_VERSION}

# Stamp the build so every bb-* tool can report which image it came from.
# Sourced from the build rather than versioned per tool: the tools always ship
# together inside an image, so "which build is this" is the question a bug report
# needs answered, and a single source cannot drift out of step.
ARG BUILD_REV=unknown
# BUILD_NUMBER is the CI run number. The :beta tag is mutable, so without it a
# published beta cannot be told apart from the one before it in a bug report.
ARG BUILD_NUMBER=0
RUN printf 'version=%s\nrevision=%s\nbuild=%s\nvariant=%s\nbuilt=%s\n' \
        "${DOCKER_IMAGE_VERSION:-dev}" "${BUILD_REV}" "${BUILD_NUMBER}" "beta-ubuntu26" \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /etc/bb-build

EXPOSE 5900

COPY rootfs/ /

# The tools, the web interface and its nginx wiring, and the checks that what
# ships parses: the same step for every image (build/finish-image.sh).
RUN --mount=type=bind,source=build,target=/build sh /build/finish-image.sh

# Report the backup itself as the container's health, rather than just whether a
# process is alive. bb-health only reports unhealthy on a corroborated stall (see
# the script), so an idle or still-being-set-up container stays healthy. The long
# start period covers the first run, which downloads and installs Backblaze.
HEALTHCHECK --interval=5m --timeout=30s --start-period=15m --retries=2 \
    CMD /usr/local/bin/bb-health || exit 1
